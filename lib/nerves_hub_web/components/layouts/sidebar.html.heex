<div class="flex h-full">
  <.live_component module={NervesHubWeb.Components.CommandPalette} id="command-palette" current_scope={@current_scope} />
  <%!-- On a phone the sidebar is a drawer over a scrim, which the top bar's
        menu button opens by setting data-open. --%>
  <div
    id="sidebar"
    class="peer flex h-full w-sidebar shrink-0 flex-col border-r border-line-default bg-surface-muted transition-[width] duration-200 max-sm:fixed max-sm:inset-y-0 max-sm:left-0 max-sm:z-50 max-sm:hidden max-sm:max-w-[85vw] max-sm:shadow-overlay max-sm:data-open:flex collapsed:w-16"
    phx-window-keydown={hide_sidebar()}
    phx-key="escape"
  >
    <div class="flex h-14 shrink-0 items-center justify-between border-b border-line-default pr-3 pl-6 collapsed:justify-center collapsed:px-0">
      <.link navigate={~p"/orgs"} class="collapsed:hidden">
        <.logo class="h-6" />
      </.link>
      <button
        id="sidebar-toggle"
        type="button"
        phx-hook="SidebarToggle"
        aria-label="Collapse or expand the sidebar"
        class="flex size-7 shrink-0 items-center justify-center rounded text-content-muted hover:cursor-pointer hover:text-content-strong max-sm:hidden"
      >
        <span class="lucide-panel-left-close size-5 text-content-muted collapsed:hidden"></span>
        <span class="lucide-panel-left-open hidden size-5 text-content-muted collapsed:block"></span>
      </button>
      <button
        type="button"
        aria-label="Close menu"
        phx-click={hide_sidebar()}
        class="flex size-11 shrink-0 cursor-pointer items-center justify-center text-content-muted sm:hidden"
      >
        <span class="lucide-x size-5" aria-hidden="true"></span>
      </button>
    </div>

    <div class="relative flex flex-col border-line-default">
      <div
        :if={@current_scope.org}
        class="product-selector relative flex h-header shrink-0 cursor-pointer items-center border-b border-line-default py-4 pr-3 pl-6 collapsed:justify-center collapsed:px-0"
        phx-click={toggle_product_picker()}
      >
        <div class="org-avatar hidden collapsed:flex">
          <div class="flex-1">{@current_scope.org.name |> String.split(" ") |> Enum.map(&String.first/1) |> Enum.join()}</div>
        </div>
        <div class="collapsed:hidden">
          <div class="org-selector-title">{@current_scope.org.name}</div>
          <div :if={@current_scope.product} class="product-selector-title flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M1 1V5C1 7.20914 2.79086 9 5 9H9" class="stroke-base-500" stroke-width="1" stroke-linecap="round" />
            </svg>
            <span>{@current_scope.product.name}</span>
          </div>
        </div>
        <div class="product-selector-icon ml-auto rounded p-1.5 collapsed:hidden">
          <span class="lucide-chevron-right size-4 text-content-muted" aria-hidden="true"></span>
        </div>
      </div>
      <div
        :if={@current_scope.org}
        id="product-picker"
        class="absolute top-0 left-(--sidebar-width) hidden w-sidebar max-sm:left-0 max-sm:w-full collapsed:left-16"
      >
        <div class="fixed top-0 left-(--sidebar-width) z-30 size-full bg-backdrop max-sm:left-0 collapsed:left-16"></div>
        <div class="relative">
          <div
            class="relative z-50 scrollbar-thin max-h-[612px] overflow-y-scroll overscroll-none border-r border-b border-line-default bg-surface-overlay p-3 scrollbar-thumb-base-800 scrollbar-track-base-900"
            phx-window-keydown={hide_product_picker()}
            phx-key="escape"
            phx-click-away={toggle_product_picker()}
          >
            <div :for={org <- @current_scope.user.orgs} class="flex flex-col gap-2 p-4">
              <.link navigate={~p"/org/#{org.name}"} class="group flex items-center gap-3">
                <div class="org-avatar">
                  {org.name |> String.split(" ") |> Enum.map(&String.first/1) |> Enum.join()}
                </div>
                <h3 class="underline-base text-card-title text-content-strong underline-color-indigo-500 group-hover:underline-expanded">{org.name}</h3>
              </.link>
              <div class="flex flex-col gap-1.5">
                <div :for={product <- org.products}>
                  <.link navigate={~p"/org/#{org}/#{product}/insights"} class="product-picker-product">
                    {product.name}
                  </.link>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -inset-0.5 z-40 translate-1 rounded-md bg-linear-to-br from-alert via-success to-primary blur-sm"></div>
        </div>
      </div>
    </div>

    <div>
      <nav id="navigation" class="flex grow flex-col">
        <Navigation.sidebar scope={@current_scope} selected_tab={@sidebar_tab} />
      </nav>
    </div>

    <div class="sticky bottom-0 col-start-1 col-end-2 mt-auto border-t border-line-subtle">
      <div id="user-menu-container" class="hidden" phx-click-away={hide_user_menu()} phx-window-keydown={hide_user_menu()} phx-key="escape">
        <div
          id="user-menu"
          class="mx-3.5 mb-4 flex flex-col rounded-md border border-line-default bg-surface-overlay p-2 shadow-overlay collapsed:absolute collapsed:bottom-14 collapsed:left-2 collapsed:mx-0 collapsed:w-56"
        >
          <div class="justify-left flex items-center gap-1.5 rounded p-2 hover:bg-primary/20">
            <span class="lucide-user-round size-5 text-content-body" />
            <.link navigate={~p"/account"} class="text-sm font-light tracking-wide">Account</.link>
          </div>

          <div class="justify-left flex items-center gap-1.5 rounded p-2 hover:bg-primary/20">
            <span class="lucide-log-out size-5 text-alert" />
            <.link navigate={~p"/logout"} class="text-sm font-light tracking-wide text-alert">Log out</.link>
          </div>

          <div aria-hidden="true" class="col-span-full -mx-1.5 my-1.5 h-px border-t border-line-default"></div>

          <div class="justify-left flex items-center gap-1.5 rounded p-2 hover:bg-primary/20">
            <span class="lucide-book-open-text size-5 text-content-body" />
            <a href="https://docs.nerves-hub.org" class="text-sm font-light tracking-wide">Documentation</a>
          </div>

          <div aria-hidden="true" class="col-span-full -mx-1.5 my-1.5 h-px border-t border-line-default"></div>

          <div id="theme-selector" phx-update="ignore" class="ring-border relative isolate mt-2.5 mb-2 ml-2 flex h-8 w-fit gap-1.5 rounded-full p-1 ring-1 ring-line-default">
            <button
              id="theme-light"
              aria-label="Light theme"
              phx-hook="ThemeSwitcher"
              data-theme-option="light"
              class="group theme-selectors relative flex size-6 items-center justify-center rounded-full hover:border-primary data-[selected=true]:border-primary"
              type="button"
            >
              <div class="absolute inset-0 hidden rounded-full bg-primary/10 group-data-[selected=true]:flex"></div>
              <span class="lucide-sun size-5 text-base-600 group-hover:cursor-pointer group-hover:text-primary group-data-[selected=true]:text-primary" />
            </button>
            <button
              id="theme-dark"
              aria-label="Dark theme"
              phx-hook="ThemeSwitcher"
              data-theme-option="dark"
              class="group theme-selectors relative flex size-6 items-center justify-center rounded-full hover:border-primary data-[selected=true]:border-primary"
              type="button"
            >
              <div class="absolute inset-0 hidden rounded-full bg-primary/10 group-data-[selected=true]:flex"></div>
              <span class="lucide-moon size-5 text-base-600 group-hover:cursor-pointer group-hover:text-primary group-data-[selected=true]:text-primary" />
            </button>
            <button
              id="theme-system"
              aria-label="System theme"
              phx-hook="ThemeSwitcher"
              data-theme-option="system"
              class="group theme-selectors relative flex size-6 items-center justify-center rounded-full hover:border-primary data-[selected=true]:border-primary"
              type="button"
            >
              <div class="absolute inset-0 hidden rounded-full bg-primary/10 group-data-[selected=true]:flex"></div>
              <span class="lucide-monitor size-4.5 text-base-600 group-hover:cursor-pointer group-hover:text-primary group-data-[selected=true]:text-primary" />
            </button>
          </div>
        </div>
      </div>

      <a
        id="user-menu-toggle"
        href="#"
        class="flex h-16 items-center gap-x-2.5 px-3 py-2.5 text-sm/6 font-semibold text-content-strong hover:bg-primary/10 collapsed:mx-0 collapsed:justify-center"
        phx-click={toggle_user_menu()}
      >
        <.user_avatar user={@current_scope.user} />

        <div class="collapsed:hidden">
          <div class="sr-only">Your profile</div>
          <div aria-hidden="true" class="truncate text-sm font-light text-content-strong">{@current_scope.user.name}</div>
          <div aria-hidden="true" class="truncate text-xs font-light text-content-muted">{@current_scope.user.email}</div>
        </div>

        <span class="ml-auto lucide-chevrons-up-down size-4 collapsed:hidden"></span>
      </a>
    </div>
  </div>

  <div class="fixed inset-0 z-40 hidden bg-backdrop max-sm:peer-data-open:block" aria-hidden="true" phx-click={hide_sidebar()}></div>

  <div class="flex size-full min-w-0 flex-col">
    <.flash_group flash={@flash} />

    <div class="flex h-12 shrink-0 items-center justify-between border-b border-line-default bg-surface-muted pl-4 sm:h-topbar sm:pl-6">
      <div class="flex h-full min-w-0 flex-1 items-center justify-between">
        {if(assigns[:top_bar], do: render_slot(@top_bar))}
      </div>
      <button
        type="button"
        aria-label="Open menu"
        aria-controls="sidebar"
        phx-click={show_sidebar()}
        class="flex size-11 shrink-0 cursor-pointer items-center justify-center text-content-muted sm:hidden"
      >
        <span class="lucide-menu size-5" aria-hidden="true"></span>
      </button>
    </div>

    <%!-- The tab bar draws the line under the header when there is one, the
          way `big_header` leaves it to. Two borders read as a double rule. --%>
    <div
      :if={assigns[:header]}
      id="header"
      class={[
        "flex h-header items-center gap-4 border-line-default px-6 text-sm font-medium",
        !assigns[:tabbed_nav] && "border-b"
      ]}
    >
      {render_slot(@header)}
    </div>

    <div :if={assigns[:big_header]} id="header" class="relative flex h-header shrink-0 justify-between p-6">
      {render_slot(@big_header)}
    </div>

    <div :if={assigns[:tabbed_nav]} class="-mt-px flex w-full justify-between border-b border-line-default px-6">
      <div class="flex">
        <.link
          :for={nav <- @tabbed_nav}
          data-selected={nav.selected}
          class="relative -bottom-px h-11 px-6 py-2 text-sm font-normal text-content-muted hover:border-b hover:border-base-500 hover:text-content-body data-selected:border-b data-selected:border-primary data-selected:tab-selected data-selected:text-content-strong"
          {tab_target(nav)}
        >
          {nav.label}
        </.link>
      </div>

      <div :if={assigns[:tabbed_nav_end]} class="flex">
        <.link
          :for={nav <- @tabbed_nav_end}
          data-selected={to_string(nav.selected)}
          title={nav.label}
          class="group relative -bottom-px flex h-11 items-center px-6 py-2 text-sm font-normal text-content-muted hover:border-b hover:border-base-500 hover:text-content-body data-[selected=true]:border-b data-[selected=true]:border-primary data-[selected=true]:tab-selected data-[selected=true]:text-content-strong"
          patch={nav.path}
        >
          <span class="lucide-bug size-4"></span>
          <%!-- Collapsed to zero width rather than hidden, so revealing the label
                slides it out instead of snapping the tab to a new width. --%>
          <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-all duration-200 ease-out group-hover:ml-2 group-hover:max-w-40 group-hover:opacity-100 group-data-[selected=true]:ml-2 group-data-[selected=true]:max-w-40 group-data-[selected=true]:opacity-100">
            {nav.label}
          </span>
        </.link>
      </div>
    </div>

    {render_slot(@inner_block)}

    <Pager.render_with_page_sizes :for={pagination <- assigns[:pagination] || []} :if={assigns[:pagination]} pager={pagination.pager} page_sizes={pagination.page_sizes} />
  </div>
</div>
