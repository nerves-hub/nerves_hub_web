<div class="flex h-full flex-col">
  <.live_component module={NervesHubWeb.Components.CommandPalette} id="command-palette" current_scope={@current_scope} />
  <header class="flex h-topbar shrink-0 items-center justify-between border-b border-line-default bg-surface-muted px-4 sm:px-6">
    <.link navigate={~p"/orgs"} aria-label={"#{NervesHub.Branding.friendly_platform_name()} home"}>
      <.logo class="h-6" />
    </.link>

    <div class="relative" phx-click-away={hide_user_menu()} phx-window-keydown={hide_user_menu()} phx-key="escape">
      <button
        id="user-menu-toggle"
        type="button"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="user-menu-container"
        class="group flex items-center gap-1.5 rounded-full p-1 pr-2 text-content-muted hover:bg-primary/10 hover:text-content-strong"
        phx-click={toggle_user_menu()}
      >
        <span class="sr-only">Your profile</span>
        <.user_avatar user={@current_scope.user} />
        <span class="lucide-chevron-down size-4 group-aria-expanded:rotate-180" aria-hidden="true"></span>
      </button>

      <div id="user-menu-container" class="absolute top-full right-0 z-40 mt-2 hidden w-66">
        <div id="user-menu" class="flex flex-col rounded-md border border-line-default bg-surface-overlay p-1 shadow-overlay">
          <.user_menu_items user={@current_scope.user} theme_id="theme" />
        </div>
      </div>
    </div>
  </header>

  <div class="flex size-full flex-col items-center">
    <.flash_group flash={@flash} />

    {render_slot(@inner_block)}
  </div>
</div>
