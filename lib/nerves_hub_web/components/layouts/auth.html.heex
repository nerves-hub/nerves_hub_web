<div class="relative isolate flex min-h-full flex-col items-center overflow-hidden bg-surface px-4 py-12 sm:py-16">
  <%!-- A circuit board behind the form, with a wave of power crossing it now and then (the pcb-* styles in app.css). Decoration only, so it sits behind everything. --%>
  <div class="pcb-backdrop pointer-events-none absolute inset-0 -z-10 text-primary light:text-indigo-600" aria-hidden="true">
    <div class="pcb-traces"></div>
    <div class="pcb-power">
      <div class="pcb-power-sweep"></div>
    </div>
  </div>

  <main class="flex w-full max-w-100 flex-1 flex-col items-center justify-center">
    <div class="relative flex w-full flex-col items-center gap-7">
      <%!-- Scrim: pools the page colour behind the form, so the title and footer stay readable while the board shows around them. --%>
      <div class="pcb-scrim pointer-events-none absolute -inset-x-40 -inset-y-28 -z-10" aria-hidden="true"></div>
      <div class="flex flex-col items-center gap-6 text-center">
        <.link href="/login">
          <.logo class="h-6" />
        </.link>
        <div class="flex flex-col gap-1.5">
          <h1 class="text-2xl/7.5 font-semibold tracking-tight text-content-strong">
            {render_slot(@title)}
          </h1>
          <p :if={assigns[:subheader] not in [nil, []]} class="text-sm text-content-muted">
            {render_slot(@subheader)}
          </p>
        </div>
      </div>

      <div class="w-full rounded-xl border border-line-subtle bg-surface-raised p-6 shadow-card sm:p-8">
        {render_slot(@inner_block)}
      </div>

      <div :if={assigns[:footer] not in [nil, []]} class="text-center text-sm text-content-muted">
        {render_slot(@footer)}
      </div>
    </div>
  </main>
</div>

<.flash_group flash={@flash} />
