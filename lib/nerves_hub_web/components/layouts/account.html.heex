<.no_sidebar flash={@flash} current_scope={@current_scope}>
  <div class="flex w-full flex-col items-center border-b border-line-default bg-surface-raised">
    <div class="flex w-full max-w-248 flex-col gap-4 px-4 pt-6 md:gap-7 md:pt-10">
      <div class="flex items-center gap-4">
        <.user_avatar user={@current_scope.user} size="size-12 md:size-14" class="shrink-0 text-lg md:text-xl" />
        <div class="flex min-w-0 flex-1 flex-col gap-0.75">
          <h1 class="truncate text-page-title text-content-strong">{@current_scope.user.name}</h1>
          <p id="account-summary" class="truncate text-ui/4.5 text-content-muted"><Fleet.separated items={account_summary(@current_scope.user)} /></p>
        </div>
      </div>

      <%!-- Scrolls sideways on a phone, like the organization tabs. --%>
      <nav
        id="account-tabs"
        phx-hook="ActiveTabInView"
        aria-label="Account sections"
        class="-mx-4 scrollbar-none flex gap-1 overflow-x-auto mask-r-from-[calc(100%-2.5rem)] px-1 data-scrolled-to-end:mask-none md:mx-0 md:-ml-3 md:mask-none md:px-0"
      >
        <.link
          :for={tab <- account_tabs()}
          navigate={tab.path}
          aria-current={if tab.key == @tab, do: "page"}
          class="group relative flex h-11 shrink-0 items-center gap-1.75 border-b-2 border-transparent px-3 text-sm/4.5 font-medium whitespace-nowrap text-content-muted hover:text-content-strong aria-[current=page]:border-primary aria-[current=page]:font-semibold aria-[current=page]:text-content-strong light:aria-[current=page]:border-indigo-600"
        >
          <span class={[tab.icon, "size-3.75 group-aria-[current=page]:hidden"]} aria-hidden="true"></span>
          <span class={[tab.selected_icon, "hidden size-3.75 group-aria-[current=page]:block"]} aria-hidden="true"></span>
          <span class="reserve-semibold-width flex flex-col" data-label={tab.label}>{tab.label}</span>
        </.link>
      </nav>
    </div>
  </div>

  <main class="flex w-full max-w-248 flex-col gap-8 px-4 pt-6 pb-16 md:pt-8">
    {render_slot(@inner_block)}
  </main>
</.no_sidebar>
