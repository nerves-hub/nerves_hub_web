<Layouts.auth flash={@flash}>
  <:title>
    Join {@org.name} on {platform_name()}
  </:title>
  <:subheader :if={@mode != :wrong_account}>
    {@invite.invited_by.name} invited you as <span class="font-semibold text-content-strong">{NervesHubWeb.Components.Utils.role_name(@invite)}</span>.
    The invitation expires 48 hours after it was sent.
  </:subheader>

  <%= case @mode do %>
    <% :accept -> %>
      <div class="flex flex-col gap-5">
        <p class="text-sm text-content-body">
          Joining lets the admins of {@org.name} manage your membership.
        </p>

        <.form for={%{}} action={~p"/invite/#{@token}/accept"} method="post">
          <.button style="primary" type="submit" id="accept-invite" class="w-full">
            Join {@org.name}
          </.button>
        </.form>

        <.form for={%{}} action={~p"/invite/#{@token}/decline"} method="post">
          <.button
            type="submit"
            id="decline-invite"
            class="w-full"
            data-confirm={"Are you sure you want to decline the invitation to join #{@org.name}?"}
          >
            Decline
          </.button>
        </.form>
      </div>
    <% :wrong_account -> %>
      <div class="flex flex-col gap-5">
        <div role="alert" class="flex gap-2.5 rounded-md border border-alert/30 bg-alert-soft p-3 text-sm text-alert-content">
          <span class="mt-0.5 lucide-circle-exclamation-point size-4 flex-none" aria-hidden="true"></span>
          <p>
            This invitation was sent to a different email address. You're signed in as {@current_scope.user.email}.
          </p>
        </div>

        <p class="text-sm text-content-body">
          Sign out, then sign back in with the invited account to accept it.
        </p>

        <.button type="link" href={~p"/logout"} class="w-full">
          Sign out
        </.button>
      </div>
    <% :sign_in -> %>
      <div class="flex flex-col gap-5">
        <p class="text-sm text-content-body">
          You already have a {platform_name()} account. Sign in with the invited email address to accept this invitation.
        </p>

        <.button style="primary" type="link" href={~p"/login"} id="sign-in-to-accept" class="w-full">
          Sign in to accept
        </.button>
      </div>
    <% :register -> %>
      <div class="flex flex-col gap-5">
        <OAuthLinks.render divider="or sign up with email" />

        <.form :let={f} for={@changeset} as={:user} action={~p"/invite/#{@token}"} method="post" class="flex flex-col gap-5">
          <input :if={@key} type="hidden" name="key" value={@key} />

          <.input field={f[:name]} label="Name" autocomplete="name" placeholder="Jane Doe" />
          <.input field={f[:password]} type="password" label="Password" autocomplete="new-password" hint="At least 12 characters" required />

          <.button style="primary" type="submit" class="w-full">
            Join {@org.name}
          </.button>
        </.form>
      </div>
  <% end %>

  <:footer :if={@mode in [:sign_in, :register]}>
    <.form for={%{}} action={~p"/invite/#{@token}/decline"} method="post">
      Not expecting this?
      <button
        type="submit"
        id="decline-invite"
        class="cursor-pointer font-semibold text-primary hover:text-primary-hover light:text-indigo-600 light:hover:text-indigo-500"
        data-confirm={"Are you sure you want to decline the invitation to join #{@org.name}?"}
      >
        Decline the invitation
      </button>
    </.form>
  </:footer>
</Layouts.auth>
