<Layouts.auth flash={@flash}>
  <:title>
    Create your account
  </:title>
  <:subheader>
    Start with one device. Grow into a fleet.
  </:subheader>

  <div class="flex flex-col gap-5">
    <OAuthLinks.render divider="or sign up with email" />

    <.form :let={f} for={@changeset} action={~p"/register"} class="flex flex-col gap-5">
      <.input field={f[:name]} label="Name" autocomplete="name" placeholder="Jane Doe" />
      <.input field={f[:email]} type="email" label="Email" autocomplete="email" placeholder="you@company.com" />
      <.input field={f[:password]} type="password" label="Password" autocomplete="new-password" hint="At least 12 characters" required />

      <.button style="primary" type="submit" class="w-full">
        Create account
      </.button>
    </.form>
  </div>

  <:footer>
    Already have an account? <.link href={~p"/login"} class="font-semibold text-primary hover:text-primary-hover light:text-indigo-600 light:hover:text-indigo-500">Sign in</.link>
  </:footer>
</Layouts.auth>
