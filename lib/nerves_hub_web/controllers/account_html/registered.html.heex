<Layouts.auth flash={@flash}>
  <:title>
    Please confirm your email
  </:title>
  <div class="mt-8">
    <p class="mt-2 text-sm/6 text-content-body">
      Your new account was created successfully!
    </p>

    <p class="mt-2 text-sm/6 text-content-body">
      An email was sent to has been sent to <span class="text-content-strong underline">{@email}</span> with a link to confirm your account.
    </p>
  </div>
</Layouts.auth>
