<Layouts.auth flash={@flash}>
  <:title>
    Confirm your email
  </:title>
  <:subheader>
    <span :if={@email}>We sent a link to <span class="font-semibold text-content-strong">{@email}</span>.</span>
    <span :if={!@email}>We sent a link to the address you were invited at.</span>
  </:subheader>

  <div class="flex items-start gap-3.5">
    <span class="flex size-10 flex-none items-center justify-center rounded-full bg-notice-soft text-notice-content" aria-hidden="true">
      <span class="lucide-mail size-5"></span>
    </span>
    <div class="text-sm">
      <p class="font-semibold text-content-strong">Your new account was created successfully!</p>
      <p class="text-content-muted">Open the link in that email to confirm it. Nothing after a few minutes? Check your spam folder.</p>
    </div>
  </div>

  <:footer>
    <.link href={~p"/login"} class="font-semibold text-primary hover:text-primary-hover light:text-indigo-600 light:hover:text-indigo-500">Back to sign in</.link>
  </:footer>
</Layouts.auth>
