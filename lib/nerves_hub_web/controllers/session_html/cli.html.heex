<Layouts.auth flash={@flash}>
  <:title>
    Sign in to the CLI
  </:title>
  <:subheader>
    Type in the code your terminal shows.
  </:subheader>

  <form id="cli_code" method="post" action={~p"/auth/cli"} class="flex flex-col gap-5">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

    <div :if={@error_message} role="alert" class="flex gap-2.5 rounded-md border border-alert/30 bg-alert-soft p-3 text-sm text-alert-content">
      <span class="mt-0.5 lucide-circle-exclamation-point size-4 flex-none text-alert" aria-hidden="true"></span>
      <p>{@error_message}</p>
    </div>

    <.input id="code" name="code" value="" label="Code" autocomplete="off" inputmode="numeric" autofocus required />

    <.button style="primary" type="submit" class="w-full">
      Continue
    </.button>

    <p class="text-center text-ui text-content-muted">
      Only type in a code from a sign-in you started yourself. If someone sent you a code, don't enter it.
    </p>
  </form>
</Layouts.auth>
