<Layouts.auth flash={@flash}>
  <:title>
    Sign in to the CLI
  </:title>
  <:subheader>
    Check that this code matches the one in your terminal.
  </:subheader>

  <form id="cli_session" method="post" action={~p"/auth/cli/#{@token}"} class="flex flex-col gap-5">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

    <div class="flex flex-col items-center gap-2">
      <p class="text-[0.8125rem] font-medium text-content-muted">Confirmation code</p>
      <p class="flex gap-1.5">
        <span class="sr-only">{@confirmation_code}</span>
        <span
          :for={char <- confirmation_code_list(@confirmation_code)}
          class="flex h-11 w-9 items-center justify-center rounded-md border border-line-default bg-surface font-mono text-xl font-medium text-content-strong"
          aria-hidden="true"
        >
          {char}
        </span>
      </p>
    </div>

    <.button style="primary" type="submit" class="w-full">
      Confirm sign in
    </.button>

    <p class="text-center text-[0.8125rem] text-content-muted">
      Different code, or you didn't start this? Close this window.
    </p>
  </form>
</Layouts.auth>
