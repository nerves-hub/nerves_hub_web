<Layouts.auth flash={@flash}>
  <:title>
    Sign in to {platform_name()}
  </:title>
  <:subheader>
    Welcome back. Your devices missed you.
  </:subheader>

  <div class="flex flex-col gap-5">
    <div :if={assigns[:error_message]} role="alert" class="flex gap-2.5 rounded-md border border-alert/30 bg-alert-soft p-3 text-sm text-alert-content">
      <span class="mt-0.5 lucide-circle-exclamation-point size-4 flex-none text-alert" aria-hidden="true"></span>
      <div>
        <p class="font-semibold">{@error_message}</p>
        <p>Check both and try again.</p>
      </div>
    </div>

    <OAuthLinks.render divider="or sign in with email" />

    <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/login"} class="flex flex-col gap-5">
      <.input field={f[:email]} type="email" label="Email" autocomplete="email" placeholder="you@company.com" required />

      <.input field={f[:password]} type="password" label="Password" autocomplete="current-password" required>
        <:label_action>
          <.link href={~p"/password-reset"} class="text-sm font-medium text-primary hover:text-primary-hover light:text-indigo-600 light:hover:text-indigo-500">
            Forgot password?
          </.link>
        </:label_action>
      </.input>

      <div class="flex items-center gap-2.5">
        <input
          id="remember-me"
          name={f[:remember_me].name}
          type="checkbox"
          value="true"
          checked={f[:remember_me].value == "true"}
          class="rounded border-line-strong bg-base-800 checked:bg-primary focus:ring-0 focus:ring-offset-0 focus-visible:ring-2 focus-visible:ring-focus-ring light:checked:bg-indigo-600"
        />
        <label for="remember-me" class="text-sm text-content-body">
          Keep me signed in for {NervesHubWeb.Auth.remember_me_days()} days
        </label>
      </div>

      <.button style="primary" id="login-submit" type="submit" class="relative w-full">
        <span id="login-submit-spinner" class="absolute inset-0 hidden items-center justify-center">
          <span class="lucide-loader-circle size-5 animate-spin" />
        </span>
        <span id="login-submit-text">Sign in</span>
      </.button>
    </.form>
  </div>

  <:footer :if={Application.get_env(:nerves_hub, :open_for_registrations)}>
    Don't have an account? <.link href={~p"/register"} class="font-semibold text-primary hover:text-primary-hover light:text-indigo-600 light:hover:text-indigo-500">Create one</.link>
  </:footer>
  <:footer :if={!Application.get_env(:nerves_hub, :open_for_registrations)}>
    <p>Don't have an account? Ask your platform admin for an invite.</p>
  </:footer>
</Layouts.auth>

<script>
  document.getElementById("login_form_password").addEventListener("submit", function () {
    var btn = document.getElementById("login-submit");
    btn.disabled = true;
    document.getElementById("login-submit-text").classList.add("invisible");
    document.getElementById("login-submit-spinner").classList.remove("hidden");
    document.getElementById("login-submit-spinner").classList.add("flex");
  });
</script>
