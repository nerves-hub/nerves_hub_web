<ErrorPage.page
  title="Unexpected error"
  code="500"
  label="Server error"
  tone={:alert}
  css_path={static_path("/assets/css/app.css")}
  js_path={static_path("/assets/js/app.js")}
>
  <:drawing>
    <ErrorPage.fuse ref="F500" note="OPEN" />
  </:drawing>
  <:headline>Something on our side blew a fuse.</:headline>
  That one’s on us, not you. It has been logged and the team has been told. Trying again in a minute usually works.
  <:actions>
    <%= if ErrorPage.reloadable?(assigns[:conn]) do %>
      <.button style="primary" data-reload>Try again</.button>
    <% else %>
      <ErrorPage.back_button style="primary" />
    <% end %>
    <.button :if={ErrorPage.status_page_url()} type="link" href={ErrorPage.status_page_url()}>Check status</.button>
  </:actions>
  <:note>
    <ErrorPage.request_id id={ErrorPage.request_id_of(assigns[:conn])} />
  </:note>
</ErrorPage.page>
