<ErrorPage.page
  title="Invalid request"
  code="400"
  label="Bad request"
  css_path={static_path("/assets/css/app.css")}
  js_path={static_path("/assets/js/app.js")}
>
  <:drawing>
    <ErrorPage.footprint ref="U400" note="ERR" />
  </:drawing>
  <:headline>We couldn’t read that request.</:headline>
  Something in it was malformed or incomplete. Going back and trying again usually works.
  <:actions>
    <ErrorPage.back_button style="primary" />
    <.button type="link" href="/orgs">Back to your organizations</.button>
  </:actions>
  <:note>
    <ErrorPage.request_id id={ErrorPage.request_id_of(assigns[:conn])} />
  </:note>
</ErrorPage.page>
