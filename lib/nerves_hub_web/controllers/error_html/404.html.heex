<ErrorPage.page
  title="Page not found"
  code="404"
  label="Not found"
  css_path={static_path("/assets/css/app.css")}
  js_path={static_path("/assets/js/app.js")}
>
  <:drawing>
    <ErrorPage.footprint ref="U404" note="DNP" />
  </:drawing>
  <:headline>That page doesn’t exist,<br /> or you don’t have access.</:headline>

  <%= if path = ErrorPage.path_of(assigns[:conn]) do %>
    Nothing at <code class="font-mono text-sm font-medium wrap-anywhere text-content-strong">{ErrorPage.breakable_path(path)}</code> is visible to your account.
  <% else %>
    Nothing at this address is visible to your account.
  <% end %>
  Check the link for typos, or ask an admin of the organization to invite you.
  <:actions>
    <.button style="primary" type="link" href="/orgs">Back to your organizations</.button>
    <ErrorPage.back_button />
  </:actions>
  <:note>
    Followed a link from {ErrorPage.platform_name()} itself? <ErrorPage.text_link href={ErrorPage.issues_url()} target="_blank" rel="noopener noreferrer">Report a broken link</ErrorPage.text_link>
  </:note>
</ErrorPage.page>
