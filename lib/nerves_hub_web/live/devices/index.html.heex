<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <div></div>
    <div class="mr-6 flex gap-2">
      <.button type="link" navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/new"} aria-label="Add new device">
        <.icon name="add" /> Add Device
      </.button>
      <.button :if={has_results?(@devices, @currently_filtering)} type="link" square aria-label="Export devices" href={~p"/org/#{@org}/#{@product}/devices/export?#{@params}"} download>
        <span class="lucide-download size-4" aria-hidden="true"></span>
      </.button>
    </div>
  </:top_bar>

  <:header>
    <h1 :if={!@devices.ok?} class="text-page-title text-content-strong">Loading...</h1>
    <h1 :if={@devices.ok?} id="devices-header" class="hidden text-page-title text-content-strong" phx-mounted={fade_in("#devices-header")}>
      All Devices
    </h1>

    <div class="mr-auto">
      <.badge :if={@devices.ok?} id="device-count" phx-mounted={fade_in("#device-count")} class="mr-auto hidden">
        {Number.Delimit.number_to_delimited(@total_entries, precision: 0)}
      </.badge>
    </div>

    <div class="flex justify-center gap-4">
      <AdvancedSearch.field
        :if={has_results?(@devices, @currently_filtering)}
        query={@current_filters[:advanced_query]}
        error={@advanced_query_error}
        schema_json={@advanced_query_schema_json}
      />

      <.button
        :if={has_results?(@devices, @currently_filtering) || @soft_deleted_devices_exist}
        id="sidebar-filter-button"
        type="button"
        square
        aria-label="Filter devices"
        phx-click={FilterSidebar.show_filter_sidebar()}
      >
        <.icon name="filter" />
      </.button>
      <.button type="button" square aria-label="List settings" phx-click={ListSettingsSidebar.show_settings_sidebar()}>
        <.icon name="settings" />
      </.button>
    </div>
  </:header>

  <div id="device-container" class="h-0 flex-1 overflow-auto" phx-hook="PageVisible">
    <.async_result :let={devices} assign={@devices}>
      <:loading>
        <div class="listing">
          <table class="min-w-max [&_th]:sticky [&_th]:top-0 [&_th]:z-10">
            <thead>
              <tr>
                <th class="checkbox">
                  <input class="checkbox" disabled type="checkbox" />
                </th>
                <th>Identifier</th>
                <th class="w-24">
                  <div class="flex justify-center">Health</div>
                </th>
                <th>Firmware</th>
                <th>Platform</th>
                <th>Uptime</th>
                <th>Deployment Group</th>
                <th>Tags</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={_ <- 1..25} class="clickable-table-row isolate animate-pulse border-b border-line-subtle">
                <td class="checkbox"><input class="checkbox opacity-50" disabled type="checkbox" /></td>
                <td>
                  <div class="flex items-center gap-2">
                    <.status_dot class="bg-status-offline" />
                    <div class="h-2.5 w-[200px] rounded-full bg-base-700"></div>
                  </div>
                </td>

                <td>
                  <div class="flex items-center justify-center gap-2">
                    <div class="size-4 rounded-full bg-base-700"></div>
                  </div>
                </td>

                <td>
                  <div class="h-2.5 w-20 rounded-full bg-base-700"></div>
                </td>

                <td>
                  <div class="h-2.5 max-w-20 rounded-full bg-base-700"></div>
                </td>

                <td>
                  <div class="h-2.5 max-w-20 rounded-full bg-base-700"></div>
                </td>

                <td>
                  <div class="h-2.5 max-w-20 rounded-full bg-base-700"></div>
                </td>

                <td>
                  <div class="flex items-center gap-1">
                    <div class="h-2.5 w-[30px] rounded-full bg-base-700"></div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </:loading>
      <:failed :let={_failure}>
        <div class="flex h-full items-center justify-center pb-16">
          <span class="text-xl font-medium text-content-strong">There was an error loading the device list, please contact support.</span>
        </div>
      </:failed>

      <%= cond do %>
        <% Enum.empty?(devices) && @currently_filtering -> %>
          <div class="flex h-full items-center justify-center pb-16">
            <span class="text-xl font-medium text-content-strong">No devices match the current filters.</span>
          </div>
        <% Enum.empty?(devices) -> %>
          <div class="flex h-full items-center justify-center pb-16">
            <div class="w-full max-w-2xl px-6">
              <h2 class="mb-4 text-page-title text-content-strong">{@product.name} doesn't have any devices yet.</h2>
              <p class="mb-6 text-sm text-content-muted">Get started by adding <code class="text-content-body">nerves_hub_link</code> to your Nerves project.</p>
              <% active_secret = Enum.find(@product.shared_secret_auths, &is_nil(&1.deactivated_at)) %>
              <%!-- The secret lets a device connect and register itself, so only members who could manage it are shown it. --%>
              <%= if active_secret && authorized?(:"product:update", @current_scope) do %>
                <div class="rounded-md border border-line-default bg-surface-raised p-4">
                  <h3 class="mb-3 text-group-title text-content-strong">1. Add the dependency to your <code>mix.exs</code></h3>
                  <pre class="mb-4 overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-success-content"><code>&#123;:nerves_hub_link, "~&gt; 2.0"&#125;</code></pre>

                  <h3 class="mb-3 text-group-title text-content-strong">2. Add this to your <code>config/config.exs</code></h3>
                  <pre class="overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-success-content"><code>config :nerves_hub_link,
  host: "{onboarding_nhl_host()}",
  remote_iex: true,
  shared_secret: [
    product_key: "{active_secret.key}",
    product_secret: "{active_secret.secret}"
  ]</code></pre>

                  <p class="mt-4 text-xs text-content-faint">
                    See the <a class="text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a>
                    for more details.
                  </p>
                </div>
              <% else %>
                <p class="text-sm text-content-muted">
                  Check the <a class="text-content-body underline hover:text-base-200" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a>
                  for how to connect your first device.
                </p>
              <% end %>

              <div class="mt-6 rounded-md border border-line-subtle bg-surface-muted p-4">
                <h3 class="mb-2 text-group-title text-content-strong">Production authentication</h3>
                <p class="text-xs text-content-muted">
                  For production applications, we recommend mTLS authentication using a local certificate or dedicated secure hardware.
                </p>
                <div class="mt-2 flex gap-4">
                  <a class="text-xs text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.LocalCert.html" target="_blank">
                    LocalCert configurator
                  </a>
                  <a class="text-xs text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.NervesKey.html" target="_blank">
                    NervesKey configurator
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% true -> %>
          <div id="device-list" class="listing hidden" phx-mounted={fade_in("#device-list")}>
            <table class="min-w-max [&_th]:sticky [&_th]:top-0 [&_th]:z-10">
              <thead>
                <tr>
                  <th class="checkbox">
                    <input
                      class="checkbox peer"
                      id="toggle-all"
                      title="Select/unselect all"
                      checked={Enum.any?(devices) && Enum.count(@selected_devices) == Enum.count(devices)}
                      name="toggle-all"
                      type="checkbox"
                      phx-click="select-all"
                      disabled={not authorized?(:"device:update", @current_scope)}
                    />
                    <label for="toggle-all" class="peer-disabled:opacity-40 peer-disabled:hover:bg-base-800">
                      <span class="hidden">Select all devices</span>
                      <span :if={Enum.any?(@selected_devices)} class="lucide-minus--bold size-3 text-primary-content" aria-hidden="true"></span>
                    </label>
                  </th>
                  <th phx-click="sort" phx-value-sort="identifier" class="cursor-pointer">
                    <Sorting.sort_icon text="Identifier" field="identifier" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                  <th :if={show_column?(@current_scope.user, :health)} class="w-24">
                    <div class="flex justify-center">
                      <span>Health</span>
                    </div>
                  </th>
                  <th :if={show_column?(@current_scope.user, :firmware)}>Firmware</th>
                  <th :if={show_column?(@current_scope.user, :platform)}>Platform</th>
                  <th
                    :if={show_column?(@current_scope.user, :connected_info)}
                    phx-click="sort"
                    phx-value-sort="connection_established_at"
                    class="cursor-pointer"
                  >
                    <Sorting.sort_icon text="Connected for" field="connection_established_at" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                  <th :if={show_column?(@current_scope.user, :deployment_group)}>Deployment Group</th>
                  <th :if={show_column?(@current_scope.user, :tags)} phx-click="sort" phx-value-sort="tags" class="cursor-pointer">
                    <Sorting.sort_icon text="Tags" field="tags" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr
                  :for={device <- devices}
                  class={["clickable-table-row isolate border-b border-line-subtle", device.id in @selected_devices && "selected-row"]}
                  style={progress_style(@progress[device.id])}
                >
                  <td class="checkbox">
                    <input
                      id={"checkbox-device-#{device.id}"}
                      class="checkbox peer"
                      {if device.id in @selected_devices, do: [checked: true], else: []}
                      type="checkbox"
                      id={"#{device.id}-select"}
                      aria-label={"Select #{device.identifier}"}
                      phx-value-id={device.id}
                      phx-click="select"
                      disabled={not authorized?(:"device:update", @current_scope)}
                    />
                    <label for={"checkbox-device-#{device.id}"} class="relative z-20 peer-disabled:opacity-40 peer-disabled:hover:bg-base-800">
                      <span :if={device.id in @selected_devices} class="lucide-check--bold size-3 text-primary-content" aria-hidden="true"></span>
                    </label>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <span title={connection_established_at_status(device.latest_connection)}>
                        <%= if @device_statuses.result[device.id] == "online" do %>
                          <.status_dot class="bg-status-online" />
                          <!-- use this when we have connection type information -->
                          <%!-- <span class="lucide-wifi size-4 text-success" aria-hidden="true"></span> --%>
                        <% else %>
                          <.status_dot class="bg-status-offline" />
                          <!-- use this when we have connection type information -->
                          <%!-- <span class="lucide-wifi-off size-4 text-alert" aria-hidden="true"></span> --%>
                        <% end %>
                      </span>
                      <.link navigate={~p"/org/#{@org}/#{@product}/devices/#{device}"} class="ff-m font-mono">
                        {device.identifier}
                        <.tooltip :if={device.deleted_at} id={"health-tooltip-#{device.identifier}"} placement="right" class="z-50 inline-block align-middle">
                          <.icon name="info" class="text-content-muted" />
                          <:content>
                            This device has been deleted. <br /> You can destroy or restore it in the device's settings.
                          </:content>
                        </.tooltip>
                        <span class="clickable-table-row-mask" />
                      </.link>
                      <span class={["ml-2 flex items-center gap-1 rounded-full border border-line-default bg-base-800 px-2.5 py-0.5", !@progress[device.id] && "invisible"]}>
                        <span class="text-xs tracking-tight text-content-body">{@progress[device.id][:stage]}</span>
                      </span>
                    </div>
                  </td>

                  <td :if={show_column?(@current_scope.user, :health)}>
                    <div class="flex items-center justify-center gap-2">
                      <HealthStatus.render device_id={device.id} health={device.latest_health} tooltip_position="top" />
                    </div>
                  </td>

                  <td :if={show_column?(@current_scope.user, :firmware)}>
                    <div class="flex items-center gap-2">
                      <span class="font-mono">
                        <%= if is_nil(device.firmware_metadata) do %>
                          Unknown
                        <% else %>
                          {device.firmware_metadata.version}
                        <% end %>
                      </span>
                      <DeviceUpdateStatus.render :if={not is_nil(device.deployment_id)} device={device} time_zone={@time_zone} />
                    </div>
                  </td>

                  <td :if={show_column?(@current_scope.user, :platform)}>
                    <span>
                      <%= if is_nil(device.firmware_metadata) do %>
                        Unknown
                      <% else %>
                        {device.firmware_metadata.platform}
                      <% end %>
                    </span>
                  </td>

                  <td :if={show_column?(@current_scope.user, :connected_info)}>
                    <div :if={device.latest_connection} title={connection_established_at(device.latest_connection)}>
                      {connection_established_at(device.latest_connection)}
                    </div>
                  </td>

                  <td :if={show_column?(@current_scope.user, :deployment_group)}>
                    <span :if={device.deployment_id} class="flex w-fit items-center gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-2.5 pl-1.5">
                      <.status_dot class="bg-success" />
                      <span class="text-xs tracking-tight text-content-body">{device.deployment_group.name}</span>
                    </span>
                  </td>

                  <td :if={show_column?(@current_scope.user, :tags)}>
                    <div class="flex items-center gap-1 text-nowrap">
                      <%= if !is_nil(device.tags) do %>
                        <%= for tag <- device.tags do %>
                          <.tag>{tag}</.tag>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
      <% end %>
    </.async_result>
  </div>

  <FilterSidebar.render current_filters={@current_filters}>
    <:filter attr="identifier" label="Identifier" type={:text} />
    <:filter
      attr="health_status"
      label="Health Status"
      type={:select}
      values={[
        {"All", ""},
        {"Unknown", "unknown"},
        {"Healthy", "healthy"},
        {"Warning", "warning"},
        {"Unhealthy", "unhealthy"}
      ]}
    />
    <:filter
      attr="connection"
      label="Connection"
      type={:select}
      values={[
        {"All", ""},
        {"Connected", "connected"},
        {"Disconnected", "disconnected"},
        {"Not seen in 7 days", "not_seen_in_seven_days"},
        {"Not seen in 14 days", "not_seen_in_fourteen_days"},
        {"Not Seen", "not_seen"}
      ]}
    />
    <:filter
      attr="connection_type"
      label="Connection Type"
      type={:select}
      values={[
        {"All", ""},
        {"Cellular", "cellular"},
        {"Ethernet", "ethernet"},
        {"WiFi", "wifi"},
        {"Unknown", "unknown"}
      ]}
    />

    <:filter
      attr="deployment_id"
      label="Deployment Group"
      type={:select}
      values={[
        {"All", ""},
        {"No Deployment Group", "-1"}
        | Enum.map(@deployment_groups, &{&1.name, to_string(&1.id)})
      ]}
    />
    <:filter
      attr="updates"
      label="Firmware Updates"
      type={:select}
      values={[
        {"All", ""},
        {"Enabled", "enabled"},
        {"Penalty Box", "penalty-box"},
        {"Failed Updates", "failed-updates"},
        {"Disabled", "disabled"}
      ]}
    />
    <:filter
      attr="firmware_version"
      label="Firmware"
      type={:select}
      values={[{"All", ""} | Enum.map(@firmware_versions, &{&1, &1})] ++ [{"Unknown", "Unknown"}]}
      hint="Only versions currently running on devices in this product are listed. Uploaded firmware which no device is running won't appear."
    />
    <:filter
      attr="firmware_validation_status"
      label="Firmware Validation"
      type={:select}
      values={[
        {"All", ""},
        {"Validated", "validated"},
        {"Not validated", "not_validated"},
        {"Unknown", "unknown"}
      ]}
    />
    <:filter
      attr="signer_ca"
      label="Signer CA"
      type={:select}
      hint="Only certificate authorities which signed a certificate held by a device in this product are listed."
      values={
        [{"All", ""} | Enum.map(@signer_cas, &{CAHelpers.label(&1), &1.serial})] ++
          [{"No known CA", AdvancedQuery.Schema.not_set_value()}]
      }
    />
    <:filter attr="platform" label="Platform" type={:select} values={[{"All", ""} | Enum.map(@platforms, &{if(&1, do: &1, else: "Unknown"), &1})]} />
    <:filter attr="tags" label="Tags" type={:text} />
    <:filter attr="has_no_tags" label="Untagged" type={:select} values={[{"All", "false"}, {"Only untagged", "true"}]} />
    <:filter attr="alarm_status" label="Alarm Status" type={:select} values={[{"All", ""}, {"Has Alarms", "with"}, {"No Alarms", "without"}]} />
    <:filter attr="alarm" label="Alarm" type={:select} values={[{"All", ""} | Enum.map(@current_alarms, &{&1, &1})]} />
    <:filter attr="metrics_key" label="Metrics" type={:select} values={[{"All", ""} | Enum.map(@metrics_keys, &{&1, &1})]} />
    <:filter attr="metrics_operator" label="Metrics Operator" type={:select} values={[{"Greater Than", "gt"}, {"Less Than", "lt"}]} />
    <:filter attr="metrics_value" label="Metrics Value" type={:number} />
    <:filter attr="is_pinned" label="Pinned" type={:select} values={[{"All", "false"}, {"Only pinned devices", "true"}]} />
    <:filter
      attr="display_deleted"
      label="Include Deleted Devices?"
      type={:select}
      values={[
        {"Yes", "include"},
        {"No", "exclude"},
        {"Only deleted devices", "only"}
      ]}
    />
    <:filter attr="only_updating" label="Update status" type={:select} values={[{"All", "false"}, {"Updating", "true"}]} />
  </FilterSidebar.render>

  <ListSettingsSidebar.render
    available_columns={NervesHub.Accounts.User.DisplayPreferences.device_list_columns()}
    selected_columns={get_in(@current_scope.user.display_preferences.device_list_columns)}
  />

  <BulkActionsSidebar.render
    selected_devices={@selected_devices}
    select_all_matching={@select_all_matching}
    total_entries={@total_entries}
    current_scope={@current_scope}
    target_product={@target_product}
    move_target_org_ids={@move_target_org_ids}
    product={@product}
    selected_have_deployment_groups={@selected_have_deployment_groups}
    valid_deployment_groups_for_selected={@valid_deployment_groups_for_selected}
    target_deployment_group={@target_deployment_group}
    target_firmware={@target_firmware}
    selected_shared_deployment_group={@selected_shared_deployment_group}
    valid_tags={@valid_tags}
    device_tags={@device_tags}
    tag_operation={@tag_operation}
    available_tags={@available_tags}
    available_firmwares_for_filtered_platform={@available_firmwares_for_filtered_platform}
  />

  <:pagination :if={@devices.ok?} pager={@pager_meta} page_sizes={[25, 50, 100]} />
</NervesHubWeb.Layouts.sidebar>
