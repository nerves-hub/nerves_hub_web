<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <div class={["flex min-w-0 items-baseline gap-3", (@selecting? or @selected_devices != []) && "max-sm:hidden"]}>
      <h1 class="text-base/6 font-semibold text-content-strong">Devices</h1>
      <span :if={!@devices.ok?} class="font-mono text-xs text-content-muted">Loading...</span>
      <span :if={@devices.ok? and @product_device_count != 0} class="truncate font-mono text-xs text-content-muted">
        <span id="device-count">{Number.Delimit.number_to_delimited(@total_entries, precision: 0)}</span><span class="max-sm:hidden">{device_count_suffix(@total_entries, @product_device_count)}</span>
      </span>
    </div>
    <%!-- On a phone, choosing devices takes over the title: how many, and
          Done to stop. The bulk bar along the bottom has the actions. --%>
    <div :if={@selecting? or @selected_devices != []} id="phone-selection" class="flex min-w-0 flex-1 items-center gap-3 sm:hidden">
      <span class="text-base/6 font-semibold whitespace-nowrap text-content-strong">
        <span class="font-mono">{Number.Delimit.number_to_delimited(if(@select_all_matching, do: @total_entries, else: length(@selected_devices)), precision: 0)}</span> selected
      </span>
      <button
        :if={not @select_all_matching and @selected_devices != [] and length(@selected_devices) < @total_entries}
        type="button"
        phx-click="select-all-matching"
        class="cursor-pointer truncate text-ui/4 font-medium text-primary light:text-indigo-600"
      >
        Select all <span class="font-mono">{Number.Delimit.number_to_delimited(@total_entries, precision: 0)}</span>
      </button>
      <.button id="phone-selection-done" type="button" phx-click="deselect-all" class="mr-1 ml-auto">Done</.button>
    </div>
    <div class={["mr-6 flex items-center gap-2 max-sm:mr-2", (@selecting? or @selected_devices != []) && "max-sm:hidden"]}>
      <.button
        :if={has_results?(@devices, @currently_filtering)}
        type="link"
        square
        aria-label="Export devices"
        title="Export devices"
        href={~p"/org/#{@org}/#{@product}/devices/export?#{@params}"}
        download
      >
        <span class="lucide-download size-4" aria-hidden="true"></span>
      </.button>
      <.button type="link" style="primary" navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/new"} aria-label="Add new device">
        <span class="lucide-plus--bold" aria-hidden="true"></span> Add<span class="max-sm:hidden"> device</span>
      </.button>
    </div>
  </:top_bar>

  <DeviceList.state_tabs
    :if={has_results?(@devices, @currently_filtering)}
    tabs={@state_tabs}
    selected={@current_filters.state}
    counts={@state_counts}
    loading={@list_loading?}
    class={peek_docked?(@current_filters, @devices, @peek_device_id) && "lg:mr-150"}
  />

  <div
    :if={@current_filters.state == "attention" && has_results?(@devices, @currently_filtering)}
    class={["shrink-0 px-6 pt-4 max-sm:px-0 max-sm:pt-3", peek_docked?(@current_filters, @devices, @peek_device_id) && "lg:mr-150"]}
  >
    <DeviceList.reason_tabs tabs={@reason_tabs} selected={@current_filters.reason} counts={@state_counts} />
  </div>

  <div
    :if={has_results?(@devices, @currently_filtering) || @soft_deleted_devices_exist}
    class={[
      "flex shrink-0 items-start gap-2 px-6 pb-3 max-sm:px-4",
      if(@current_filters.state == "attention", do: "pt-3", else: "pt-4"),
      peek_docked?(@current_filters, @devices, @peek_device_id) && "lg:mr-150"
    ]}
  >
    <AdvancedSearch.field
      :if={has_results?(@devices, @currently_filtering)}
      query={@current_filters[:advanced_query]}
      error={@advanced_query_error}
      schema_json={@advanced_query_schema_json}
    />
    <.button
      id="sidebar-filter-button"
      type="button"
      phx-click={DeviceFilters.open()}
      aria-expanded={to_string(@filters_open?)}
      aria-controls="filter-panel"
      class={["max-sm:h-10 max-sm:px-3", !has_results?(@devices, @currently_filtering) && "ml-auto"]}
    >
      <span class="lucide-list-filter" aria-hidden="true"></span>
      Filters
      <.badge :if={filter_count(@current_filters) > 0} count tone="notice" aria-label={"#{filter_count(@current_filters)} applied"}>
        {filter_count(@current_filters)}
      </.badge>
    </.button>
    <.button :if={@current_filters.state != "attention"} type="button" aria-label="List settings" class="max-sm:hidden" phx-click={ListSettingsSidebar.show_settings_sidebar()}>
      <span class="lucide-columns-3" aria-hidden="true"></span> Columns
    </.button>
  </div>

  <DeviceFilters.tokens
    filters={@current_filters}
    deployment_groups={@deployment_groups}
    signer_cas={@signer_cas}
    class={[
      "-mt-1",
      peek_docked?(@current_filters, @devices, @peek_device_id) && "lg:mr-150"
    ]}
  />

  <div
    id="device-container"
    class={[
      "h-0 flex-1 overflow-auto px-6 max-sm:px-4",
      peek_docked?(@current_filters, @devices, @peek_device_id) && "lg:mr-150",
      if(@selected_devices == [], do: "pb-5", else: "pb-20")
    ]}
    phx-hook="PageVisible"
    aria-busy={to_string(@list_loading?)}
  >
    <%!-- A different list on its way: a line slides along the top of the old
          one, which dims. Both wait a moment, so a quick load doesn't flash. --%>
    <div
      :if={@list_loading?}
      id="list-loading"
      class="pointer-events-none sticky top-0 z-40 -mb-0.5 h-0.5 animate-[fadeIn_150ms_ease-out_200ms_both] overflow-hidden rounded-full"
      aria-hidden="true"
    >
      <div class="h-full w-2/5 animate-progress-slide rounded-full bg-primary motion-reduce:w-full motion-reduce:animate-none"></div>
    </div>
    <.async_result :let={devices} assign={@devices}>
      <:loading>
        <div class="flex flex-col gap-2 pt-1 sm:hidden" aria-busy="true">
          <div :for={_ <- 1..6} class="flex h-23 animate-pulse flex-col gap-3 rounded-card border border-line-default bg-surface-raised p-3">
            <div class="flex items-center gap-2">
              <.status_dot class="bg-status-offline" />
              <div class="h-2.5 w-36 rounded-full bg-base-800"></div>
            </div>
            <div class="ml-3.75 h-2.5 w-24 rounded-full bg-base-800"></div>
            <div class="ml-3.75 h-2.5 w-40 rounded-full bg-base-800"></div>
          </div>
        </div>
        <div class="w-max min-w-full overflow-clip rounded-card border border-line-default bg-surface-raised max-sm:hidden" aria-busy="true">
          <table class="w-full text-left">
            <thead>
              <tr class="h-9 border-b border-line-default bg-surface">
                <th class="w-8 pl-4"><span class="block size-3.5 rounded-[3px] border border-line-control opacity-50"></span></th>
                <th :for={label <- ~w(Device Health Firmware Platform Group Connection Tags)} class="pr-4 text-label text-content-faint uppercase">
                  {label}
                </th>
              </tr>
            </thead>
            <tbody>
              <tr :for={_ <- 1..12} class="h-11 animate-pulse border-b border-line-subtle last:border-b-0">
                <td class="pl-4"><span class="block size-3.5 rounded-[3px] border border-line-control opacity-50"></span></td>
                <td class="w-52 pr-4">
                  <div class="flex items-center gap-2">
                    <.status_dot class="bg-status-offline" />
                    <div class="h-2.5 w-36 rounded-full bg-base-800"></div>
                  </div>
                </td>
                <td class="w-28 pr-4">
                  <div class="h-2.5 w-14 rounded-full bg-base-800"></div>
                </td>
                <td class="w-60 pr-4">
                  <div class="h-2.5 w-28 rounded-full bg-base-800"></div>
                </td>
                <td class="w-20 pr-4">
                  <div class="h-2.5 w-10 rounded-full bg-base-800"></div>
                </td>
                <td class="w-40 pr-4">
                  <div class="h-2.5 w-24 rounded-full bg-base-800"></div>
                </td>
                <td class="w-32 pr-4">
                  <div class="h-2.5 w-16 rounded-full bg-base-800"></div>
                </td>
                <td class="pr-4">
                  <div class="h-2.5 w-10 rounded-full bg-base-800"></div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </:loading>
      <:failed :let={_failure}>
        <div class="flex h-full items-center justify-center pb-16">
          <span class="text-xl font-medium text-content-strong">There was an error loading the device list, please contact support.</span>
        </div>
      </:failed>

      <%= cond do %>
        <% Enum.empty?(devices) && @currently_filtering && only_state_filtered?(@current_filters) -> %>
          <div id="empty-tab" class={["flex flex-col items-center gap-1 pt-24 pb-16 text-center", loading_dim(@list_loading?)]}>
            <span :if={@current_filters.state == "attention"} class="mb-3 flex size-11 items-center justify-center rounded-full bg-success-soft">
              <span class="lucide-check--bold size-4.5 text-success-content" aria-hidden="true"></span>
            </span>
            <p class="text-list-title text-content-strong">{empty_tab_title(@current_filters)}</p>
            <p class="max-w-md text-ui/5 text-content-muted">{empty_tab_detail(@current_filters)}</p>
          </div>
        <% Enum.empty?(devices) && @currently_filtering -> %>
          <DeviceList.no_matches
            removable={length(no_match_removable(@current_filters))}
            suggestions={@no_match_suggestions}
            can_reset={DeviceFilters.applied(@current_filters) != []}
            search_only={no_match_removable(@current_filters) == [:advanced_query]}
            class={loading_dim(@list_loading?)}
          />
        <% Enum.empty?(devices) -> %>
          <% {secret, secret_reason} = onboarding_secret(@product, @current_scope) %>
          <DeviceOnboarding.render product={@product} host={onboarding_nhl_host()} secret={secret} secret_reason={secret_reason} />
        <% @current_filters.state == "attention" -> %>
          <%!-- The list opens its first device in the peek on a wide screen,
                and again whenever a different list loads (`data-key`), but
                not on a refresh of the same one, so a closed peek stays
                closed. --%>
          <ul
            id="attention-list"
            phx-hook="AttentionList"
            data-key={@list_key}
            class={[
              "overflow-clip rounded-card border border-line-default bg-surface-raised",
              "max-sm:flex max-sm:flex-col max-sm:gap-2 max-sm:overflow-visible max-sm:border-0 max-sm:bg-transparent",
              loading_dim(@list_loading?)
            ]}
          >
            <DeviceList.attention_row
              :for={device <- devices}
              device={device}
              status={@device_statuses.result[device.id]}
              reason={@current_filters.reason}
              peeked={device.id == @peek_device_id}
              path={~p"/org/#{@org}/#{@product}/devices/#{device}"}
            />
          </ul>
        <% true -> %>
          <%!-- A phone has no column headers to sort by or select from, so
                this line above the cards does both. --%>
          <div id="phone-list-meta" class="flex items-center justify-between gap-3 pt-0.5 pb-2.5 sm:hidden">
            <span class="text-xs whitespace-nowrap text-content-muted">{page_range(@pager_meta)}</span>
            <div class="flex items-center gap-3">
              <form id="phone-sort" phx-change="sort-by">
                <label for="phone-sort-select" class="sr-only">Sort</label>
                <select
                  id="phone-sort-select"
                  name="sort"
                  class="h-8 rounded border-0 bg-transparent py-0 pr-7 pl-1 text-right text-xs text-content-body focus:ring-0"
                >
                  {Phoenix.HTML.Form.options_for_select(phone_sort_options(), "#{@current_sort}:#{@sort_direction}")}
                </select>
              </form>
              <.button
                :if={not (@selecting? or @selected_devices != []) and authorized?(:"device:update", @current_scope)}
                id="phone-select"
                type="button"
                size="sm"
                phx-click="start-selecting"
              >
                Select
              </.button>
            </div>
          </div>
          <div
            id="device-list"
            class={[
              "w-max min-w-full overflow-clip rounded-card border border-line-default bg-surface-raised",
              "max-sm:w-full max-sm:overflow-visible max-sm:border-0 max-sm:bg-transparent",
              loading_dim(@list_loading?)
            ]}
          >
            <table class="w-full text-left max-sm:block">
              <thead class="sticky top-0 z-30 max-sm:hidden">
                <tr class="h-9 border-b border-line-default bg-surface [&>th]:pr-4 [&>th]:text-label [&>th]:text-content-faint [&>th]:uppercase">
                  <th class="relative w-8 p-0">
                    <input
                      class="peer sr-only"
                      id="toggle-all"
                      title="Select/unselect all"
                      checked={Enum.any?(devices) && Enum.count(@selected_devices) == Enum.count(devices)}
                      name="toggle-all"
                      type="checkbox"
                      phx-click="select-all"
                      disabled={not authorized?(:"device:update", @current_scope)}
                    />
                    <label for="toggle-all" class={["h-9", checkbox_classes()]}>
                      <span class="sr-only">Select all devices</span>
                      <span class="checkbox-box">
                        <span :if={Enum.any?(@selected_devices)} class="lucide-minus--bold size-2.5 text-primary-content" aria-hidden="true"></span>
                      </span>
                    </label>
                  </th>
                  <th class="w-52 cursor-pointer" phx-click="sort" phx-value-sort="identifier">
                    <Sorting.sort_icon text="Device" field="identifier" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                  <th :if={show_column?(@current_scope.user, :health)} class="w-28">Health</th>
                  <th :if={show_column?(@current_scope.user, :firmware)} class="w-60">Firmware</th>
                  <th :if={show_column?(@current_scope.user, :platform)} class="w-20">Platform</th>
                  <th :if={show_column?(@current_scope.user, :deployment_group)} class="w-40">Deployment group</th>
                  <th
                    :if={show_column?(@current_scope.user, :connected_info)}
                    class="w-32 cursor-pointer"
                    phx-click="sort"
                    phx-value-sort="connection_established_at"
                  >
                    <Sorting.sort_icon text="Connection" field="connection_established_at" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                  <th :if={show_column?(@current_scope.user, :tags)} class="cursor-pointer" phx-click="sort" phx-value-sort="tags">
                    <Sorting.sort_icon text="Tags" field="tags" selected_field={@current_sort} selected_direction={@sort_direction} />
                  </th>
                  <th class="w-16"><span class="sr-only">Peek</span></th>
                </tr>
              </thead>
              <%!-- Below sm each row is a card: a grid that puts the identifier
                    and health on top, the firmware under them, and the
                    group, tags and connection last. Cells for columns that
                    are switched off still render for it, hidden from sm up. --%>
              <tbody class="max-sm:flex max-sm:flex-col max-sm:gap-2">
                <tr
                  :for={device <- devices}
                  id={"device-row-#{device.id}"}
                  phx-click={JS.push("peek", value: %{id: device.id})}
                  data-peeked={device.id == @peek_device_id}
                  class={[
                    "group h-11 cursor-pointer scroll-mt-9 border-b border-line-subtle last:border-b-0 hover:bg-primary/4 [&>td]:pr-4",
                    "max-sm:grid max-sm:h-auto max-sm:scroll-mt-2 max-sm:grid-cols-[auto_auto_minmax(0,1fr)_auto] max-sm:items-center max-sm:gap-y-2 max-sm:rounded-card max-sm:border max-sm:p-3 max-sm:last:border-b max-sm:[&>td]:pr-0",
                    if(device.id in @selected_devices,
                      do: "bg-primary/8 hover:bg-primary/10 max-sm:border-primary/40",
                      else: "max-sm:border-line-default max-sm:bg-surface-raised"
                    ),
                    device.id == @peek_device_id && "bg-primary/6 shadow-[inset_2px_0_0_var(--color-primary)]"
                  ]}
                >
                  <%!-- An empty click binding here and on the identifier stops
                        the row's, so selecting a device or opening it doesn't
                        also open the peek. --%>
                  <td
                    class={["relative p-0", if(@selecting? or @selected_devices != [], do: "max-sm:col-start-1 max-sm:row-start-1 max-sm:mr-2.5", else: "max-sm:hidden")]}
                    phx-click={%JS{}}
                  >
                    <input
                      id={"checkbox-device-#{device.id}"}
                      class="peer sr-only"
                      {if device.id in @selected_devices, do: [checked: true], else: []}
                      type="checkbox"
                      aria-label={"Select #{device.identifier}"}
                      phx-value-id={device.id}
                      phx-click="select"
                      disabled={not authorized?(:"device:update", @current_scope)}
                    />
                    <label for={"checkbox-device-#{device.id}"} class={["h-11 max-sm:h-5 max-sm:w-auto max-sm:pl-0", checkbox_classes()]}>
                      <span class="checkbox-box">
                        <span :if={device.id in @selected_devices} class="lucide-check--bold size-2.5 text-primary-content" aria-hidden="true"></span>
                      </span>
                    </label>
                  </td>
                  <td class="max-sm:col-span-2 max-sm:col-start-2 max-sm:row-start-1 max-sm:min-w-0">
                    <div class="flex items-center gap-2">
                      <.status_dot
                        class={[
                          "size-1.75",
                          if(@device_statuses.result[device.id] == "online", do: "bg-status-online", else: "bg-status-offline"),
                          (@selecting? or @selected_devices != []) && "max-sm:hidden"
                        ]}
                        title={if @device_statuses.result[device.id] == "online", do: "Online", else: "Offline"}
                      />
                      <.link
                        navigate={~p"/org/#{@org}/#{@product}/devices/#{device}"}
                        phx-click={%JS{}}
                        class="font-mono text-ui/4 whitespace-nowrap text-content-strong hover:underline hover:decoration-line-strong max-sm:truncate max-sm:text-sm/4.5 max-sm:font-medium max-sm:underline max-sm:decoration-line-strong max-sm:underline-offset-3"
                      >
                        {device.identifier}
                      </.link>
                      <.tooltip :if={device.deleted_at} id={"deleted-tooltip-#{device.id}"} placement="right" class="inline-block align-middle">
                        <.badge>Deleted</.badge>
                        <:content>
                          This device has been deleted. <br /> You can destroy or restore it in the device's settings.
                        </:content>
                      </.tooltip>
                    </div>
                  </td>

                  <td class={["max-sm:col-start-4 max-sm:row-start-1 max-sm:ml-2 max-sm:justify-self-end", column_class(@current_scope.user, :health)]}>
                    <DeviceList.health device_id={device.id} health={device.latest_health} />
                  </td>

                  <td class={[
                    "max-sm:col-span-3 max-sm:col-start-2 max-sm:row-start-2",
                    !(@selecting? or @selected_devices != []) && "max-sm:pl-3.75",
                    column_class(@current_scope.user, :firmware)
                  ]}>
                    <DeviceList.firmware device={device} progress={@progress[device.id]} />
                  </td>

                  <td :if={show_column?(@current_scope.user, :platform)} class="font-mono text-xs whitespace-nowrap text-content-muted max-sm:hidden">
                    {if device.firmware_metadata, do: device.firmware_metadata.platform, else: "—"}
                  </td>

                  <td class={[
                    "text-ui/4 whitespace-nowrap max-sm:col-start-2 max-sm:row-start-3 max-sm:max-w-40 max-sm:truncate max-sm:text-xs/4",
                    !(@selecting? or @selected_devices != []) && "max-sm:pl-3.75",
                    column_class(@current_scope.user, :deployment_group)
                  ]}>
                    <span :if={device.deployment_group} class="text-content-body">{device.deployment_group.name}</span>
                    <span :if={!device.deployment_group} class="text-content-faint"><span class="max-sm:hidden">None</span><span class="sm:hidden">No group</span></span>
                  </td>

                  <td class={[
                    "whitespace-nowrap max-sm:col-start-4 max-sm:row-start-3 max-sm:ml-2 max-sm:justify-self-end max-sm:[&>span]:text-xs/4",
                    column_class(@current_scope.user, :connected_info)
                  ]}>
                    <DeviceList.connection device={device} status={@device_statuses.result[device.id]} />
                  </td>

                  <td class={[
                    "max-sm:col-start-3 max-sm:row-start-3 max-sm:min-w-0",
                    column_class(@current_scope.user, :tags)
                  ]}>
                    <div class="flex items-center gap-1 text-nowrap max-sm:hidden">
                      <.tag :for={tag <- device.tags || []}>{tag}</.tag>
                    </div>
                    <p :if={device.tags not in [nil, []]} class="truncate text-xs/4 text-content-body sm:hidden">
                      <span class="mx-1.5 text-content-faint" aria-hidden="true">·</span>{Enum.join(device.tags, ", ")}
                    </p>
                  </td>

                  <td class="w-16 text-right max-sm:hidden">
                    <span class={[
                      "inline-flex h-5.5 items-center gap-1 rounded-full border border-line-default bg-surface-raised px-2 text-xs text-content-muted",
                      if(device.id == @peek_device_id, do: "invisible", else: "invisible group-hover:visible")
                    ]}>
                      Peek <span class="lucide-panel-right size-3" aria-hidden="true"></span>
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
      <% end %>
      <DeviceList.pager :if={devices != []} pager={@pager_meta} />
    </.async_result>
  </div>

  <DeviceFilters.panel
    :if={@filters_open?}
    filters={@current_filters}
    facets={@facets}
    find={@filter_find}
    firmware_versions={@firmware_versions}
    deployment_groups={@deployment_groups}
    platforms={@platforms}
    alarms={@current_alarms}
    metrics_keys={@metrics_keys}
    signer_cas={@signer_cas}
    total={if(@devices.ok?, do: @total_entries)}
    product_total={@product_device_count}
  />

  <DevicePeek.panel
    :for={device <- List.wrap(peek_device(@devices, @peek_device_id))}
    device={device}
    status={@device_statuses.result[device.id]}
    progress={@progress[device.id]}
    data={@peek}
    current_scope={@current_scope}
    docked={@current_filters.state == "attention"}
  />

  <ListSettingsSidebar.render
    available_columns={NervesHub.Accounts.User.DisplayPreferences.device_list_columns()}
    selected_columns={get_in(@current_scope.user.display_preferences.device_list_columns)}
  />

  <BulkBar.render
    selected_devices={@selected_devices}
    select_all_matching={@select_all_matching}
    total_entries={@total_entries}
    menu={@bulk_menu}
    peek_open={not is_nil(peek_device(@devices, @peek_device_id))}
    current_scope={@current_scope}
    product={@product}
    target_product={@target_product}
    move_target_org_ids={@move_target_org_ids}
    selected_have_deployment_groups={@selected_have_deployment_groups}
    selected_shared_deployment_group={@selected_shared_deployment_group}
    valid_deployment_groups_for_selected={@valid_deployment_groups_for_selected}
    target_deployment_group={@target_deployment_group}
    available_firmwares_for_filtered_platform={@available_firmwares_for_filtered_platform}
    target_firmware={@target_firmware}
    valid_tags={@valid_tags}
    device_tags={@device_tags}
    bulk_tags={@bulk_tags}
    tag_operation={@tag_operation}
    available_tags={@available_tags}
  />
</NervesHubWeb.Layouts.sidebar>
