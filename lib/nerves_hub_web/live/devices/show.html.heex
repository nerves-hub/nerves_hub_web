<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.breadcrumb
      navigate={~p"/org/#{@org}/#{@product}/devices"}
      root_label="All Devices"
      root_class="whitespace-nowrap sm:hidden md:block"
      class="header-scrolled:max-sm:hidden"
    >
      <:crumb class="hidden lg:block">{@device.identifier}</:crumb>
    </.breadcrumb>

    <Header.compact_bar device={@device} device_connection={@device_connection} org={@org} product={@product} />

    <div class="ml-auto flex items-center sm:mr-6 header-scrolled:max-sm:hidden">
      <div id="present-users" phx-update="stream" class="flex h-7 flex-row-reverse -space-x-1 space-x-reverse">
        <.tooltip :for={{id, %{user: user}} <- @streams.presences} id={id} class="z-10 inline-flex cursor-default items-center justify-center">
          <span :if={!@user.profile_picture_url} class="inline-flex size-7 items-center justify-center rounded-full bg-base-800 px-1 text-sm font-medium text-content-muted ring-2 ring-surface-muted">
            {String.split(user.name) |> Enum.map(fn w -> String.at(w, 0) |> String.upcase() end)}
          </span>
          <img :if={@user.profile_picture_url} src={@user.profile_picture_url} alt="User Profile Picture" class="size-7 rounded-full object-cover ring-2 ring-surface-muted" />
          <:content>
            {user.name}
          </:content>
        </.tooltip>
      </div>
    </div>
  </:top_bar>

  <%!-- On a phone the header scrolls away with the tab, under tabs that stick
        to the top; from sm up only the tab's content scrolls. --%>
  <div id="device-page" phx-hook="DevicePageScroll" data-tab={@tab} class="flex h-0 flex-1 flex-col max-sm:overflow-y-auto terminal-typing:overflow-hidden">
    <div class="relative shrink-0">
      <UpdateProgress.line
        :if={UpdateProgress.updating?(@firmware_update_stage)}
        stage={@firmware_update_stage}
        progress={@firmware_update_progress}
        class="absolute inset-x-0 top-0 z-10"
      />

      <Header.render
        device={@device}
        device_connection={@device_connection}
        org={@org}
        product={@product}
        current_scope={@current_scope}
        pinned?={@pinned?}
        end_tabs={device_end_tabs(assigns)}
        time_zone={@time_zone}
        firmware_update_stage={@firmware_update_stage}
        firmware_update_progress={@firmware_update_progress}
        inflight_version={@inflight_version}
      />
    </div>

    <Header.tabs tabs={device_tabs(assigns)} end_tabs={device_end_tabs(assigns)} selected={@tab} />

    <div class="flex h-0 flex-1 flex-col overflow-y-auto max-sm:h-auto max-sm:flex-none max-sm:overflow-visible">
      <div :if={@device.deleted_at} class="flex h-[89px] shrink-0 items-center justify-center bg-alert-soft p-4">
        <div class="font-medium text-alert">
          Device is deleted and must be restored to use.
        </div>
      </div>

      <.render_tab {assigns} />
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
