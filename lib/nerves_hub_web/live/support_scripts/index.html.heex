<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-page-title text-content-strong">All Support Scripts</h1>
    <.badge class="mr-auto">
      {@pager_meta.total_count}
    </.badge>

    <form id="script-filters-form" class="flex items-center" phx-change="update-filters">
      <div class="grid grid-cols-1">
        <input
          type="text"
          class="col-start-1 row-start-1 block h-9 w-64 gap-2 rounded border border-line-strong bg-surface-muted px-3 py-1 text-sm font-normal text-content-muted"
          name="search"
          id="script_search_top"
          placeholder="Search by name or tags..."
          title="Search"
          value={@current_filters[:search]}
          phx-debounce="500"
        />

        <span class="pointer-events-none col-start-1 row-start-1 mr-3 lucide-search size-4 self-center justify-self-end text-content-muted" aria-hidden="true"></span>
      </div>
    </form>

    <.button type="link" navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts/new"} aria-label="Add a support script">
      <.icon name="add" />Add Support Script
    </.button>
  </:header>

  <div class="h-0 flex-1 overflow-y-auto">
    <div :if={Enum.any?(@scripts)} class="listing">
      <table>
        <thead>
          <tr>
            <th phx-click="sort" phx-value-sort="name" class="cursor-pointer">
              <Sorting.sort_icon text="Name" field="name" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th phx-click="sort" phx-value-sort="updated_at" class="cursor-pointer">
              <Sorting.sort_icon text={"Last updated (#{zone_abbr(@time_zone)})"} field="updated_at" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th phx-click="sort" phx-value-sort="last_updated_by" class="cursor-pointer">
              <Sorting.sort_icon text="Updated by" field="last_updated_by" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th>
              Language
            </th>
            <th>
              Tags
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={script <- @scripts} class="border-b border-line-subtle">
            <td class="h-[52px]">
              <.link class="flex size-full items-center" navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts/#{script}/edit"}>
                {script.name}
              </.link>
            </td>
            <td>
              <.local_datetime at={script.updated_at} time_zone={@time_zone} zone_label={false} />
            </td>
            <td>
              {script.last_editor_name}
            </td>
            <td>
              {Script.language_label(script.language)}
            </td>
            <td>
              <div class="flex items-center gap-[4px] text-nowrap">
                <%= if !is_nil(script.tags) do %>
                  <%= for tag <- script.tags do %>
                    <.tag>{tag}</.tag>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div :if={Enum.empty?(@scripts) && @currently_filtering} class="flex h-full items-center justify-center pb-16">
      <span class="text-xl font-medium text-content-strong">No Support Scripts match the current filters.</span>
    </div>

    <div :if={Enum.empty?(@scripts) && !@currently_filtering} class="flex h-full items-center justify-center pb-16">
      <span class="font-mono text-xl font-medium text-content-muted">{@current_scope.product.name} doesn’t have any Support Scripts.</span>
    </div>
  </div>

  <:pagination pager={@pager_meta} page_sizes={[25, 50, 100]} />
</NervesHubWeb.Layouts.sidebar>
