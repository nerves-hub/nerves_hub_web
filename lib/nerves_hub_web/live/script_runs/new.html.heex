<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.breadcrumb navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts/runs"} root_label="All Script Runs">
      <:crumb>Run a Script</:crumb>
    </.breadcrumb>
  </:top_bar>

  <:header>
    <h1 class="text-base-50 text-xl leading-[30px] font-semibold">Run a Script</h1>
  </:header>

  <div class="h-0 flex-1 overflow-y-auto">
    <div class="flex flex-col items-start justify-between gap-4 p-6">
      <.form id="new-script-run-form" for={@form} class="flex w-full flex-col gap-4" phx-change="validate" phx-submit="create-run">
        <div class="bg-surface-raised border-base-700 flex w-full flex-col rounded border">
          <div class="border-base-700 flex h-14 items-center justify-between border-b px-4">
            <div class="text-base-50 text-base font-medium">General settings</div>
          </div>
          <div class="flex gap-6 p-6">
            <div class="flex w-1/2 flex-col gap-6">
              <.input field={@form[:name]} label="Name" placeholder="Reboot the cellular fleet" phx-debounce="blur" />
              <.input
                name="script_id"
                id="copy-from-script"
                label="Start from a support script"
                type="select"
                value={@copied_script_id}
                prompt="Choose from below"
                options={Enum.map(@scripts, &{&1.name, &1.id})}
                phx-change="copy-script"
                hint="Copies the script's code in to edit. The run keeps its own copy, so later edits to the script don't change it."
              />
              <.input
                field={@form[:language]}
                label="Language"
                type="select"
                options={Enum.map(Script.languages(), &{Script.language_label(&1), &1})}
                hint="Elixir runs on devices using NervesHubLink. Shell runs on devices using the Linux agent."
              />
            </div>

            <div class="flex w-1/2 flex-col gap-2">
              <.input field={@form[:text]} label="Script code" type="textarea" rows="10" phx-debounce="2000" />
              <div class="text-base-400 text-xs tracking-wide">
                {syntax_hint(@form[:language].value)}
              </div>
            </div>
          </div>
        </div>

        <div class="bg-surface-raised border-base-700 flex w-full flex-col rounded border">
          <div class="border-base-700 flex h-14 items-center justify-between border-b px-4">
            <div class="text-base-50 text-base font-medium">Target devices</div>
          </div>
          <div class="flex gap-6 p-6">
            <div class="flex w-1/2 flex-col gap-6">
              <.input
                field={@form[:filter_type]}
                label="Choose devices by"
                type="select"
                prompt="Select a filter"
                options={Enum.map(ScriptRunner.filter_types(), &{ScriptRunner.filter_type_label(&1), &1})}
              />
            </div>

            <div class="flex w-1/2 flex-col gap-6">
              <.inputs_for :let={filter} field={@form[:filter]}>
                <%!-- Only the chosen filter type's fields are shown; the changeset
                      requires the values for that type and ignores the rest. --%>
                <div :if={@filter_type == :tags} class="flex flex-col gap-6">
                  <.tag_input field={filter[:tags]} label="Device tags" placeholder="production, cellular" available_tags={@available_tags} />
                  <.input
                    field={filter[:tag_operator]}
                    label="Tag matching"
                    type="select"
                    prompt="Choose how tags combine"
                    options={Enum.map(ScriptRunner.tag_operators(), &{ScriptRunner.tag_operator_label(&1), &1})}
                    hint="Require all: a device must carry every tag. Allow any: at least one is enough."
                  />
                </div>

                <div :if={@filter_type == :identifiers} class="flex flex-col gap-2">
                  <.core_label>Device identifiers</.core_label>

                  <div class="flex items-center gap-4">
                    <label :for={{source, label} <- [{"typed", "Type them"}, {"csv", "Upload a CSV"}]} class="text-base-300 flex items-center gap-2 text-sm">
                      <input
                        type="radio"
                        name="identifier_source"
                        value={source}
                        checked={to_string(@identifier_source) == source}
                        phx-click="identifier-source"
                        phx-value-identifier_source={source}
                        class="border-base-700 checked:bg-primary text-base-400 focus:ring-0"
                      />
                      {label}
                    </label>
                  </div>

                  <.input
                    :if={@identifier_source == :typed}
                    field={filter[:identifiers]}
                    label="Device identifiers"
                    hide_label={true}
                    type="textarea"
                    rows="8"
                    phx-debounce="2000"
                    hint="One per line, or separated by commas."
                  />

                  <div :if={@identifier_source == :csv} class="flex flex-col gap-2">
                    <%!-- Not wrapped in its own form: nested forms are invalid HTML,
                          and the file input's change event reaches the form above,
                          which is enough for an `auto_upload`. --%>
                    <div :if={@csv_identifiers == []} class="flex flex-col gap-2">
                      <label
                        for={@uploads.identifiers_csv.ref}
                        class="bg-base-800 border-base-700 hover:bg-base-700 text-base-300 flex w-fit cursor-pointer items-center gap-1.5 rounded border px-3 py-1.5 text-sm"
                      >
                        <.icon name="add" class="stroke-base-400" /> Choose a CSV file
                      </label>
                      <.live_file_input upload={@uploads.identifiers_csv} class="hidden" />
                      <div class="text-base-400 text-xs">
                        A single column, named <span class="font-mono">identifier</span>.
                      </div>
                    </div>

                    <div :if={@csv_identifiers != []} class="bg-base-800 border-base-700 flex items-center justify-between gap-2 rounded border px-3 py-2">
                      <span class="text-base-300 text-sm">
                        {@csv_filename} — {length(@csv_identifiers)} {identifiers(length(@csv_identifiers))}
                      </span>
                      <.button type="button" style="secondary" phx-click="remove-csv" aria-label="Remove the uploaded CSV">
                        Remove
                      </.button>
                    </div>
                  </div>
                </div>

                <.input
                  :if={@filter_type == :deployment_groups}
                  field={filter[:deployment_group_ids]}
                  label="Deployment groups"
                  type="select"
                  multiple={true}
                  options={Enum.map(@deployment_groups, &{&1.name, &1.id})}
                  hint="Every device in the selected groups is targeted."
                />
              </.inputs_for>

              <div :if={is_nil(@filter_type)} class="text-base-400 text-sm">
                Pick a filter to choose which devices this runs on.
              </div>

              <%!-- Errors about the filter as a whole, which belong to no single
                    field inside it. --%>
              <.error :for={message <- filter_errors(@form)}>{message}</.error>
            </div>
          </div>
          <div class="border-base-700 flex h-14 items-center justify-between border-t px-4">
            <.button style="primary" type="submit">
              <.icon name="save" /> Run script
            </.button>
          </div>
        </div>
      </.form>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
