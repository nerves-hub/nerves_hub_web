<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-base-50 text-xl leading-[30px] font-semibold">All Script Runs</h1>
    <div class="bg-base-800 text-base-300 mr-auto rounded-sm px-1.5 py-0.5 text-xs">
      {@pager_meta.total_count}
    </div>

    <form id="script-run-filters-form" class="flex items-center" phx-change="update-filters">
      <div class="grid grid-cols-1">
        <input
          type="text"
          class="bg-surface-muted border-base-600 text-base-400 col-start-1 row-start-1 block h-9 w-64 gap-2 rounded border px-3 py-1 text-sm font-normal"
          name="search"
          id="script_run_search_top"
          placeholder="Search by name or script contents..."
          title="Search"
          value={@current_filters[:search]}
          phx-debounce="500"
        />

        <svg class="pointer-events-none col-start-1 row-start-1 mr-3 self-center justify-self-end" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path
            d="M16.6668 16.6666L13.2916 13.2914M13.2916 13.2914C14.3472 12.2358 15.0002 10.7775 15.0002 9.16665C15.0002 5.94499 12.3885 3.33331 9.16683 3.33331C5.94517 3.33331 3.3335 5.94499 3.3335 9.16665C3.3335 12.3883 5.94517 15 9.16683 15C10.7777 15 12.236 14.3471 13.2916 13.2914Z"
            stroke="#A1A1AA"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    </form>

    <.button type="link" navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts/runs/new"} aria-label="Run a script on many devices">
      <.icon name="add" />Run a Script
    </.button>
  </:header>

  <%!-- Separate LiveViews rather than actions of one, so these navigate. --%>
  <:tabbed_nav path={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts"} selected={@tab == :scripts} navigate={true} label="Support Scripts" />
  <:tabbed_nav path={~p"/org/#{@current_scope.org}/#{@current_scope.product}/scripts/runs"} selected={@tab == :runs} navigate={true} label="Script Runs" />

  <div class="h-0 flex-1 overflow-y-auto">
    <div :if={Enum.any?(@script_runs)} class="listing">
      <table>
        <thead>
          <tr>
            <th phx-click="sort" phx-value-sort="name" class="cursor-pointer">
              <Sorting.sort_icon text="Name" field="name" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th phx-click="sort" phx-value-sort="inserted_at" class="cursor-pointer">
              <Sorting.sort_icon text={"Started (#{zone_abbr(@time_zone)})"} field="inserted_at" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th phx-click="sort" phx-value-sort="status" class="cursor-pointer">
              <Sorting.sort_icon text="Status" field="status" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th phx-click="sort" phx-value-sort="device_count" class="cursor-pointer">
              <Sorting.sort_icon text="Devices" field="device_count" selected_field={@current_sort} selected_direction={@sort_direction} />
            </th>
            <th>
              Targeted by
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={run <- @script_runs} class="border-base-800 border-b">
            <td class="h-[52px]">
              {run.name}
            </td>
            <td>
              <.local_datetime at={run.inserted_at} time_zone={@time_zone} zone_label={false} />
            </td>
            <td>
              <span class="tag">{run.status}</span>
            </td>
            <td>
              {run.device_count}
            </td>
            <td>
              {ScriptRunner.filter_type_label(run.filter_type)}
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div :if={Enum.empty?(@script_runs) && @currently_filtering} class="flex h-full items-center justify-center pb-16">
      <span class="text-base-50 text-xl font-medium">No Script Runs match the current filters.</span>
    </div>

    <div :if={Enum.empty?(@script_runs) && !@currently_filtering} class="flex h-full items-center justify-center pb-16">
      <span class="text-content-muted font-mono text-xl font-medium">{@current_scope.product.name} doesn’t have any Script Runs yet.</span>
    </div>
  </div>

  <:pagination pager={@pager_meta} page_sizes={[25, 50, 100]} />
</NervesHubWeb.Layouts.sidebar>
