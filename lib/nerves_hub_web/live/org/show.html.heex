<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-page-title text-content-strong">Products</h1>
    <div class="mr-auto"></div>
    <.button type="link" navigate={~p"/org/#{@org}/new"} aria-label="Create new product">
      <.icon name="add" /> Create New
    </.button>
  </:header>

  <div class="grid grid-cols-2 gap-4 p-4">
    <div :if={@products == []}>
      <div class="m-4">
        <h2 class="text-page-title text-content-strong">{@org.name} doesn't have any products yet</h2>
        <p class="text-sm text-content-muted">Create a new product to get started.</p>
      </div>
    </div>
    <div :for={product <- @products} class="flex w-full justify-between gap-[16px] rounded-md border border-line-default bg-linear-to-r from-base-800/50 to-base-800 p-4">
      <div class="text-sm font-semibold text-content-strong">
        <.link navigate={~p"/org/#{@org}/#{product}/insights"}>{product.name}</.link>
      </div>
      <% product_counts = Map.get(assigns, :"product_counts_#{product.id}") %>
      <% {connected, disconnected} =
        if product_counts && product_counts.ok?,
          do: product_counts.result,
          else: {nil, nil} %>
      <div class="flex gap-4 text-sm font-medium">
        <div class="flex items-center gap-1.5">
          <.status_dot class="bg-status-online" />
          <span class="product-connected-devices-count text-content-body">{if connected, do: connected, else: "—"}</span>
        </div>
        <div class="flex items-center gap-1.5">
          <.status_dot class="bg-status-offline" />
          <span class="product-disconnected-devices-count text-content-muted">{if disconnected, do: disconnected, else: "—"}</span>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
