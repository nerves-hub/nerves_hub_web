<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-base-50 text-xl leading-[30px] font-semibold">Users</h1>
    <div class="mr-auto"></div>
    <.button type="link" navigate={~p"/org/#{@org}/settings/users/invite"} aria-label="Add new user">
      <.icon name="add" /> Add New User
    </.button>
  </:header>

  <h2 :if={Enum.any?(@invites)} class="text-base-50 px-4 py-2 text-base font-semibold">Outstanding Invites</h2>
  <div :if={Enum.any?(@invites)} class="listing grow-0! pb-10">
    <table>
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>Invited by</th>
          <th class="w-px"></th>
        </tr>
      </thead>
      <tbody>
        <%= for invite <- @invites do %>
          <tr class="border-base-800 isolate border-b">
            <td class="text-base-400">{invite.email}</td>
            <td class="text-base-400 capitalize">{invite.role}</td>
            <td class="text-base-400">{invited_by_name(invite)}</td>
            <td class="w-px text-right whitespace-nowrap">
              <div class="flex justify-end gap-2">
                <.button
                  id={"copy-invite-#{invite.id}"}
                  style="secondary"
                  type="button"
                  phx-hook="CopyToClipboard"
                  data-copy-value={authorized?(:"org_user:invite:resend", @current_scope) && invite_url(invite)}
                  disabled={!authorized?(:"org_user:invite:resend", @current_scope)}
                  title={invite_action_title(authorized?(:"org_user:invite:resend", @current_scope), "Copy the invite link")}
                >
                  <span data-icon="copy" class="lucide-copy--light size-4"></span>
                  <span data-icon="check" class="lucide-check--light text-success hidden size-4"></span> Copy invite link
                </.button>
                <.button
                  style="secondary"
                  type="button"
                  phx-click="resend_invite"
                  phx-value-invite_token={authorized?(:"org_user:invite:resend", @current_scope) && invite.token}
                  disabled={!authorized?(:"org_user:invite:resend", @current_scope)}
                  title={invite_action_title(authorized?(:"org_user:invite:resend", @current_scope), "Send the invitation email again")}
                  data-confirm={"Resend the invitation to #{invite.email}? This sends a new link and stops the previous one working."}
                >
                  <span class="lucide-mail--light size-4"></span> Resend invite
                </.button>
                <.button
                  style="danger"
                  type="button"
                  phx-click="rescind_invite"
                  phx-value-invite_token={authorized?(:"org_user:invite:rescind", @current_scope) && invite.token}
                  disabled={!authorized?(:"org_user:invite:rescind", @current_scope)}
                  title={invite_action_title(authorized?(:"org_user:invite:rescind", @current_scope), "Withdraw the invitation")}
                  data-confirm="Are you sure you want to rescind the invite?"
                >
                  Rescind
                </.button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <h2 :if={Enum.any?(@invites)} class="text-base-50 px-4 py-2 text-base font-semibold">Active Memberships</h2>
  <div class="listing">
    <table>
      <thead>
        <tr>
          <th>User name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Added on</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%= for org_user <- @org_users do %>
          <tr class="border-base-800 isolate border-b">
            <td>
              <.link navigate={~p"/org/#{@org}/settings/users/#{org_user.user_id}/edit"} class="hover:text-base-100 text-base-300">
                {org_user.user.name}
              </.link>
            </td>
            <td>{org_user.user.email}</td>
            <td class="text-base-400 capitalize">{org_user.role}</td>
            <td class="text-base-400">
              <div><.local_datetime at={org_user.user.inserted_at} time_zone={@time_zone} format={:long_date} zone_label={false} /></div>
            </td>
            <td class="text-right">
              <div class="flex justify-end gap-2">
                <.link
                  :if={authorized?(:"org_user:update", @current_scope) && org_user.user.id != @current_scope.user.id}
                  navigate={~p"/org/#{@org}/settings/users/#{org_user.user_id}/edit"}
                  class="bg-base-800 border-base-700 hover:bg-base-700 text-base-300 rounded border px-3 py-1.5 text-sm font-medium"
                >
                  Edit Role
                </.link>
                <button
                  :if={can_remove?(org_user, @current_scope, @admin_count)}
                  id={"remove-user-#{org_user.user_id}"}
                  type="link"
                  class="bg-base-800 border-alert hover:bg-base-700 text-alert cursor-pointer rounded border px-3 py-1.5 text-sm font-medium"
                  phx-click="delete_org_user"
                  phx-value-user_id={org_user.user_id}
                  data-confirm={remove_user_message(org_user, @current_scope)}
                >
                  Remove
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</NervesHubWeb.Layouts.sidebar>
