<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">{@membership.user.name}</h1>
  </:header>

  <div class="max-w-[650px] px-6 py-4">
    <.form :let={f} id="edit-user-form" for={@form} phx-submit="update-org-user">
      <div class="mb-6">
        <label for="role_input" class="mb-2 block text-sm font-medium text-base-300">Role</label>
        <select id="role_input" name={f[:role].name} class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none">
          {Phoenix.HTML.Form.options_for_select(Utils.role_options(), f[:role].value)}
        </select>
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:role]} /></div>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Update
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/users"}>
          Cancel
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.sidebar>
