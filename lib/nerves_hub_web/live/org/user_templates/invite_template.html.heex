<NervesHubWeb.Layouts.org flash={@flash} current_scope={@current_scope} tab={@sidebar_tab} counts={@org_counts}>
  <NervesHubWeb.Layouts.org_heading title="Add New User" back={~p"/org/#{@org}/settings/users"} />

  <div class="max-w-[650px]">
    <p class="mb-6 text-sm text-content-muted">An invitation will be sent to join {@org.name}. Invites expire in 48 hours.</p>

    <.form :let={f} id="invite-form" for={@form} phx-submit="send_invite">
      <%= if f.action do %>
        <div class="mb-4 rounded-md border border-alert bg-alert-soft p-4 text-sm text-alert-content">
          <p>Something went wrong, please check the errors below.</p>
        </div>
      <% end %>

      <div class="mb-4">
        <label for="email_input" class="mb-2 block text-sm font-medium text-content-body">Email</label>
        <input
          type="email"
          id="email_input"
          name={f[:email].name}
          value={assigns[:email]}
          class="w-full rounded border border-line-default bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
        />
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:email]} /></div>
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:org_users]} /></div>
      </div>

      <div class="mb-6">
        <label for="role_input" class="mb-2 block text-sm font-medium text-content-body">
          Role <span class="ml-2 text-xs text-content-faint">(Defines the type of access this user has in this org)</span>
        </label>
        <select
          id={f[:role].id}
          name={f[:role].name}
          class="w-full rounded border border-line-default bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
        >
          {Phoenix.HTML.Form.options_for_select(Utils.role_options(), f.params["role"] || :view)}
        </select>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Send Invitation
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/users"}>
          Cancel
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.org>
