<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">Add New User</h1>
  </:header>

  <div class="max-w-[650px] px-6 py-4">
    <p class="mb-6 text-sm text-base-400">An invitation will be sent to join {@org.name}. Invites expire in 48 hours.</p>

    <.form :let={f} id="invite-form" for={@form} phx-submit="send_invite">
      <%= if f.action do %>
        <div class="mb-4 rounded border border-alert bg-alert-soft p-4 text-sm text-alert-content">
          <p>Something went wrong, please check the errors below.</p>
        </div>
      <% end %>

      <div class="mb-4">
        <label for="email_input" class="mb-2 block text-sm font-medium text-base-300">Email</label>
        <input
          type="email"
          id="email_input"
          name={f[:email].name}
          value={assigns[:email]}
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none"
        />
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:email]} /></div>
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:org_users]} /></div>
      </div>

      <div class="mb-6">
        <label for="role_input" class="mb-2 block text-sm font-medium text-base-300">
          Role <span class="ml-2 text-xs text-base-500">(Defines the type of access this user has in this org)</span>
        </label>
        <select id={f[:role].id} name={f[:role].name} class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none">
          {Phoenix.HTML.Form.options_for_select(Utils.role_options(), f.params["role"] || :view)}
        </select>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Send Invitation
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/users"}>
          Cancel
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.sidebar>
