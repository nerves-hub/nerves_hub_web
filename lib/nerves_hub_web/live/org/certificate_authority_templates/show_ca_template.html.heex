<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.breadcrumb navigate={~p"/org/#{@org}/settings/certificates"} root_label="All Certificate Authorities" root_class="hidden whitespace-nowrap md:block">
      <:crumb class="hidden lg:block">{CAHelpers.label(@certificate)}</:crumb>
    </.breadcrumb>
  </:top_bar>

  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-content-strong">{CAHelpers.label(@certificate)}</h1>
    <div class="mr-auto"></div>
    <.button :if={authorized?(:"certificate_authority:update", @current_scope)} type="link" navigate={~p"/org/#{@org}/settings/certificates/#{@certificate}/edit"}>
      Edit
    </.button>
    <.button
      :if={authorized?(:"certificate_authority:delete", @current_scope)}
      style="danger"
      type="button"
      phx-click="delete-certificate-authority"
      phx-value-certificate_serial={@certificate.serial}
      data-confirm="Are you sure you want to delete this certificate? This can not be undone."
    >
      Delete
    </.button>
  </:header>

  <div class="h-0 max-w-[650px] flex-1 flex-col gap-6 overflow-y-auto px-6 py-4">
    <div class="flex flex-col rounded-md border border-line-default bg-surface-raised">
      <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
        <div class="text-base font-medium text-content-strong">Certificate Authority</div>
        <CAHelpers.certificate_status not_before={@certificate.not_before} not_after={@certificate.not_after} />
      </div>
      <dl class="flex flex-col gap-3 p-4 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Serial</dt>
          <dd>
            <.tag mono class="break-all">{Utils.format_serial(@certificate.serial)}</.tag>
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Description</dt>
          <dd class="text-content-body">{@certificate.description || "-"}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Last used</dt>
          <dd class="text-content-body">
            {if @certificate.last_used, do: DateTimes.from_now(@certificate.last_used), else: "Never"}
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Not before</dt>
          <dd class="text-content-body">
            <div phx-hook="SimpleDate" id="ca-not-before" class="date-time">{@certificate.not_before}</div>
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Not after</dt>
          <dd class="text-content-body">
            <div phx-hook="SimpleDate" id="ca-not-after" class="date-time">{@certificate.not_after}</div>
          </dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt class="flex items-center gap-2 text-content-muted">
            Check expiration <CAHelpers.check_expiration_tooltip />
          </dt>
          <dd class="text-content-body">{if @certificate.check_expiration, do: "Yes", else: "No"}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-content-muted">Just In Time Provisioning</dt>
          <dd class="text-content-body">
            {if @certificate.jitp, do: "Enabled for #{@certificate.jitp.product.name}", else: "Disabled"}
          </dd>
        </div>
      </dl>
    </div>

    <div id="ca-devices" class="flex flex-col rounded-md border border-line-default bg-surface-raised">
      <div class="flex h-14 items-center gap-2 border-b border-line-default px-4">
        <div class="text-base font-medium text-content-strong">Devices</div>
        <.badge>
          {Number.Delimit.number_to_delimited(@device_count, precision: 0)}
        </.badge>
      </div>
      <div class="flex flex-col px-4 py-3">
        <div :if={@device_counts == []} class="text-sm text-content-muted">
          No devices are using a certificate signed by this Certificate Authority.
        </div>
        <.link
          :for={%{product: product, device_count: device_count} <- @device_counts}
          navigate={~p"/org/#{@org}/#{product}/devices?#{[signer_ca: @certificate.serial]}"}
          class="-mx-2 flex items-center justify-between gap-4 rounded px-2 py-1.5 hover:bg-base-800"
        >
          <span class="text-sm text-content-body">{product.name}</span>
          <span class="text-sm text-content-muted">{Number.Delimit.number_to_delimited(device_count, precision: 0)}</span>
        </.link>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
