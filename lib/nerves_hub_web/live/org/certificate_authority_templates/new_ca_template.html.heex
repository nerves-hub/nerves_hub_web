<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">New Certificate Authority</h1>
  </:header>

  <div class="max-w-[900px] px-6 py-4">
    <.form :let={f} id="new-ca-form" for={@form} phx-submit="add_certificate_authority" phx-change="validate_new_certificate_authority">
      <div :if={f.action && !Keyword.has_key?(f.errors, :serial)} class="mb-4 rounded border border-alert bg-alert-soft p-4 text-sm text-alert-content">
        <p>Something went wrong! Please check the errors below.</p>
      </div>

      <div :if={Keyword.has_key?(f.errors, :serial)} class="mb-4 rounded border border-alert bg-alert-soft p-4 text-sm text-alert-content">
        <p>A Certificate Authority with the same Serial already exists.</p>
      </div>

      <div class="mb-6">
        <h3 class="mb-2 text-base font-semibold text-base-50">Step 1</h3>
        <p class="text-sm text-base-400">Generate a CA Certificate pair (you can skip this if you already have one)</p>
        <p class="mb-2 text-sm text-base-400 italic">Save the generated `rootCA.key` and `rootCA.crt` files for later use.</p>
        <pre class="overflow-x-auto rounded border border-base-700 bg-base-900 p-3"><code class="text-xs text-base-300" phx-hook="HighlightCode" id="step-1">$ openssl genrsa -out rootCA.key 4096

$ openssl req -new -x509 -key rootCA.key -sha256 -days 3650 \
    -subj "/CN=Root CA/O=Org Name" \
    -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -addext "subjectKeyIdentifier=hash" \
    -out rootCA.crt</code></pre>
      </div>

      <div class="mb-6">
        <h3 class="mb-2 text-base font-semibold text-base-50">Step 2</h3>
        <p class="mb-2 text-sm text-base-400">Generate a key pair for the private key verification certificate</p>
        <pre class="overflow-x-auto rounded border border-base-700 bg-base-900 p-3"><code class="text-xs text-base-300" phx-hook="HighlightCode" id="step-2">$ openssl genrsa -out verificationCert.key 4096</code></pre>
      </div>

      <div class="mb-6">
        <h3 class="mb-2 text-base font-semibold text-base-50">Step 3</h3>
        <p class="mb-2 text-sm text-base-400">Create a CSR with the generated registration code in the <strong>Subject Alternative Name (SAN)</strong> field</p>
        <pre class="overflow-x-auto rounded border border-base-700 bg-base-900 p-3"><code class="text-xs text-base-300" phx-hook="HighlightCode" id="step-3">$ openssl req -new -key verificationCert.key -out verificationCert.csr \
    -subj "/CN=certificate-verification"
    -addext "subjectAltName=URI:urn:nerveshub:verify:{@registration_code}"</code></pre>
      </div>

      <div class="mb-6">
        <h3 class="mb-2 text-base font-semibold text-base-50">Step 4</h3>
        <p class="mb-2 text-sm text-base-400">Use the CSR that was signed with the CA private key to create a private key verification certificate</p>
        <pre class="overflow-x-auto rounded border border-base-700 bg-base-900 p-3"><code class="text-xs text-base-300" phx-hook="HighlightCode" id="step-4">$ openssl x509 -req -in verificationCert.csr \
    -CA rootCA.crt -CAkey rootCA.key -CAcreateserial \
    -days 365 -sha256 \
    -copy_extensions copy \
    -out verificationCert.crt</code></pre>
      </div>

      <div class="mb-6 border-t border-base-700 pt-6">
        <div class="mb-4">
          <label for="description_input" class="mb-2 block text-sm font-medium text-base-300">Description</label>
          {text_input(f, :description,
            class: "w-full px-3 py-2 text-sm bg-base-900 border border-base-700 rounded text-base-50 focus:outline-none focus:ring-2 focus:ring-focus-ring",
            id: "description_input"
          )}
          <div class="mt-1 text-sm text-alert-content">{error_tag(f, :description)}</div>
        </div>

        <div class="mb-4 flex items-center gap-2">
          {checkbox(f, :check_expiration, class: "rounded border-base-700 text-base-400 checked:bg-primary focus:ring-0", id: "check_expiration_input")}
          <label for="check_expiration_input" class="text-sm text-base-300">Check expiration</label>
          <CAHelpers.check_expiration_tooltip />
          <div class="text-sm text-alert-content">{error_tag(f, :check_expiration)}</div>
        </div>

        <%= inputs_for f, :jitp, fn fp -> %>
          <div class="mb-4">
            <div class="mb-4 flex items-center gap-2">
              <input id="jitp_toggle" type="hidden" name="ca_certificate[jitp][jitp_toggle]" value="false" checked={@show_jitp_form} />
              <input
                id="jitp_toggle_ui"
                type="checkbox"
                name="ca_certificate[jitp][jitp_toggle]"
                value="true"
                checked={@show_jitp_form}
                phx-click={JS.dispatch("ca:new:jitp")}
                class="rounded border-base-700 text-base-400 checked:bg-primary focus:ring-0"
              />
              <label for="jitp_toggle_ui" class="text-sm text-base-300">Enable Just In Time Provisioning</label>
            </div>

            <div class={if !@show_jitp_form, do: "hidden"} id="jitp_form">
              <div class="mb-4">
                <label for="jitp_description_input" class="mb-2 block text-sm font-medium text-base-300">
                  JITP Description <span class="ml-2 text-xs text-base-500">(Device Description)</span>
                </label>
                {text_input(fp, :description,
                  class: "w-full px-3 py-2 text-sm bg-base-900 border border-base-700 rounded text-base-50 focus:outline-none focus:ring-2 focus:ring-focus-ring",
                  id: "jitp_description_input"
                )}
                <div class="mt-1 text-sm text-alert-content">{error_tag(fp, :description)}</div>
              </div>

              <div class="mb-4">
                <label for="tag_input" class="mb-2 block text-sm font-medium text-base-300">
                  JITP Tags <span class="ml-2 text-xs text-base-500">(Tags are used by deployments to target a device)</span>
                </label>
                {text_input(fp, :tags,
                  class: "w-full px-3 py-2 text-sm bg-base-900 border border-base-700 rounded text-base-50 focus:outline-none focus:ring-2 focus:ring-focus-ring",
                  id: "tag_input"
                )}
                <div class="mt-1 text-sm text-alert-content">{error_tag(fp, :tags)}</div>
              </div>

              <div class="mb-4">
                <label for="product_input" class="mb-2 block text-sm font-medium text-base-300">
                  JITP Product <span class="ml-2 text-xs text-base-500">(JITP must be configured to use a particular product)</span>
                </label>
                {select(fp, :product_id, Enum.map(@products, &{&1.name, &1.id}),
                  class: "w-full px-3 py-2 text-sm bg-base-900 border border-base-700 rounded text-base-50 focus:outline-none focus:ring-2 focus:ring-focus-ring",
                  id: "product_input",
                  prompt: "Select Product"
                )}
                <div class="mt-1 text-sm text-alert-content">{error_tag(fp, :product_id)}</div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="mb-4">
          <%= if Enum.any?(@uploads.cert.entries) do %>
            <label class="mb-2 block text-sm font-medium text-base-300" for={@uploads.cert.ref}>
              Selected Certificate File: <span class="text-base-400">{Enum.map(@uploads.cert.entries, fn e -> e.client_name end)}</span>
            </label>
          <% else %>
            <label class="mb-2 block text-sm font-medium text-base-300" for={@uploads.cert.ref}>Upload a Certificate Authority file (rootCA.crt)</label>
          <% end %>
          <.live_file_input
            upload={@uploads.cert}
            required
            class="block w-full text-sm text-base-400 file:mr-4 file:rounded file:border-0 file:bg-base-800 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-base-300 hover:file:bg-base-700"
          />
          <%= for entry <- @uploads.cert.entries do %>
            <div :for={err <- upload_errors(@uploads.cert, entry)} class="mt-1 text-sm text-alert-content">
              {upload_error_to_string(err)}
            </div>
          <% end %>
        </div>

        <div class="mb-6">
          <%= if Enum.any?(@uploads.csr.entries) do %>
            <label class="mb-2 block text-sm font-medium text-base-300" for={@uploads.csr.ref}>
              Selected CSR File: <span class="text-base-400">{Enum.map(@uploads.csr.entries, fn e -> e.client_name end)}</span>
            </label>
          <% else %>
            <label class="mb-2 block text-sm font-medium text-base-300" for={@uploads.csr.ref}>Upload a signed Certificate used for ownership verification (verificationCert.crt)</label>
          <% end %>
          <.live_file_input
            upload={@uploads.csr}
            required
            class="block w-full text-sm text-base-400 file:mr-4 file:rounded file:border-0 file:bg-base-800 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-base-300 hover:file:bg-base-700"
          />
          <%= for entry <- @uploads.csr.entries do %>
            <div :for={err <- upload_errors(@uploads.csr, entry)} class="mt-1 text-sm text-alert-content">
              {upload_error_to_string(err)}
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Create Certificate
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/certificates"}>
          Cancel
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.sidebar>
