<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-page-title text-content-strong">Certificate Authorities</h1>
    <div class="mr-auto"></div>
    <.button type="link" navigate={~p"/org/#{@org}/settings/certificates/new"} aria-label="Add certificate authority">
      <.icon name="add" /> Add Certificate Authority
    </.button>
  </:header>

  <div class="listing h-0 flex-1 overflow-y-auto">
    <table>
      <thead>
        <tr>
          <th>Serial</th>
          <th>Description</th>
          <th>Devices</th>
          <th>Last used</th>
          <th>Not before</th>
          <th>Not after</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <%= for cert <- @certificates do %>
          <tr class="isolate border-b border-line-subtle">
            <td>
              <.link navigate={~p"/org/#{@org}/settings/certificates/#{cert}"}>
                <.tag mono class="break-all hover:text-content-strong">{Utils.format_serial(cert.serial)}</.tag>
              </.link>
            </td>
            <td>
              <%= if is_nil(cert.description) do %>
                <span class="text-content-muted">-</span>
              <% else %>
                {cert.description}
              <% end %>
            </td>
            <td id={"ca-#{cert.id}-device-count"} class="text-content-muted">
              {Number.Delimit.number_to_delimited(Map.get(@device_counts, cert.ski, 0), precision: 0)}
            </td>
            <td class="text-content-muted">
              <%= if !is_nil(cert.last_used) do %>
                {DateTimes.from_now(cert.last_used)}
              <% else %>
                <span class="text-content-muted">Never</span>
              <% end %>
            </td>
            <td class="text-content-muted">
              <div><.local_datetime at={cert.not_before} time_zone={@time_zone} format={:long_date} zone_label={false} /></div>
            </td>
            <td class="text-content-muted">
              <div><.local_datetime at={cert.not_after} time_zone={@time_zone} format={:long_date} zone_label={false} /></div>
            </td>
            <td>
              <CAHelpers.certificate_status not_before={cert.not_before} not_after={cert.not_after} />
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</NervesHubWeb.Layouts.sidebar>
