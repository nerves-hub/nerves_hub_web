<NervesHubWeb.Layouts.org flash={@flash} current_scope={@current_scope} tab={@sidebar_tab} counts={@org_counts}>
  <NervesHubWeb.Layouts.org_heading title="Edit Certificate Authority" back={~p"/org/#{@org}/settings/certificates/#{@serial}"} />

  <div class="max-w-[650px]">
    <.form :let={f} id="edit-ca-form" for={@form} phx-submit="update_certificate_authority">
      <div class="mb-4">
        <label for="description_input" class="mb-2 block text-sm font-medium text-content-body">Description</label>
        <input
          type="text"
          id="description_input"
          name={f[:description].name}
          value={f[:description].value}
          class="w-full rounded border border-line-strong bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
        />
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:description]} /></div>
      </div>

      <div class="mb-4 flex items-center gap-2">
        <input type="hidden" name={f[:check_expiration].name} value="false" />
        <input
          type="checkbox"
          id="check_expiration_input"
          name={f[:check_expiration].name}
          value="true"
          checked={Phoenix.HTML.Form.normalize_value("checkbox", f[:check_expiration].value)}
          class="size-4 rounded border-line-strong bg-base-900"
        />
        <label for="check_expiration_input" class="text-sm text-content-body">Check expiration</label>
        <CAHelpers.check_expiration_tooltip />
        <div class="text-sm text-alert-content"><.field_errors field={f[:check_expiration]} /></div>
      </div>

      <.inputs_for :let={fp} field={f[:jitp]} skip_persistent_id>
        <div class="mb-6">
          <div class="mb-4 flex items-center gap-2">
            <input type="hidden" id="jitp-delete" name={fp[:delete].name} value={fp[:delete].value} />
            <input
              id="jitp_toggle_ui"
              type="checkbox"
              value="true"
              name="ca_certificate[jitp][jitp_toggle]"
              checked={@show_jitp_form}
              phx-click={JS.dispatch("ca:edit:jitp")}
              class="rounded border-line-strong text-content-muted checked:bg-primary focus:ring-0"
            />
            <label for="jitp_toggle_ui" class="text-sm text-content-body">Enable Just In Time Provisioning</label>
          </div>

          <div class={if !@show_jitp_form, do: "hidden"} id="jitp_form">
            <div class="mb-4">
              <label for="jitp_description_input" class="mb-2 block text-sm font-medium text-content-body">
                JITP Description <span class="ml-2 text-xs text-content-faint">(Device Description)</span>
              </label>
              <input
                type="text"
                id="jitp_description_input"
                name={fp[:description].name}
                value={fp[:description].value}
                class="w-full rounded border border-line-strong bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
              />
              <div class="mt-1 text-sm text-alert-content"><.field_errors field={fp[:description]} /></div>
            </div>

            <div class="mb-4">
              <label for="tag_input" class="mb-2 block text-sm font-medium text-content-body">
                JITP Tags <span class="ml-2 text-xs text-content-faint">(Tags are used by deployments to target a device)</span>
              </label>
              <input
                type="text"
                id="tag_input"
                name={fp[:tags].name}
                value={Utils.tags_to_string(fp[:tags].value)}
                class="w-full rounded border border-line-strong bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
              />
              <div class="mt-1 text-sm text-alert-content"><.field_errors field={fp[:tags]} /></div>
            </div>

            <div class="mb-4">
              <label for="product_input" class="mb-2 block text-sm font-medium text-content-body">
                JITP Product <span class="ml-2 text-xs text-content-faint">(JITP must be configured to use a particular product)</span>
              </label>
              <select
                id="product_input"
                name={fp[:product_id].name}
                class="w-full rounded border border-line-strong bg-base-900 px-3 py-2 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none"
              >
                <option value="">Select Product</option>
                {Phoenix.HTML.Form.options_for_select(Enum.map(@products, &{&1.name, &1.id}), fp[:product_id].value)}
              </select>
              <div class="mt-1 text-sm text-alert-content"><.field_errors field={fp[:product_id]} /></div>
            </div>
          </div>
        </div>
      </.inputs_for>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Update Certificate
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/certificates/#{@serial}"}>
          Cancel
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.org>
