<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-base-50 text-xl leading-[30px] font-semibold">Roles</h1>
    <div class="mr-auto"></div>
    <.button :if={authorized?(:"org_role:create", @current_scope)} type="link" navigate={~p"/org/#{@org}/settings/roles/new"} aria-label="Add new role">
      <.icon name="add" /> Add Role
    </.button>
  </:header>

  <p class="text-base-400 px-4 py-2 text-sm">
    A member's role decides what they can change in {@org.name}. Every member can view its products, devices and settings.
  </p>

  <div class="listing">
    <table>
      <thead>
        <tr>
          <th>Role</th>
          <th>Description</th>
          <th>Members</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={role <- Permissions.built_in_roles()} id={"role-#{role}"} class="border-base-800 isolate border-b">
          <td>
            <.link navigate={role_path(@org, role)} class="hover:text-base-100 text-base-300">
              {Utils.role_name(role)}
            </.link>
            <span class="bg-base-800 border-base-700 text-base-400 ml-2 rounded-full border px-2 py-0.5 text-xs">Built-in</span>
          </td>
          <td class="text-base-400">{built_in_description(role)}</td>
          <td class="text-base-400">{member_count(@member_counts, role)}</td>
          <td></td>
        </tr>
        <tr :for={role <- @custom_roles} id={"role-#{role.id}"} class="border-base-800 isolate border-b">
          <td>
            <.link navigate={role_path(@org, role)} class="hover:text-base-100 text-base-300">
              {role.name}
            </.link>
          </td>
          <td class="text-base-400">{role.description}</td>
          <td class="text-base-400">{member_count(@member_counts, role)}</td>
          <td class="text-right">
            <div class="flex justify-end gap-2">
              <.link
                :if={authorized?(:"org_role:update", @current_scope)}
                navigate={~p"/org/#{@org}/settings/roles/#{role.id}/edit"}
                class="bg-base-800 border-base-700 hover:bg-base-700 text-base-300 rounded border px-3 py-1.5 text-sm font-medium"
              >
                Edit
              </.link>
              <button
                :if={authorized?(:"org_role:delete", @current_scope)}
                id={"delete-role-#{role.id}"}
                type="button"
                class="bg-base-800 border-alert hover:bg-base-700 text-alert cursor-pointer rounded border px-3 py-1.5 text-sm font-medium"
                phx-click="delete"
                phx-value-role_id={role.id}
                data-confirm={"Delete the #{role.name} role? This can not be undone."}
              >
                Delete
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</NervesHubWeb.Layouts.sidebar>
