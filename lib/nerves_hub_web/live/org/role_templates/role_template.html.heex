<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-base-50 text-xl leading-[30px] font-semibold">{Utils.role_name(@role)}</h1>
    <span :if={is_atom(@role)} class="bg-base-800 border-base-700 text-base-400 rounded-full border px-2 py-0.5 text-xs">Built-in</span>
    <div class="mr-auto"></div>
    <.button :if={is_struct(@role, OrgRole) && authorized?(:"org_role:update", @current_scope)} type="link" navigate={~p"/org/#{@org}/settings/roles/#{@role.id}/edit"}>
      <span class="lucide-pencil--light size-4"></span> Edit Role
    </.button>
  </:header>

  <div class="h-0 max-w-[750px] flex-1 overflow-y-auto px-6 py-4">
    <p class="text-base-400 mb-6 text-sm">
      {if is_atom(@role), do: built_in_description(@role), else: @role.description}
    </p>
    <p :if={device_scope_label(@role)} id="device-scope" class="text-base-300 mb-6 text-sm">
      {device_scope_label(@role)}.
    </p>

    <div :for={{group, permissions} <- Permissions.grouped()} class="mb-6">
      <h2 class="text-base-50 mb-2 text-sm font-semibold">{group}</h2>
      <ul class="border-base-800 divide-base-800 divide-y rounded border">
        <li :for={permission <- permissions} id={"permission-#{permission.name}"} class="flex items-center gap-3 px-3 py-2 text-sm">
          <span :if={permission.name in @granted} class="lucide-check--light text-success size-4 shrink-0" aria-label="Granted"></span>
          <span :if={permission.name not in @granted} class="lucide-minus--light text-base-600 size-4 shrink-0" aria-label="Not granted"></span>
          <span class={if permission.name in @granted, do: "text-base-200", else: "text-base-500"}>{permission.description}</span>
          <span :if={permission.custom_roles == :never && is_struct(@role, OrgRole)} class="text-base-500 ml-auto text-xs">Admin only</span>
        </li>
      </ul>
    </div>

    <.button style="secondary" type="link" navigate={~p"/org/#{@org}/settings/roles"}>
      Back to Roles
    </.button>
  </div>
</NervesHubWeb.Layouts.sidebar>
