<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">Iroh Endpoints</h1>
    <div class="mr-auto"></div>
    <.button
      :if={authorized?(:"network_identity:create", @current_scope)}
      type="button"
      phx-click="toggle-registration"
      aria-label="Register an endpoint"
    >
      <.icon name="add" /> Register Endpoint
    </.button>
  </:header>

  <div class="px-6 py-4">
    <p class="mb-4 text-sm text-base-400">
      Endpoint ids your devices and people use to reach each other over iroh. A device records its
      own when it connects; anything else is registered here.
    </p>

    <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-500">
      <a
        :for={{label, url} <- @links}
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:text-base-300"
      >
        {label}
      </a>
    </div>

    <div :if={@registering} class="mb-6 rounded border border-base-700 bg-base-800/50 p-4">
      <.form :let={f} id="register_identity" for={@form} phx-submit="register" class="space-y-4">
        <div>
          <.input field={f[:identifier]} label="Endpoint id" placeholder="64 hex characters" />
          <p class="mt-1 text-xs text-base-500">
            The public key the endpoint proves it holds, not a ticket or a relay URL.
          </p>
        </div>

        <div>
          <.input field={f[:instance]} label="Instance" placeholder="default" />
          <p class="mt-1 text-xs text-base-500">
            Names which endpoint this is, for something running more than one. Leave blank if it
            runs a single one.
          </p>
        </div>

        <div>
          <.input
            field={f[:org_user_id]}
            type="select"
            label="Belongs to"
            options={[{"Nobody in particular", ""} | @members]}
          />
          <p class="mt-1 text-xs text-base-500">
            Attach this endpoint to someone in this organisation, for a laptop or a workstation.
            Leave it unassigned for something the organisation holds directly, or for a device
            that will claim the endpoint itself when it next connects.
          </p>
        </div>

        <div class="flex gap-2">
          <.button type="submit">Register</.button>
          <.button type="button" phx-click="toggle-registration">Cancel</.button>
        </div>
      </.form>
    </div>

    <div class="mb-4 flex flex-wrap items-center gap-3">
      <form id="identity-search" phx-change="search" phx-submit="search" class="min-w-[240px] flex-1">
        <label for="identity-search-input" class="sr-only">Search endpoints</label>
        <input
          id="identity-search-input"
          type="search"
          name="search"
          value={@search}
          placeholder="Search by endpoint id, device or person"
          phx-debounce="300"
          class="w-full rounded border border-base-700 bg-base-800 px-3 py-1.5 text-sm text-base-100 placeholder:text-base-500"
        />
      </form>

      <form id="identity-owner-filter" phx-change="filter">
        <label for="identity-owner-select" class="sr-only">Owner</label>
        <%!-- Asymmetric padding on purpose: the other selects in the app are
              w-full, so their text never reaches the arrow. This one hugs its
              content, and pr-8 is the room the chevron needs. --%>
        <select
          id="identity-owner-select"
          name="owner"
          class="rounded border border-base-700 bg-base-800 py-1.5 pr-8 pl-3 text-sm text-base-100"
        >
          <option value="" selected={is_nil(@owner_filter)}>All owners</option>
          <option value="device" selected={@owner_filter == :device}>Devices</option>
          <option value="org_user" selected={@owner_filter == :org_user}>People</option>
          <option value="unowned" selected={@owner_filter == :unowned}>Unassigned</option>
        </select>
      </form>
    </div>

    <div :if={@identities == []} class="rounded border border-dashed border-base-700 p-8 text-center text-sm text-base-400">
      <p :if={@search == "" and is_nil(@owner_filter)}>
        No endpoints yet. Devices record their own when they connect.
      </p>
      <p :if={@search != "" or not is_nil(@owner_filter)}>Nothing matches that.</p>
    </div>

    <div :if={@identities != []} class="space-y-2">
      <div
        :for={identity <- @identities}
        class="flex items-start gap-4 rounded border border-base-700 bg-linear-to-r from-base-800/50 to-base-800 p-4"
      >
        <div class="min-w-0 flex-1">
          <div class="group/identity flex w-full min-w-0 items-center gap-1.5">
            <%!-- A key fits at most window widths, so it is rendered whole and
                  truncated by CSS only when it has to be. Whatever is on screen,
                  the clipboard gets the full value. --%>
            <span class="min-w-0 truncate font-mono text-sm text-base-50">
              {identity.identifier}
            </span>
            <button
              id={"copy-identity-#{identity.id}"}
              type="button"
              phx-hook="CopyToClipboard"
              data-copy-value={identity.identifier}
              aria-label="Copy endpoint id"
              title="Copy endpoint id"
              class="shrink-0 cursor-pointer text-base-500 opacity-0 transition-opacity group-hover/identity:opacity-100 hover:text-base-200 focus:opacity-100"
            >
              <span data-icon="copy" class="lucide-copy--light size-4"></span>
              <span data-icon="check" class="lucide-check--light hidden size-4 text-success"></span>
            </button>
          </div>

          <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-base-400">
            <% {kind, who} = NervesHubWeb.Live.Org.IrohEndpoints.owner_label(identity) %>
            <span><span class="text-base-500">{kind}:</span> {who}</span>
            <span :if={identity.instance != "default"}>
              <span class="text-base-500">Instance:</span> {identity.instance}
            </span>
            <span>
              <span class="text-base-500">Source:</span>
              {if identity.source == :device_reported, do: "reported by device", else: "registered"}
            </span>
            <span :if={identity.last_reported_at}>
              <span class="text-base-500">Last seen:</span> <.local_datetime at={identity.last_reported_at} time_zone={@time_zone} format={:short_timestamp} />
            </span>
          </div>
        </div>

        <button
          :if={authorized?(:"network_identity:delete", @current_scope)}
          class="rounded border border-base-700 bg-base-800 px-3 py-1.5 text-sm font-medium text-base-300 hover:bg-base-700"
          phx-click="delete"
          phx-value-id={identity.id}
          data-confirm={
            if identity.source == :device_reported,
              do: "This endpoint was reported by a device, which will record it again the next time it connects. Remove it anyway?",
              else: "Remove this endpoint?"
          }
        >
          Remove
        </button>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
