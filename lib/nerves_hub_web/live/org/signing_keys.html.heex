<NervesHubWeb.Layouts.sidebar :if={@live_action == :index} flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">Signing Keys</h1>
    <div class="mr-auto"></div>
    <.button type="link" navigate={~p"/org/#{@org}/settings/keys/new"} aria-label="Add new signing key">
      <.icon name="add" /> Add Key
    </.button>
  </:header>

  <div class="h-0 flex-1 overflow-y-auto px-6 py-4">
    <p class="mb-4 text-sm text-base-400">Signing Keys are used to sign uploaded firmware, and verify the firmware on the device before the device is updated.</p>

    <div class="space-y-3">
      <%= for signing_key <- @signing_keys do %>
        <div class="flex items-start gap-4 rounded border border-base-700 bg-linear-to-r from-base-800/50 to-base-800 p-4">
          <span class="mt-1 lucide-key-round--light size-6"></span>
          <div class="min-w-0 flex-1">
            <h3 class="mb-2 flex items-center gap-2 text-sm font-semibold text-base-50">
              {signing_key.name}
              <span class="rounded-full border border-base-700 bg-base-800 px-2 py-0.5 text-xs font-normal">
                <code class="text-base-300">{scheme_label(signing_key.scheme)}</code>
              </span>
            </h3>
            <div class="mb-1 flex items-baseline gap-2 text-xs text-base-400">
              <span :if={key_label(signing_key)} class="shrink-0 text-base-500">{key_label(signing_key)}</span>
              <span class="font-mono break-all">{key_preview(signing_key)}</span>
            </div>
            <div :if={signing_key.created_by} class="text-xs text-base-500">
              Created by: {signing_key.created_by.name} ({signing_key.created_by.email})
            </div>
          </div>
          <button
            class="rounded border border-base-700 bg-base-800 px-3 py-1.5 text-sm font-medium text-base-300 hover:bg-base-700 disabled:cursor-not-allowed disabled:opacity-50"
            phx-click="delete"
            phx-value-signing_key_id={signing_key.id}
            disabled={!authorized?(:"signing_key:delete", @current_scope)}
            data-confirm="Are you sure?"
          >
            Delete
          </button>
        </div>
      <% end %>
    </div>

    <.link
      href="https://docs.nerves-hub.org/nerves-hub/setup/firmware-signing-keys"
      class="mt-4 inline-flex items-center gap-2 text-sm text-primary hover:text-primary-hover"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>How to generate a signing key -&gt;</span>
    </.link>
  </div>
</NervesHubWeb.Layouts.sidebar>
<NervesHubWeb.Layouts.sidebar :if={@live_action == :new} flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">New Signing Key</h1>
  </:header>

  <div class="h-0 max-w-[650px] flex-1 overflow-y-auto px-6 py-4">
    <.form :let={f} id="signing_key_form" for={@form} phx-submit="save">
      <%= if @form.action do %>
        <div class="mb-4 rounded border border-alert bg-alert-soft p-4 text-sm text-alert-content">
          <p>Something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <div class="mb-4">
        <label for="name_input" class="mb-2 block text-sm font-medium text-base-300">Name</label>
        <input
          type="text"
          id="name_input"
          name={f[:name].name}
          value={f[:name].value}
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none"
        />
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:name]} /></div>
      </div>

      <div class="mb-4">
        <label for="scheme_input" class="mb-2 block text-sm font-medium text-base-300">Scheme</label>
        <select id="scheme_input" name={f[:scheme].name} class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none">
          {Phoenix.HTML.Form.options_for_select(scheme_options(), f[:scheme].value)}
        </select>
        <p class="mt-1 text-xs text-base-500">
          <strong>fwup (Ed25519)</strong>
          signs <code>.fw</code>
          archives for Nerves devices — a base64 public key from <code>fwup -g</code>. <strong>ESP-IDF Secure Boot v2 (RSA-3072)</strong>
          signs <code>.bin</code>
          images — the PEM public half of an <code>espsecure.py</code>
          signing key.
        </p>
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:scheme]} /></div>
      </div>

      <div class="mb-6">
        <label for="key_input" class="mb-2 block text-sm font-medium text-base-300">Key</label>
        <textarea
          id="key_input"
          name={f[:key].name}
          rows="8"
          class="w-full rounded border border-base-700 bg-base-900 px-3 py-2 font-mono text-sm text-base-50 focus:ring-2 focus:ring-focus-ring focus:outline-none"
        ><%= Phoenix.HTML.Form.normalize_value("textarea", f[:key].value) %></textarea>
        <p class="mt-1 text-xs text-base-500">Paste the public key. An RSA key is a multi-line PEM block, including its BEGIN and END lines.</p>
        <div class="mt-1 text-sm text-alert-content"><.field_errors field={f[:key]} /></div>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Create Key
        </.button>
        <.button style="secondary" type="link" patch={~p"/org/#{@org}/settings/keys"}>
          Back
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.sidebar>
