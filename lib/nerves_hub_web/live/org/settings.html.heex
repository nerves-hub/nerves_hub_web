<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-xl leading-[30px] font-semibold text-base-50">Organization Settings</h1>
  </:header>

  <div class="max-w-[650px] px-6 py-4">
    <.form :let={f} id="update-organization-form" for={@form} phx-submit="update">
      <div class="mb-4">
        <label for="name_input" class="mb-2 block text-sm font-medium text-base-300">
          Organization Name <span class="ml-2 text-xs text-base-500">(Must be one word)</span>
        </label>
        {text_input(f, :name, class: "w-full px-3 py-2 text-sm bg-base-900 border border-base-700 rounded text-base-50 focus:outline-none focus:ring-2 focus:ring-focus-ring", id: "name_input")}
        <div class="mt-1 text-sm text-alert-content">{error_tag(f, :name)}</div>
      </div>

      <div class="flex gap-3">
        <.button style="primary" type="submit">
          Save Changes
        </.button>
      </div>
    </.form>

    <div class="mt-8 border-t border-base-700 pt-6">
      <h3 class="mb-3 text-base font-semibold text-base-50">Danger Zone</h3>
      <p class="mb-4 text-sm text-base-400">Once you delete an organization, there is no going back. Please be certain.</p>
      <.button style="danger" type="link" patch={~p"/org/#{@org}/settings/delete"}>
        Delete Organization
      </.button>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
