<NervesHubWeb.Layouts.org flash={@flash} current_scope={@current_scope} tab={@sidebar_tab} counts={@org_counts}>
  <div class="flex flex-col gap-7">
    <section id="org-name" class="flex flex-col gap-4 border-b border-line-default pb-7 md:flex-row md:gap-12">
      <div class="flex flex-col gap-1 md:w-70 md:shrink-0">
        <h2 class="text-group-title text-content-strong"><label for="name_input">Organization name</label></h2>
        <p class="text-[13px] text-content-muted">Shown across NervesCloud and used in every link to this organization.</p>
      </div>

      <.form :let={f} id="update-organization-form" for={@form} phx-submit="update" class="flex min-w-0 flex-1 flex-col gap-3.5">
        <div class="flex flex-col gap-1.5">
          <input
            type="text"
            id="name_input"
            name={f[:name].name}
            value={f[:name].value}
            disabled={!authorized?(:"organization:update", @current_scope)}
            aria-describedby="name_hint"
            class="h-9 w-full rounded border border-line-strong bg-surface-raised px-3 text-sm text-content-strong focus:ring-2 focus:ring-focus-ring focus:outline-none disabled:text-content-muted"
          />
          <div class="text-sm text-alert-content"><.field_errors field={f[:name]} /></div>
          <p id="name_hint" class="text-xs text-content-muted">
            One word: letters, numbers, - and _. Renaming changes links: <span class="font-mono text-content-body">/org/{@org.name}/…</span> stops working.
          </p>
        </div>
        <div>
          <.button style="primary" type="submit" disabled={!authorized?(:"organization:update", @current_scope)}>
            Save name
          </.button>
        </div>
      </.form>
    </section>

    <section id="delete-org" class="flex flex-col gap-4 md:flex-row md:gap-12">
      <div class="flex flex-col gap-1 md:w-70 md:shrink-0">
        <h2 class="text-group-title text-content-strong">Delete organization</h2>
        <p class="text-[13px] text-content-muted">Admins only, like renaming.</p>
      </div>

      <div class="flex min-w-0 flex-1 flex-col gap-4 rounded-lg border border-alert/25 bg-alert-soft px-5 py-4.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
        <div class="flex min-w-0 flex-col gap-0.5">
          <p id="delete-org-summary" class="text-sm font-medium text-alert-content">{delete_summary(@org, @product_names)}</p>
          <p class="text-xs text-content-muted">You’ll type the organization name to confirm. This can’t be undone.</p>
        </div>
        <.button
          :if={authorized?(:"organization:delete", @current_scope)}
          style="danger"
          type="link"
          navigate={~p"/org/#{@org}/settings/delete"}
          class="shrink-0 self-start sm:self-auto"
        >
          Delete organization…
        </.button>
        <.button
          :if={!authorized?(:"organization:delete", @current_scope)}
          style="danger"
          disabled
          title="Only admins can delete this organization"
          class="shrink-0 self-start sm:self-auto"
        >
          Delete organization…
        </.button>
      </div>
    </section>
  </div>
</NervesHubWeb.Layouts.org>
