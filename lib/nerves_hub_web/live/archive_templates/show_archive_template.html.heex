<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2">
      <.link navigate={~p"/org/#{@current_scope.org}/#{@product}/archives"} class="text-base/6 font-medium text-content-muted hover:text-content-strong">
        Archives
      </.link>
      <span class="lucide-chevron-right size-3.5 text-content-faint" aria-hidden="true"></span>
      <span aria-current="page" class="truncate font-mono text-card-title text-content-strong">{@archive.version}</span>
      <span class="truncate font-mono text-xs text-content-muted max-sm:hidden">{@archive.platform} · {@archive.architecture}</span>
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:mr-6">
      <.button :if={authorized?(:"archive:download", @current_scope)} type="link" href={~p"/org/#{@current_scope.org}/#{@product}/archives/#{@archive}/download"} download>
        <span class="lucide-download" aria-hidden="true"></span><span class="max-sm:hidden">Download</span>
      </.button>
      <.button
        :if={authorized?(:"archive:delete", @current_scope)}
        type="button"
        aria-label="Delete archive"
        disabled={@releases != []}
        phx-click="prepare-delete"
        phx-value-archive_uuid={@archive.uuid}
      >
        <span class="lucide-trash" aria-hidden="true"></span><span class="max-sm:hidden">Delete</span>
      </.button>
    </div>
  </:top_bar>

  <div class="@container h-0 flex-1 overflow-y-auto">
    <div class="flex flex-col gap-6 px-4 pt-5 pb-8 @3xl:px-8 @3xl:pt-7">
      <div class="flex flex-col gap-2.5">
        <div class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1">
          <h1 class="font-mono text-figure-xl font-semibold text-content-strong">{@archive.version}</h1>
          <p :if={@archive.description} class="text-sm/5 text-content-body">{@archive.description}</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <%!-- Squarer and flatter than `<.tag>`. --%>
          <code class="rounded-sm border border-line-default bg-surface-muted px-1.5 py-px font-mono text-xs text-content-body">
            {@archive.platform} · {@archive.architecture}
          </code>
          <%= case signing_key(@archive, @org_keys) do %>
            <% {:key, name} -> %>
              <span class="flex items-center gap-1.25 rounded-sm border border-success/20 bg-success-soft px-1.5 py-px text-xs text-success-content light:border-emerald-100">
                <span class="lucide-check--bold size-3 text-success light:text-emerald-600" aria-hidden="true"></span>
                <span>Signed with <span class="font-mono">{name}</span></span>
              </span>
            <% :unknown -> %>
              <span class="rounded-sm border border-line-default bg-surface-muted px-1.5 py-px text-xs text-content-body">Signed with an unknown key</span>
          <% end %>
          <span class="flex min-w-0 items-center gap-1.5 sm:ml-2">
            <span id="archive-uuid" class="truncate font-mono text-xs text-content-faint">{@archive.uuid}</span>
            <button
              id="copy-archive-uuid"
              type="button"
              phx-hook="CopyToClipboard"
              data-copy-value={@archive.uuid}
              aria-label="Copy UUID"
              title="Copy UUID"
              class="shrink-0 cursor-pointer text-content-faint hover:text-content-strong light:text-zinc-400 light:hover:text-content-strong"
            >
              <span data-icon="copy" class="lucide-copy size-3.25"></span>
              <span data-icon="check" class="lucide-check hidden size-3.25 text-success"></span>
            </button>
          </span>
        </div>
      </div>

      <div class="flex flex-col items-start gap-8 @5xl:flex-row">
        <div class="flex w-full min-w-0 flex-col gap-6 @5xl:flex-1">
          <section aria-label="Who gets it" class="flex flex-col rounded-card border border-line-default bg-surface-raised">
            <% current = Enum.count(@releases, & &1.current?) %>
            <dl class="grid grid-cols-2 gap-x-10 gap-y-5 border-b border-line-subtle px-5 pt-5 pb-4.5 @3xl:flex">
              <div class="flex flex-col gap-1">
                <dt class="text-label text-content-muted uppercase">Gets it now</dt>
                <dd id="archive-gets-it-now" class="font-mono text-figure font-normal text-content-strong">{delimited(@delivery.gets_it_now)}</dd>
                <dd class="text-ui text-content-body">on their group’s release firmware</dd>
              </div>
              <div class="flex flex-col gap-1">
                <dt class="text-label text-content-muted uppercase">Gets it after updating</dt>
                <dd
                  id="archive-gets-it-after-updating"
                  class={["font-mono text-figure font-normal", (@delivery.gets_it_after_updating > 0 && "text-notice-content") || "text-content-strong"]}
                >
                  {delimited(@delivery.gets_it_after_updating)}
                </dd>
                <dd class="text-ui text-content-body">on older firmware, in the same groups</dd>
              </div>
              <div class="col-span-2 flex flex-col gap-1">
                <dt class="text-label text-content-muted uppercase">Releases with it</dt>
                <dd id="archive-releases-count" class="font-mono text-figure font-normal text-content-strong">{length(@releases)}</dd>
                <dd class="text-ui text-content-body">{current} current, {length(@releases) - current} past</dd>
              </div>
            </dl>

            <div class="flex flex-col py-1.5">
              <h2 class="px-5 pt-2.5 pb-1.5 text-label text-content-muted uppercase">Deployment groups delivering it</h2>
              <.link
                :for={group <- @delivery.groups}
                id={"delivery-#{group.deployment_group.id}"}
                navigate={~p"/org/#{@current_scope.org}/#{@product}/deployment_groups/#{group.deployment_group}"}
                class="group flex items-center gap-3 px-5 py-2.5 hover:bg-surface-muted max-sm:flex-wrap"
              >
                <span class="lucide-rocket size-4 text-content-muted" aria-hidden="true"></span>
                <span class="w-45 min-w-0 shrink-0 truncate text-sm/5 font-medium text-content-strong max-sm:w-auto max-sm:flex-1">{group.deployment_group.name}</span>
                <span class="w-30 shrink-0 truncate text-ui text-content-body max-sm:w-auto">with <span class="font-mono text-xs">{group.firmware.version}</span></span>
                <span class="flex min-w-0 flex-1 items-center gap-2.5 max-sm:basis-full max-sm:pl-7">
                  <span class="flex h-1.5 w-55 shrink overflow-hidden rounded-full bg-line-subtle" role="img" aria-label={"#{group.gets_it} of #{group.devices} devices get it now"}>
                    <span class="h-full bg-success" style={"width: #{percent(group.gets_it, group.devices)}%"}></span>
                  </span>
                  <span class="shrink-0 font-mono text-xs whitespace-nowrap text-content-body">
                    {delimited(group.gets_it)} of {delimited(group.devices)} {ngettext("device", "devices", group.devices)}
                  </span>
                </span>
                <span class="lucide-chevron-right size-3.5 text-content-faint group-hover:text-content-muted max-sm:hidden" aria-hidden="true"></span>
              </.link>
              <div :if={@delivery.groups == []} id="no-delivery" class="flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-2.5 text-ui text-content-muted">
                No deployment group’s current release includes it, so no device is sent it.
                <.link
                  :if={authorized?(:"deployment_group:update", @current_scope)}
                  navigate={~p"/org/#{@current_scope.org}/#{@product}/deployment_groups"}
                  class="font-medium text-notice-content hover:underline"
                >
                  Add to a group’s release…
                </.link>
              </div>
            </div>
          </section>

          <div :if={@releases != []} id="archive-delete-note" class="flex items-start gap-2.5 rounded-card border border-line-default bg-surface-muted px-3.5 py-3">
            <span class="mt-0.5 lucide-circle-exclamation-point size-3.75 text-content-muted" aria-hidden="true"></span>
            <p class="text-ui/4.5 text-content-body">{blocked_message(blocking_groups(@releases))}</p>
          </div>

          <section :if={@releases != []} aria-labelledby="releases-title" class="flex flex-col rounded-card border border-line-default bg-surface-raised">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 pt-4 pb-3">
              <h2 id="releases-title" class="text-sm/5 font-semibold text-content-strong">Releases with this archive</h2>
              <p class="text-ui text-content-muted">Devices are sent it only while it’s in their group’s current release</p>
            </div>

            <div role="table" aria-labelledby="releases-title" class="flex flex-col">
              <div role="row" class="flex h-8 shrink-0 items-center border-y border-line-subtle bg-surface-muted/50 px-5 max-sm:hidden">
                <span role="columnheader" class="w-45 shrink-0 text-label text-content-muted uppercase">Group</span>
                <span role="columnheader" class="w-35 shrink-0 text-label text-content-muted uppercase">Firmware</span>
                <span role="columnheader" class="w-40 shrink-0 text-label text-content-muted uppercase">Released</span>
                <span role="columnheader" class="flex-1 text-label text-content-muted uppercase">Status</span>
              </div>
              <div
                :for={release <- @releases}
                role="row"
                class="flex min-h-10.5 shrink-0 items-center border-b border-line-subtle px-5 last:border-b-0 max-sm:flex-wrap max-sm:gap-x-3 max-sm:gap-y-1 max-sm:py-2.5 max-sm:first:border-t"
              >
                <span role="cell" class="w-45 min-w-0 shrink-0 truncate max-sm:w-auto max-sm:flex-1">
                  <.link navigate={~p"/org/#{@current_scope.org}/#{@product}/deployment_groups/#{release.deployment_group}"} class="text-ui font-medium text-content-strong hover:underline">
                    {release.deployment_group.name}
                  </.link>
                </span>
                <span role="cell" class="w-35 shrink-0 font-mono text-ui text-content-body max-sm:w-auto">{release.firmware.version}</span>
                <span role="cell" class="w-40 shrink-0 text-ui text-content-body max-sm:order-last max-sm:w-auto" title={to_local_string(release.released_at, @time_zone)}>
                  <span class="sm:hidden">Released </span>{day_label(release.released_at, @time_zone)}
                </span>
                <span role="cell" class="flex min-w-0 flex-1 items-center gap-1.5 max-sm:basis-full">
                  <%= if release.current? do %>
                    <.status_dot class="size-1.5 bg-success" />
                    <span class="text-ui text-content-strong">Current release</span>
                  <% else %>
                    <.status_dot class="size-1.5 bg-content-faint" />
                    <span class="text-ui text-content-muted">
                      {(release.replaced_at && "Replaced #{day_label(release.replaced_at, @time_zone)}") || "Replaced"}
                    </span>
                  <% end %>
                </span>
              </div>
            </div>
          </section>
        </div>

        <aside aria-labelledby="details-title" class="flex w-full shrink-0 flex-col @5xl:w-85">
          <h2 id="details-title" class="border-b border-line-default pb-2 text-label text-content-muted uppercase">Details</h2>
          <dl class="flex flex-col">
            <div class="flex flex-col gap-0.5 border-b border-line-subtle py-2.5">
              <dt class="text-xs text-content-muted">Uploaded</dt>
              <dd class="text-ui/4.5 text-content-strong">
                <.local_datetime at={@archive.inserted_at} time_zone={@time_zone} /> <span class="text-content-muted">· {from_now(@archive.inserted_at)}</span>
              </dd>
            </div>
            <div :if={@archive.author} class="flex flex-col gap-0.5 border-b border-line-subtle py-2.5">
              <dt class="text-xs text-content-muted">Author</dt>
              <dd class="text-ui/4.5 text-content-strong">{@archive.author}</dd>
            </div>
            <div :if={@archive.vcs_identifier} class="flex flex-col gap-0.5 border-b border-line-subtle py-2.5">
              <dt class="text-xs text-content-muted">VCS ID</dt>
              <dd class="font-mono text-xs/4.5 break-all text-content-strong">{@archive.vcs_identifier}</dd>
            </div>
            <div class="flex flex-col gap-0.5 border-b border-line-subtle py-2.5">
              <dt class="text-xs text-content-muted">Size</dt>
              <dd class="font-mono text-xs/4.5 text-content-strong">{format_megabytes(@archive.size)}</dd>
            </div>
            <div :if={@archive.misc} class="flex flex-col gap-0.5 border-b border-line-subtle py-2.5">
              <dt class="text-xs text-content-muted">Misc</dt>
              <dd class="font-mono text-xs/4.5 wrap-anywhere text-content-strong">{@archive.misc}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </div>

  <.delete_dialog :if={@deleting} deleting={@deleting} />
</NervesHubWeb.Layouts.sidebar>
