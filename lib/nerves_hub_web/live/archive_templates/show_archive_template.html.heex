<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.breadcrumb navigate={~p"/org/#{@current_scope.org}/#{@product}/archives"} root_label="All Archives">
      <:crumb>{@archive.uuid}</:crumb>
    </.breadcrumb>
  </:top_bar>

  <div class="flex h-0 flex-1 flex-col overflow-y-auto">
    <div class="flex h-header shrink-0 justify-between border-b border-line-default p-6">
      <div class="flex items-center gap-3">
        <h1 class="text-page-title text-content-strong">
          {@archive.uuid}
        </h1>
      </div>

      <div class="flex items-center gap-2">
        <.button type="link" href={~p"/org/#{@current_scope.org}/#{@product}/archives/#{@archive}/download"} download>
          <.icon name="download" />Download
        </.button>

        <.button style="danger" aria-label="Delete archive" type="button" phx-click="delete-archive">
          <span class="lucide-trash size-4 text-alert" aria-hidden="true"></span>
          <span class="text-sm font-medium text-alert">Delete</span>
        </.button>
      </div>
    </div>

    <div class="flex h-full items-start justify-between gap-4 p-6">
      <div class="flex w-1/2 flex-col gap-4">
        <div class="flex flex-col rounded-card border border-line-default bg-surface-raised pb-4 shadow-card">
          <div class="flex h-14 items-center px-4 text-card-title text-content-strong">
            General info
          </div>
          <div class="flex flex-col gap-3">
            <div :if={@archive.author} class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Author:</span>
              <span class="text-sm text-content-body">{@archive.author}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Description:</span>
              <span :if={@archive.description} class="text-sm text-content-body">{@archive.description}</span>
              <span :if={!@archive.description} class="text-sm text-content-muted">No description</span>
            </div>

            <div :if={@archive.misc} class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Misc:</span>
              <span class="text-sm text-content-body">{@archive.misc}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Signed with:</span>
              <span class="flex items-center gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-3 pl-2.5">
                <code class="text-xs text-content-body">{format_signed(@archive, @org_keys)}</code>
              </span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Uploaded on:</span>
              <span class="text-sm text-content-body"><.local_datetime at={@archive.inserted_at} time_zone={@time_zone} /></span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex w-1/2 flex-col gap-4">
        <div class="flex flex-col rounded-card border border-line-default bg-surface-raised pb-4 shadow-card">
          <div class="flex h-14 items-center px-4 text-card-title text-content-strong">
            Metadata
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Version:</span>
              <span class="text-sm text-content-body">{@archive.version}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Architecture:</span>
              <span class="text-sm text-content-body">{@archive.architecture}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Platform:</span>
              <span class="text-sm text-content-body">{@archive.platform}</span>
            </div>

            <div :if={@archive.vcs_identifier} class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">VCS ID:</span>
              <span class="text-sm text-content-body">{@archive.vcs_identifier}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Size:</span>
              <span class="text-sm text-content-body">{format_file_size(@archive.size)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
