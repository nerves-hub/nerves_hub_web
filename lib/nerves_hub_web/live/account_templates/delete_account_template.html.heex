<NervesHubWeb.Layouts.account flash={@flash} current_scope={@current_scope} tab={:profile}>
  <NervesHubWeb.Layouts.org_heading title="Delete account" back={~p"/account"} back_label="Back to profile" />

  <div class="flex max-w-xl flex-col gap-5 rounded-card border border-alert/30 bg-alert-soft p-5">
    <div class="flex gap-3">
      <span class="mt-0.5 lucide-triangle-exclamation-point size-5 flex-none text-alert" aria-hidden="true"></span>
      <div class="flex flex-col gap-1.5">
        <h2 class="text-section-title text-alert-content">Are you absolutely sure?</h2>
        <p class="text-sm text-content-body">
          This permanently deletes your account and its access tokens, and takes you out of every organization. It <span class="font-semibold text-alert-content">can't be undone</span>.
        </p>
      </div>
    </div>

    <.form :let={f} id="delete-account-form" for={@form} phx-submit="delete" class="flex flex-col gap-4">
      <.input field={f[:confirm_email]} type="text" label={"Please type #{@user.email} to confirm."} placeholder="Type your email to confirm" autocomplete="off" />
      <div class="flex justify-end">
        <.button style="danger-solid" type="submit">
          I understand the consequences, delete this account
        </.button>
      </div>
    </.form>
  </div>
</NervesHubWeb.Layouts.account>
