<NervesHubWeb.Layouts.no_sidebar flash={@flash} current_scope={@current_scope}>
  <div class="w-[800px]">
    <div class="flex h-[88px] items-center justify-between py-6">
      <h1 class="text-page-title text-content-strong">Delete Account</h1>
      <.button type="link" navigate={~p"/account"}>
        Cancel
      </.button>
    </div>

    <div class="rounded-md border border-alert bg-base-900 p-4">
      <div class="mb-6 flex items-start gap-4">
        <div class="mt-1 shrink-0">
          <span class="lucide-triangle-exclamation-point size-6 text-alert" aria-hidden="true"></span>
        </div>
        <div>
          <h2 class="mb-2 text-section-title text-alert-content">Are you absolutely sure?</h2>
          <div class="space-y-2 text-content-body">
            <p class="font-semibold">Unexpected bad things will happen if you don't read this!</p>
            <p>This action <span class="font-semibold text-alert-content">cannot be undone</span>. This will permanently delete your account and all associated data.</p>
          </div>
        </div>
      </div>

      <.form :let={f} id="delete-account-form" for={@form} phx-submit="delete">
        <div class="mb-6">
          <label for="email_input" class="mb-2 block text-sm font-medium text-content-body">
            Please type <span class="rounded bg-base-800 px-2 py-0.5 font-mono text-content-strong">{@user.email}</span> to confirm.
          </label>
          <input
            type="text"
            id="email_input"
            name={f[:confirm_email].name}
            value={f[:confirm_email].value}
            class="w-full rounded border border-line-strong bg-base-900 px-3 py-2 text-content-strong placeholder-base-500 focus:border-transparent focus:ring-2 focus:ring-alert focus:outline-none"
            placeholder="Type your email to confirm"
          />
        </div>

        <div class="flex justify-end">
          <.button style="danger-solid" type="submit">
            I understand the consequences, delete this account
          </.button>
        </div>
      </.form>
    </div>
  </div>
</NervesHubWeb.Layouts.no_sidebar>
