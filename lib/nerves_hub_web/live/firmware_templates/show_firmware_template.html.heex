<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.breadcrumb patch={~p"/org/#{@current_scope.org}/#{@product}/firmware"} root_label="All Firmware">
      <:crumb>{@firmware.uuid}</:crumb>
    </.breadcrumb>
  </:top_bar>

  <div class="flex h-0 flex-1 flex-col overflow-y-auto">
    <div class="flex h-header shrink-0 justify-between border-b border-line-default p-6">
      <div class="flex items-center gap-3">
        <h1 class="text-page-title text-content-strong">
          {@firmware.uuid}
        </h1>
      </div>

      <div :if={!Firmware.deleted?(@firmware)} class="flex items-center gap-2">
        <.button :if={authorized?(:"firmware:download", @current_scope)} type="link" href={~p"/org/#{@current_scope.org}/#{@product}/firmware/#{@firmware}/download"} download>
          <.icon name="download" />Download
        </.button>

        <%!-- The tooltip only explains why delete is disabled, so it is only
        enabled when something blocks the deletion. --%>
        <.tooltip id="delete-firmware-tooltip" class="z-20 flex items-center" content_class="w-max max-w-72" enabled={@deletion_blockers != []}>
          <.button
            style="danger"
            aria-label="Delete firmware"
            type="button"
            disabled={@deletion_blockers != []}
            phx-click={@deletion_blockers == [] && "delete-firmware"}
            data-confirm={@deletion_blockers == [] && delete_confirmation(@firmware, @deletion_warnings)}
          >
            <span class={["lucide-trash size-4", if(@deletion_blockers == [], do: "text-alert", else: "text-base-500")]} aria-hidden="true"></span>
            <span class={["text-sm font-medium", if(@deletion_blockers == [], do: "text-alert", else: "text-content-faint")]}>
              Delete
            </span>
          </.button>
          <:content>
            {FirmwareDeletion.blockers_message(@deletion_blockers)}
          </:content>
        </.tooltip>
      </div>
    </div>

    <div :if={Firmware.deleted?(@firmware)} class="flex shrink-0 items-center gap-2 border-b border-line-default px-6 py-3">
      <.icon name="trash" class="text-content-muted" />
      <span class="text-sm text-content-body">
        This firmware was deleted<span :if={@firmware.deleted_by}> by {@firmware.deleted_by.name}</span>
        on <.local_datetime at={@firmware.deleted_at} time_zone={@time_zone} />. The firmware file is gone; this page is
        kept so device history and past deployment releases still resolve.
      </span>
    </div>

    <div class="flex h-full items-start justify-between gap-4 p-6">
      <div class="flex w-1/2 flex-col gap-4">
        <div class="flex flex-col rounded-card border border-line-default bg-surface-raised pb-4 shadow-card">
          <div class="flex h-14 items-center px-4 text-card-title text-content-strong">
            General info
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Author:</span>
              <span class="text-sm text-content-body">{@firmware.author}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Description:</span>
              <span :if={@firmware.description} class="text-sm text-content-body">{@firmware.description}</span>
              <span :if={!@firmware.description} class="text-sm text-content-muted">No description</span>
            </div>

            <div :if={@firmware.misc} class="flex min-h-7 items-center gap-4 px-4">
              <span class="shrink-0 text-sm text-content-faint">Misc:</span>
              <span class="min-w-0 text-sm wrap-anywhere text-content-body">{@firmware.misc}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Install count:</span>
              <span :if={@firmware.install_count} class="text-sm text-content-body">{@firmware.install_count}</span>
              <span :if={!@firmware.install_count} class="text-sm text-content-muted">No installations</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Signed with:</span>
              <span class="flex items-center gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-3 pl-2.5">
                <code class="text-xs text-content-body">{format_signed(@firmware, @org_keys)}</code>
              </span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Uploaded on:</span>
              <span class="text-sm text-content-body"><.local_datetime at={@firmware.inserted_at} time_zone={@time_zone} /></span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex w-1/2 flex-col gap-4">
        <div class="flex flex-col rounded-card border border-line-default bg-surface-raised pb-4 shadow-card">
          <div class="flex h-14 items-center px-4 text-card-title text-content-strong">
            Metadata
          </div>
          <div class="flex flex-col gap-3">
            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Version:</span>
              <span class="text-sm text-content-body">{@firmware.version}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Update tool:</span>
              <span class="flex items-center gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-3 pl-2.5">
                <code class="text-xs text-content-body">{@firmware.tool}</code>
              </span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Architecture:</span>
              <span class="text-sm text-content-body">{@firmware.architecture}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Platform:</span>
              <span class="text-sm text-content-body">{@firmware.platform}</span>
            </div>

            <div :if={@firmware.vcs_identifier} class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">VCS ID:</span>
              <span class="text-sm text-content-body">{@firmware.vcs_identifier}</span>
            </div>

            <div class="flex min-h-7 items-center gap-4 px-4">
              <span class="text-sm text-content-faint">Size:</span>
              <span class="text-sm text-content-body">{format_file_size(@firmware.size)}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
