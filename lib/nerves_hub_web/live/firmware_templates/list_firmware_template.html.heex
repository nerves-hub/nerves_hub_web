<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-page-title text-content-strong">All Firmware</h1>
    <.badge class="mr-auto">
      {@pager_meta.total_count}
    </.badge>

    <div :for={entry <- @uploads.firmware.entries} class="flex w-2/5 flex-col items-center pr-2 pl-4">
      <div class="mb-1 flex justify-between">
        <span class="text-sm text-primary dark:text-content-strong">Uploading firmware... </span>
        <span class="text-sm text-primary dark:text-content-strong">{entry.progress}%</span>
      </div>
      <div class="h-2.5 w-full rounded-full bg-base-700">
        <div class="h-2.5 animate-pulse rounded-full bg-primary" style={"width: #{entry.progress}%"}></div>
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm font-medium text-content-body hover:cursor-pointer">
      <input
        type="checkbox"
        class="rounded border-line-default bg-base-800 text-content-muted checked:bg-primary hover:cursor-pointer focus:ring-0"
        checked={@include_deleted}
        phx-click="toggle-deleted-firmware"
      /> Show deleted
    </label>

    <form id="firmware-form" phx-change="validate-firmware" class={[Enum.any?(@uploads.firmware.entries) && "hidden"]}>
      <.button type="label" for={@uploads.firmware.ref}>
        <.icon name="add" /> Upload Firmware
      </.button>
      <.live_file_input upload={@uploads.firmware} class="hidden" />
    </form>
  </:header>

  <%!-- The drop target wraps the scrolling list instead of being it, so the
        overlay can cover the whole area without scrolling along with the rows. --%>
  <div class="relative flex h-0 flex-1 flex-col" phx-drop-target={@uploads.firmware.ref}>
    <div class="h-0 flex-1 overflow-y-auto">
      <div :if={Enum.any?(@firmware)} class="listing">
        <table>
          <thead>
            <tr>
              <th>UUID</th>
              <th phx-click="sort" phx-value-sort="version" class="cursor-pointer">
                <Sorting.sort_icon text="Version" field="version" selected_field={@current_sort} selected_direction={@sort_direction} />
              </th>
              <th>Tool</th>
              <th>Platform</th>
              <th>Architecture</th>
              <th phx-click="sort" phx-value-sort="install_count" class="cursor-pointer">
                <Sorting.sort_icon text="Install count" field="install_count" selected_field={@current_sort} selected_direction={@sort_direction} />
              </th>
              <th>Signing Key</th>
              <th phx-click="sort" phx-value-sort="inserted_at" class="cursor-pointer">
                <Sorting.sort_icon text={"Uploaded on (#{zone_abbr(@time_zone)})"} field="inserted_at" selected_field={@current_sort} selected_direction={@sort_direction} />
              </th>
            </tr>
          </thead>
          <tbody>
            <tr :for={firmware <- @firmware} class={["border-b border-line-subtle", Firmware.deleted?(firmware) && "opacity-60"]}>
              <td>
                <div class="flex items-center gap-2">
                  <.link patch={~p"/org/#{@current_scope.org}/#{@product}/firmware/#{firmware}"}>
                    {firmware.uuid}
                  </.link>
                  <.badge :if={Firmware.deleted?(firmware)} title={deleted_summary(firmware, @time_zone)}>
                    Deleted
                  </.badge>
                </div>
              </td>

              <td>
                <div class="flex items-center gap-2">
                  {firmware.version}
                </div>
              </td>

              <td>
                <span class="inline-flex gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-3 pl-2.5">
                  <code class="text-xs text-content-body">{firmware.tool}</code>
                </span>
              </td>

              <td>
                {firmware.platform}
              </td>

              <td>
                {firmware.architecture}
              </td>

              <td>
                {firmware.install_count || 0}
              </td>

              <td>
                <span class="inline-flex gap-1 rounded-full border border-line-default bg-base-800 py-0.5 pr-3 pl-2.5">
                  <code class="text-xs text-content-body">{format_signed(firmware, @org_keys)}</code>
                </span>
              </td>

              <td>
                <%= if is_nil(firmware.inserted_at) do %>
                  Never
                <% else %>
                  <.local_datetime at={firmware.inserted_at} time_zone={@time_zone} zone_label={false} />
                <% end %>
              </td>

              <%!-- <td class="actions">
              <div class="">
                <a class="" data-target="#" id={"actions-#{device.id}"} data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" phx-click={show_menu("actions-menu-#{device.id}")}>
                  <span class="lucide-ellipsis-vertical size-4 text-content-muted" aria-hidden="true"></span>
                </a>
                <div class="hidden absolute right-6 menu-box" id={"actions-menu-#{device.id}"} phx-click-away={hide_menu("actions-menu-#{device.id}")} phx-key="escape" )}>
                  <.link phx-click="reboot-device" phx-value-device_identifier={device.identifier} class="dropdown-item">
                    Reboot
                  </.link>
                  <div class="dropdown-divider"></div>
                  <.link navigate={~p"/org/#{@org}/#{@product}/devices/#{device}/console"} class="dropdown-item">
                    Console
                  </.link>
                  <div class="dropdown-divider"></div>
                  <div class="dropdown-divider"></div>
                  <.link phx-click="toggle-device-updates" phx-value-device_identifier={device.identifier} class="dropdown-item">
                    <span>
                      <%= if device.update_mode != :off, do: "Disable Updates", else: "Enable Updates" %>
                    </span>
                  </.link>

                  <div class="dropdown-divider"></div>

                  <%= link to: Routes.device_path(@socket, :export_audit_logs, @org.name, @product.name, device.identifier), class: "dropdown-item", aria: [label: "Download Audit Logs"] do %>
                    <div class="button-icon download"></div>
                    <span class="action-text">Download Audit Logs</span>
                  <% end %>
                </div>
              </div>
            </td> --%>
            </tr>
          </tbody>
        </table>
      </div>

      <div :if={Enum.empty?(@firmware)} class="flex h-full items-center justify-center pb-16">
        <span class="font-mono text-xl font-medium text-content-muted">{@current_scope.product.name} doesn’t have any available firmware.</span>
      </div>
    </div>

    <%!-- Only shown while a file is being dragged over the page. `pointer-events-none`
          keeps the drop itself landing on the target underneath. --%>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-40 flex items-center justify-center bg-surface/70 p-6 opacity-0 backdrop-blur-xs transition-opacity duration-150 phx-drop-target-active:opacity-100"
    >
      <div class="flex size-full flex-col items-center justify-center gap-3 rounded-md border-2 border-dashed border-primary bg-primary/5">
        <span class="lucide-upload size-10 text-primary"></span>
        <span class="text-lg font-medium text-content-strong">Drop to upload firmware</span>
        <span class="text-sm text-content-muted">Accepts .fw, .bin, .raucb and .avm files</span>
      </div>
    </div>
  </div>

  <:pagination pager={@pager_meta} page_sizes={[25, 50, 100]} />
</NervesHubWeb.Layouts.sidebar>
