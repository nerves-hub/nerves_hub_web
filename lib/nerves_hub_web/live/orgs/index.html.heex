<NervesHubWeb.Layouts.no_sidebar flash={@flash} current_scope={@current_scope}>
  <%= if @onboarding do %>
    <% {org_name, product_name} = {@onboarding_form[:org_name].value || "", @onboarding_form[:product_name].value || ""} %>
    <div class="flex w-full max-w-228 flex-col gap-6 px-4 pt-7 pb-10 md:gap-10 md:pt-12 md:pb-20">
      <div class="flex max-w-155 flex-col gap-2">
        <p class="text-sm font-medium text-content-muted">Welcome, {@current_scope.user.name |> String.split() |> List.first()}</p>
        <h1 class="text-page-title text-content-strong">Set up your first organization</h1>
        <p class="text-sm/6 text-content-body">
          An organization holds your products, your team and your firmware signing keys. Start with one for your team. You can add more later, or be invited to someone else’s.
        </p>
      </div>

      <div class="flex flex-col gap-8 md:gap-12 lg:flex-row lg:items-start">
        <div class="flex w-full max-w-133 flex-col gap-4">
          <.form
            for={@onboarding_form}
            id="onboarding-form"
            phx-change="validate_onboarding"
            phx-submit="save_onboarding"
            class="flex flex-col gap-6 rounded-md border border-line-default bg-surface-raised p-4 shadow-card sm:p-6"
          >
            <.input field={@onboarding_form[:org_name]} label="Organization name" hint="Usually your company or team name." autocomplete="off" required>
              <:label_action><span class="text-xs text-content-faint">You can rename it later</span></:label_action>
            </.input>

            <div class="flex flex-col gap-2">
              <.input
                field={@onboarding_form[:product_name]}
                label="First product"
                hint="A group of devices that run the same firmware, like one hardware model."
                autocomplete="off"
                required
              >
                <:label_action>
                  <span class="flex items-center gap-1 text-xs text-content-faint">
                    <span class="lucide-lock size-3" aria-hidden="true"></span> Can’t be changed later
                  </span>
                </:label_action>
              </.input>
              <p id="onboarding-url" class="flex items-start gap-2 rounded bg-surface-muted px-3 py-2 font-mono text-xs text-content-muted sm:items-center">
                <span class="mt-0.5 lucide-link size-3.5 sm:mt-0" aria-hidden="true"></span>
                <span class="min-w-0 wrap-anywhere sm:truncate">/org/{org_name}/<span class="text-content-strong">{product_name}</span></span>
              </p>
            </div>

            <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-4">
              <.button style="primary" type="submit" phx-disable-with="Creating…" class="w-full sm:w-auto">
                Create organization and product <span class="lucide-arrow-right size-4" aria-hidden="true"></span>
              </.button>
              <p class="text-center text-xs text-content-muted sm:text-left">Next, you’ll connect a device.</p>
            </div>
          </.form>

          <div class="flex gap-3 rounded-md border border-dashed border-line-strong p-4">
            <span class="mt-0.5 lucide-users size-4 text-content-muted" aria-hidden="true"></span>
            <p class="text-sm text-content-muted">
              <span class="font-medium text-content-strong">Joining an existing team?</span>
              Ask one of its admins to invite the email address you signed in with. You don’t need your own organization first.
            </p>
          </div>
        </div>

        <section aria-labelledby="next-steps-title" class="flex w-full flex-col gap-4.5 lg:w-75 lg:shrink-0 lg:pt-5">
          <h2 id="next-steps-title" class="text-group-title text-content-strong">What happens next</h2>
          <ol class="flex flex-col gap-4.5">
            <li
              :for={
                {number, title, body} <- [
                  {1, "Create your organization and product", "We also make a shared secret for the product, so devices can connect straight away."},
                  {2, "Connect a device", "Add NervesHubLink to your firmware. The Devices page shows the settings to copy."},
                  {3, "Ship your first firmware", "Add a signing key, upload a signed firmware and roll it out with a deployment group."},
                  {4, "Invite your team", "Add people from the organization’s Users page whenever you’re ready."}
                ]
              }
              class="flex items-start gap-3"
            >
              <span class={[
                "flex size-5.5 shrink-0 items-center justify-center rounded-full text-xs font-semibold",
                number == 1 && "bg-primary text-primary-content light:bg-indigo-600",
                number != 1 && "border border-line-strong bg-surface-raised text-content-muted"
              ]}>
                {number}
              </span>
              <div class="flex flex-col gap-0.5 pt-0.5">
                <p class={["text-sm font-medium", if(number == 1, do: "text-content-strong", else: "text-content-body")]}>{title}</p>
                <p class="text-xs/[17px] text-content-muted">{body}</p>
              </div>
            </li>
          </ol>
        </section>
      </div>
    </div>
  <% else %>
    <% single_org? = match?([_], @orgs) %>
    <% {sectioned, others} = split_sections(@orgs) %>
    <div class="flex w-full max-w-228 flex-col gap-8 px-4 pt-6 pb-10 md:gap-10 md:pt-12 md:pb-20">
      <%= if single_org? do %>
        <% [entry] = @orgs %>
        <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-6">
          <div class="flex min-w-0 items-center gap-4 md:flex-1">
            <.link
              navigate={~p"/org/#{entry.org}"}
              class="flex size-12 shrink-0 items-center justify-center rounded-md border border-line-default bg-surface-raised text-lg font-semibold text-content-strong shadow-card"
              aria-hidden="true"
              tabindex="-1"
            >
              {monogram(entry.org.name)}
            </.link>
            <div class="min-w-0">
              <.link navigate={~p"/org/#{entry.org}"} class="group flex items-center gap-1.5">
                <h1 class="truncate text-page-title text-content-strong group-hover:underline">{entry.org.name}</h1>
                <span class="lucide-chevron-right size-5 text-content-faint" aria-hidden="true"></span>
              </.link>
              <p class="text-sm text-content-muted">
                {count_noun(length(entry.products), "product", "products")} · {count_noun(entry.device_count, "device", "devices")} · {count_noun(entry.member_count, "member", "members")}
              </p>
            </div>
          </div>
          <div class="flex items-center gap-2 whitespace-nowrap md:shrink-0">
            <%!-- One joined group: the buttons share edges, and only the outer corners are rounded.
                 On a phone it spans the width, three equal buttons. --%>
            <nav
              aria-label={"#{entry.org.name} settings"}
              class="flex flex-1 md:flex-none [&>a]:flex-1 [&>a]:rounded-none md:[&>a]:flex-none [&>a:first-child]:rounded-l [&>a:last-child]:rounded-r [&>a:not(:first-child)]:-ml-px"
            >
              <.button type="link" navigate={~p"/org/#{entry.org}/settings/users"}>
                <span class="lucide-users size-4" aria-hidden="true"></span> Users
              </.button>
              <.button type="link" navigate={~p"/org/#{entry.org}/settings/keys"}>
                <span class="lucide-key-round size-4" aria-hidden="true"></span>
                <span class="sm:hidden">Keys</span><span class="hidden sm:inline">Signing keys</span>
              </.button>
              <.button type="link" navigate={~p"/org/#{entry.org}/settings"}>
                <span class="lucide-settings size-4" aria-hidden="true"></span> Settings
              </.button>
            </nav>
            <span class="mx-1 hidden h-6 w-px bg-line-default md:block" aria-hidden="true"></span>
            <.button type="link" navigate={~p"/orgs/new"} class="hidden md:flex">
              <span class="lucide-plus size-4" aria-hidden="true"></span> New organization
            </.button>
          </div>
        </header>
      <% else %>
        <header class="flex flex-wrap items-center justify-between gap-6">
          <div>
            <h1 class="text-page-title text-content-strong">Organizations</h1>
            <p class="text-sm text-content-muted">
              {count_noun(length(@orgs), "organization", "organizations")} · {count_noun(@orgs |> Enum.map(&length(&1.products)) |> Enum.sum(), "product", "products")} · {count_noun(
                @orgs |> Enum.map(& &1.device_count) |> Enum.sum(),
                "device",
                "devices"
              )}
            </p>
          </div>
          <.button type="link" navigate={~p"/orgs/new"} class="hidden md:flex">
            <span class="lucide-plus size-4" aria-hidden="true"></span> New organization
          </.button>
        </header>

        <nav
          :if={length(@orgs) >= 3}
          aria-label="Organizations"
          class={["grid grid-cols-2 gap-3 sm:gap-4", if(length(sectioned) == 3, do: "sm:grid-cols-3", else: "lg:grid-cols-4")]}
        >
          <a
            :for={entry <- sectioned}
            href={"#org-#{entry.org.id}"}
            class="flex flex-col rounded-md border border-line-default bg-surface-raised p-4 shadow-card transition-colors hover:border-line-strong"
          >
            <% counts = org_online(@online, entry.org.id) %>
            <% attention = attention_count(@attention, entry.org.id) %>
            <span class="flex items-center justify-between gap-2">
              <span class="truncate text-sm font-medium text-content-strong">{entry.org.name}</span>
              <.badge :if={attention > 0} tone="warning" title="Needs attention">{attention}</.badge>
            </span>
            <span class="pt-3 text-2xl font-medium text-content-strong tabular-nums">{delimited(entry.device_count)}</span>
            <span class="text-xs text-content-muted">
              devices{if counts && entry.device_count > 0, do: " · #{online_percent(counts)}% online"}
            </span>
            <span class="mt-3 h-1 overflow-hidden rounded-full bg-base-800">
              <span :if={counts} class="block h-full rounded-full bg-status-online" style={"width: #{online_percent(counts)}%"}></span>
            </span>
          </a>
        </nav>
      <% end %>

      <.attention_section :if={@attention != nil and @attention != []} items={@attention} single_org?={single_org?} />

      <div :if={@attention == [] or @pinned_devices == []} class="flex flex-col gap-3">
        <.all_clear :if={@attention == []} />

        <div :if={@pinned_devices == []} id="pin-hint" class="flex items-center gap-3 rounded-md border border-dashed border-line-strong px-4 py-3 text-sm text-content-muted">
          <span class="lucide-pin size-4" aria-hidden="true"></span> Pin a device from its page to keep it here
        </div>
      </div>

      <section :if={@pinned_devices != []} id="pinned-devices" aria-labelledby="pinned-title" class="flex flex-col gap-3">
        <h2 id="pinned-title" class="text-group-title text-content-strong">Pinned devices</h2>
        <div class="overflow-hidden rounded-md border border-line-default bg-surface-raised shadow-card">
          <.link
            :for={device <- if @show_all_pinned?, do: @pinned_devices, else: limit_devices(@pinned_devices)}
            id={"pinned-#{device.id}"}
            navigate={~p"/org/#{device.org}/#{device.product}/devices/#{device.identifier}"}
            class="flex items-center gap-3 border-b border-line-subtle px-4 py-3 transition-colors last:border-0 hover:bg-surface-muted md:gap-4"
          >
            <% online? = @device_statuses[device.identifier] == "online" %>
            <% firmware = (device.firmware_metadata && device.firmware_metadata.version) || "—" %>
            <% {label, color} = if online?, do: health_label(device), else: {offline_for(device), "text-content-muted"} %>
            <%!-- On a phone the row is two lines: the identifier and its state, then where it is and
                 its firmware. From md up those are lanes that line up with the products table. --%>
            <span class="flex min-w-0 flex-1 items-start gap-2.5 md:items-center">
              <.status_dot class={["mt-1.5 md:mt-0", if(online?, do: "bg-status-online", else: "bg-status-offline")]} title={if online?, do: "Online", else: "Offline"} />
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="flex items-center justify-between gap-3">
                  <span class="truncate font-mono text-xs/5 text-content-strong">{device.identifier}</span>
                  <span class={["shrink-0 text-sm md:hidden", color]}>{label}</span>
                </span>
                <span class="truncate text-xs text-content-muted md:hidden">
                  {pinned_place(device, single_org?)} · <span class="font-mono">{firmware}</span>
                </span>
              </span>
            </span>
            <span class="hidden w-55 truncate text-sm text-content-muted md:block">{pinned_place(device, single_org?)}</span>
            <span class="hidden w-35 truncate font-mono text-xs text-content-body md:block">{firmware}</span>
            <span class={["hidden w-27.5 truncate text-sm md:block", color]}>{label}</span>
            <span class="lucide-chevron-right size-4 text-content-faint" aria-hidden="true"></span>
          </.link>
          <button
            :if={length(@pinned_devices) > @device_limit}
            type="button"
            phx-click="toggle-expand-devices"
            class="w-full border-t border-line-subtle px-4 py-2 text-center text-xs text-content-muted hover:cursor-pointer hover:text-content-strong"
          >
            {if @show_all_pinned?, do: "Show less", else: "Show all #{length(@pinned_devices)} devices"}
          </button>
        </div>
      </section>

      <%= if single_org? do %>
        <% [entry] = @orgs %>
        <section aria-labelledby="products-title" class="flex flex-col gap-3">
          <div class="flex items-center justify-between gap-4">
            <h2 id="products-title" class="text-group-title text-content-strong">Products</h2>
            <.button :if={authorized?(:"product:create", entry.role)} type="link" navigate={~p"/org/#{entry.org}/new"}>
              <span class="lucide-plus size-4" aria-hidden="true"></span> New product
            </.button>
          </div>
          <.products_table entry={entry} online={@online} fleet={@fleet} />
        </section>
      <% else %>
        <section :for={entry <- sectioned} id={"org-#{entry.org.id}"} aria-labelledby={"org-title-#{entry.org.id}"} class="flex scroll-mt-6 flex-col gap-3">
          <div class="flex items-center gap-3">
            <.link
              navigate={~p"/org/#{entry.org}"}
              class="flex size-8 shrink-0 items-center justify-center rounded border border-line-default bg-surface-raised text-sm font-semibold text-content-strong"
              aria-hidden="true"
              tabindex="-1"
            >
              {monogram(entry.org.name)}
            </.link>
            <div class="flex min-w-0 flex-1 flex-col md:flex-row md:items-center md:gap-3">
              <.link navigate={~p"/org/#{entry.org}"} class="group flex min-w-0 items-center gap-1">
                <h2 id={"org-title-#{entry.org.id}"} class="truncate text-section-title text-content-strong group-hover:underline">{entry.org.name}</h2>
                <span class="lucide-chevron-right size-4 text-content-faint" aria-hidden="true"></span>
              </.link>
              <span class="truncate text-xs text-content-muted md:text-sm">
                {count_noun(length(entry.products), "product", "products")} · {count_noun(entry.device_count, "device", "devices")}
              </span>
            </div>
            <div class="flex shrink-0 items-center gap-2 whitespace-nowrap">
              <.org_actions entry={entry} />
              <.button :if={authorized?(:"product:create", entry.role)} type="link" navigate={~p"/org/#{entry.org}/new"} class="hidden md:flex">
                <span class="lucide-plus size-4" aria-hidden="true"></span> New product
              </.button>
            </div>
          </div>
          <.products_table entry={entry} online={@online} fleet={@fleet} new_product_row />
        </section>

        <section :if={others != []} id="other-orgs" aria-labelledby="other-orgs-title" class="flex flex-col gap-3">
          <h2 id="other-orgs-title" class="text-group-title text-content-strong">Other organizations</h2>
          <div class="overflow-hidden rounded-md border border-line-default bg-surface-raised shadow-card" role="table" aria-label="Other organizations">
            <div
              role="row"
              class="hidden items-center gap-4 border-b border-line-default bg-surface-muted px-4 py-2.5 text-xs font-medium tracking-wide text-content-muted uppercase md:flex"
            >
              <span role="columnheader" class="flex-1">Organization</span>
              <span role="columnheader" class="w-55">Online</span>
              <span role="columnheader" class="w-35">Products</span>
              <span role="columnheader" class="w-27.5">Health</span>
              <span class="w-4" aria-hidden="true"></span>
            </div>
            <.link
              :for={entry <- others}
              role="row"
              id={"other-org-#{entry.org.id}"}
              navigate={~p"/org/#{entry.org}"}
              class="grid grid-cols-[1fr_auto_auto] items-center gap-x-3 gap-y-2.5 border-b border-line-subtle px-4 py-3 transition-colors last:border-0 hover:bg-surface-muted md:flex md:gap-4"
            >
              <span role="cell" class="col-start-1 row-start-1 flex min-w-0 items-center gap-3 md:flex-1">
                <span class="flex size-6 shrink-0 items-center justify-center rounded border border-line-default text-xs font-semibold text-content-strong" aria-hidden="true">
                  {monogram(entry.org.name)}
                </span>
                <span class="truncate text-sm font-medium text-content-strong">{entry.org.name}</span>
              </span>
              <span role="cell" class="col-span-2 col-start-1 row-start-2 md:w-55">
                <.online_meter counts={org_online(@online, entry.org.id)} total={entry.device_count} class="md:w-35" />
              </span>
              <span role="cell" class="hidden w-35 text-sm text-content-body md:block">{length(entry.products)}</span>
              <span role="cell" class="col-start-2 row-start-1 md:w-27.5">
                <.health_chip :if={entry.device_count > 0} health={org_health(@fleet, entry)} />
              </span>
              <span class="col-start-3 row-span-2 row-start-1 lucide-chevron-right size-4 text-content-faint" aria-hidden="true"></span>
            </.link>
          </div>
        </section>
      <% end %>

      <.link
        navigate={~p"/orgs/new"}
        class="flex h-10 items-center justify-center gap-1.5 rounded border border-dashed border-line-strong text-sm font-medium text-content-body hover:text-content-strong md:hidden"
      >
        <span class="lucide-plus size-4" aria-hidden="true"></span> New organization
      </.link>
    </div>
  <% end %>
</NervesHubWeb.Layouts.no_sidebar>
