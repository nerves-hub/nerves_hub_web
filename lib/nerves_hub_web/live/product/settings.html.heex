<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <h1 class="text-page-title text-content-strong">Product Settings</h1>
  </:header>

  <%!-- Separate LiveViews rather than actions of one, so these navigate. --%>
  <:tabbed_nav
    path={~p"/org/#{@current_scope.org}/#{@current_scope.product}/settings"}
    selected={@tab == :general}
    navigate={true}
    label="General"
  />
  <:tabbed_nav
    path={~p"/org/#{@current_scope.org}/#{@current_scope.product}/settings/health"}
    selected={@tab == :health}
    navigate={true}
    label="Device Health"
  />

  <div class="h-0 flex-1 overflow-y-auto">
    <div class="flex flex-col items-start justify-between gap-4 p-6">
      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
          <div class="text-card-title text-content-strong">General settings</div>
        </div>
        <div class="flex gap-6 p-4">
          <div class="flex w-1/2 flex-col gap-6">
            <.input field={@form[:name]} label="Name" hint="Once created, a product name cannot be changed" disabled />
          </div>
        </div>
      </div>

      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
          <div class="text-card-title text-content-strong">Device Extensions</div>
        </div>

        <div class="flex flex-col gap-3 p-4">
          <div class="flex flex-col gap-3">
            <p class="w-2/3 text-sm">
              Device extensions are encapsulated features which use isolated channels for communication. The use of isolated channels ensures that firmware updates are not affected, while allowing NervesHub to manage, monitor, and introspect your fleet.
            </p>
            <p class="w-2/3 text-sm">
              When enabled, NervesHub will request the extensions a device currently supports and then check against product and device settings to see if the extension should be attached to the connection.
            </p>
            <p class="w-2/3 text-sm">
              Extensions most be allowed at the product level. They can also be configured at the device level for more granular control when needed.
            </p>
            <p class="w-2/3 text-sm">
              Enabling or disabling an extension on all devices changes each device's own setting. It takes effect only while the extension is allowed here.
            </p>
          </div>

          <%!-- The buttons wrap below the description when the row is too narrow for both. --%>
          <div :for={{key, description} <- @available_extensions} class="flex min-h-16 flex-wrap items-center gap-x-6 gap-y-3 p-2">
            <div class="flex min-w-0 flex-1 basis-72 items-center gap-6">
              <div class="flex h-8 shrink-0 items-center rounded-full border border-line-default bg-base-800 px-2 py-1">
                <input
                  id={"extension-#{key}"}
                  name={key}
                  type="checkbox"
                  class="rounded border-line-default text-content-muted checked:bg-primary focus:ring-0"
                  phx-click="update-extension"
                  phx-value-extension={key}
                  checked={@product.extensions[key]}
                  disabled={!authorized?(:"product:update", @current_scope)}
                />
              </div>
              <div class="flex min-w-0 flex-col">
                <div class="flex gap-2">
                  <div class="font-medium text-content-body">
                    {Extensions.display_name(key)}
                  </div>
                </div>
                <div class="text-xs text-content-muted">
                  {description}
                </div>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <.button
                id={"enable-extension-#{key}-on-devices"}
                phx-click="set-extension-for-devices"
                phx-value-extension={key}
                phx-value-enabled="true"
                data-confirm={"Enable the #{Extensions.display_name(key)} extension on every device in this product?"}
                disabled={!authorized?(:"device:update", @current_scope)}
              >
                Enable on all devices
              </.button>
              <.button
                id={"disable-extension-#{key}-on-devices"}
                phx-click="set-extension-for-devices"
                phx-value-extension={key}
                phx-value-enabled="false"
                data-confirm={"Disable the #{Extensions.display_name(key)} extension on every device in this product?"}
                disabled={!authorized?(:"device:update", @current_scope)}
              >
                Disable on all devices
              </.button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
          <div class="text-card-title text-content-strong">Device-managed updates</div>
        </div>

        <div class="flex flex-col gap-3 p-4">
          <div class="flex flex-col gap-3">
            <p class="w-2/3 text-sm">
              A device that may choose its own update mode can move itself between automatic and device managed. A device-managed device decides when to take the firmware its deployment group names, rather than having it pushed.
            </p>
          </div>

          <div class="flex min-h-16 items-center gap-6 p-2">
            <div class="flex h-8 shrink-0 items-center rounded-full border border-line-default bg-base-800 px-2 py-1">
              <input
                id="default-managed-updates-allowed"
                name="default-managed-updates-allowed"
                type="checkbox"
                class="rounded border-line-default text-content-muted checked:bg-primary focus:ring-0"
                phx-click="update-default-managed-updates-allowed"
                checked={@product.default_managed_updates_allowed}
                disabled={!authorized?(:"product:update", @current_scope)}
              />
            </div>
            <div class="flex flex-col">
              <div class="font-medium text-content-body">Let new devices choose their update mode</div>
              <div class="text-xs text-content-muted">
                Devices added to this product from now on start with this setting. Existing devices keep their own.
              </div>
            </div>
          </div>

          <div class="flex min-h-16 flex-wrap items-center gap-x-6 gap-y-3 p-2">
            <div class="flex min-w-0 flex-1 basis-72 flex-col">
              <div class="font-medium text-content-body">Existing devices</div>
              <div class="text-xs text-content-muted">
                Change the setting on every device already in this product. Disallowing does not move a device that is already device managed.
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <.button
                id="allow-managed-updates-on-devices"
                phx-click="set-managed-updates-allowed-for-devices"
                phx-value-enabled="true"
                data-confirm="Let every device in this product choose its own update mode?"
                disabled={!authorized?(:"device:toggle-updates", @current_scope)}
              >
                Allow on all devices
              </.button>
              <.button
                id="disallow-managed-updates-on-devices"
                phx-click="set-managed-updates-allowed-for-devices"
                phx-value-enabled="false"
                data-confirm="Stop every device in this product choosing its own update mode?"
                disabled={!authorized?(:"device:toggle-updates", @current_scope)}
              >
                Disallow on all devices
              </.button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
          <div class="text-card-title text-content-strong">Firmware</div>
        </div>

        <div class="flex flex-col gap-3 p-4">
          <div class="flex h-16 items-center gap-6 p-2">
            <div class="flex h-8 items-center rounded-full border border-line-default bg-base-800 px-2 py-1">
              <input
                id="require-unique-firmware-version"
                name="require-unique-firmware-version"
                type="checkbox"
                class="rounded border-line-default text-content-muted checked:bg-primary focus:ring-0"
                phx-click="update-require-unique-firmware-version"
                checked={@product.require_unique_firmware_version}
                disabled={!authorized?(:"product:update", @current_scope)}
              />
            </div>
            <div class="flex flex-col">
              <div class="font-medium text-content-body">Require unique firmware versions</div>
              <div class="text-xs text-content-muted">
                Reject uploaded firmware whose version already exists for this product's platform and architecture.
              </div>
            </div>
          </div>

          <div :for={tool <- @optional_tools} class="flex h-16 items-center gap-6 p-2">
            <div class="flex h-8 items-center rounded-full border border-line-default bg-base-800 px-2 py-1">
              <input
                id={"allow-#{tool.name}-firmware"}
                name={"allow-#{tool.name}-firmware"}
                type="checkbox"
                class="rounded border-line-default text-content-muted checked:bg-primary focus:ring-0"
                phx-click="update-allowed-update-tool"
                phx-value-tool={tool.name}
                checked={Product.accepts_update_tool?(@product, tool.name)}
                disabled={!authorized?(:"product:update", @current_scope)}
              />
            </div>
            <div class="flex flex-col">
              <div class="font-medium text-content-body">Accept {tool.label}</div>
              <div class="text-xs text-content-muted">{tool.description}</div>
            </div>
          </div>

          <div
            :for={tool <- @optional_tools}
            :if={tool[:unsigned_field] && Product.accepts_update_tool?(@product, tool.name)}
            class="flex h-16 items-center gap-6 p-2"
          >
            <div class="flex h-8 items-center rounded-full border border-line-default bg-base-800 px-2 py-1">
              <input
                id={"allow-unsigned-#{tool.name}-firmware"}
                name={"allow-unsigned-#{tool.name}-firmware"}
                type="checkbox"
                class="rounded border-line-default text-content-muted checked:bg-primary focus:ring-0"
                phx-click="update-allow-unsigned"
                phx-value-tool={tool.name}
                checked={Map.get(@product, tool.unsigned_field)}
                disabled={!authorized?(:"product:update", @current_scope)}
              />
            </div>
            <div class="flex flex-col">
              <div class="font-medium text-content-body">{tool.unsigned_label}</div>
              <div class="text-xs text-content-muted">{tool.unsigned_description}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex h-14 items-center justify-between border-b border-line-default px-4">
          <div class="text-card-title text-content-strong">Device Shared Secret Authentication</div>
        </div>

        <div class="flex flex-col gap-3 p-4">
          <div class="flex flex-col gap-3">
            <p class="w-2/3 text-sm">
              Shared Secret authentication allows Devices to connect to Nerves Hub using a shared key and secret.
              When a Device connects for the first time the Device will be registered with the Product ("Just-in-Time registration").
            </p>
            <p class="w-2/3 text-sm">
              This authentication strategy is useful for small deployments of Devices, or when prototyping a new Product.
            </p>
            <p class="w-2/3 text-sm">
              We highly recommend using Device Certificates for situations where security is paramount.
            </p>
            <p class="w-2/3 text-sm">
              Please refer to the <.link class="underline" navigate="https://docs.nerves-hub.org/nerves-hub-link/shared-secrets">documentation</.link>
              on how to configure this with <.link class="underline" navigate="https://github.com/nerves-hub/nerves_hub_link">NervesHubLink</.link>.
            </p>
          </div>
        </div>

        <%= if @shared_auth_enabled do %>
          <div :if={Enum.any?(@shared_secrets)} class="listing flex flex-col gap-3 pt-6">
            <table>
              <thead class="border-y border-line-default">
                <tr>
                  <th>Key</th>
                  <th>Created at</th>
                  <th>Deactivated at</th>
                  <th class="min-w-60"></th>
                </tr>
              </thead>
              <tr :for={auth <- @shared_secrets} class="item">
                <td>
                  <code>{auth.key}</code>
                </td>
                <td>
                  <.local_datetime at={auth.inserted_at} time_zone={@time_zone} format={:date} zone_label={false} />
                </td>
                <td>
                  <.local_datetime at={auth.deactivated_at} time_zone={@time_zone} format={:date} zone_label={false} />
                </td>
                <td>
                  <div :if={is_nil(auth.deactivated_at)} class="flex h-full items-center justify-start gap-3">
                    <%!-- Left out rather than disabled: the secret lets a device connect and register itself, so it is only sent to members who could manage it. --%>
                    <input :if={authorized?(:"product:update", @current_scope)} type="hidden" id={"shared-secret-#{auth.id}"} value={auth.secret} />

                    <.button
                      :if={authorized?(:"product:update", @current_scope)}
                      value={auth.id}
                      id={"shared-secret-#{auth.id}-button"}
                      phx-hook="SharedSecretClipboardClick"
                      aria-label="Copy secret"
                    >
                      Copy secret
                    </.button>

                    <.button
                      phx-click="deactivate-shared-secret"
                      phx-value-shared_secret_id={auth.id}
                      disabled={!authorized?(:"product:update", @current_scope)}
                      data-confirm="Are you sure you want to deactivate this shared secret?"
                      aria-label="Deactivate secret"
                    >
                      Deactivate
                    </.button>
                  </div>
                </td>
              </tr>
            </table>
          </div>

          <div :if={Enum.empty?(@shared_secrets)} class="flex flex-col gap-3 border-t border-line-default p-4">
            <div class="flex flex-col gap-3">
              <p class="w-2/3 text-sm text-warning">
                You don't have any Shared Secrets configured.
              </p>
            </div>
          </div>

          <div class="flex border-t border-line-default p-4">
            <.button
              phx-click="add-shared-secret"
              disabled={!authorized?(:"product:update", @current_scope)}
              data-confirm="Are you sure you want to generate a new Shared Secret?"
              aria-label="Create a Shared Secret"
            >
              <.icon name="add" />Create a Shared Secret
            </.button>
          </div>
        <% else %>
          <div class="flex flex-col gap-3 border-t border-line-default p-4">
            <div class="flex flex-col gap-3">
              <p class="w-2/3 text-sm text-warning">
                Shared Secret authentication hasn't been enabled for your platform.
              </p>
              <p class="w-2/3 text-sm text-warning">
                Please contact your system admin.
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex w-full flex-col rounded-card border border-line-default bg-surface-raised">
        <div class="flex items-center gap-6 border-t border-line-default p-4">
          <div>
            <.button
              style="danger"
              type="button"
              phx-click="delete-product"
              data-confirm="Are you sure you want to delete this product? This action cannot be undone."
              disabled={!authorized?(:"product:delete", @current_scope)}
            >
              <span class="lucide-trash size-4 text-alert" aria-hidden="true"></span>
              <span class="text-sm font-medium text-alert">Delete product</span>
            </.button>
          </div>
          <div>
            Important: This action cannot be undone.
          </div>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
