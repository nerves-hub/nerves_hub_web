<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <%!-- One bar from sm up: the title and fleet size on the left, when the
        page was read and the auto refresh switch on the right. A phone gets
        the title in the page instead, under the layout's own bar. --%>
  <:top_bar>
    <div class="flex items-baseline gap-3 max-sm:hidden">
      <h1 class="text-base/6 font-semibold text-content-strong">Insights</h1>
      <span id="device-count" class="font-mono text-xs text-content-faint">
        {delimited(@fleet_size)} {if(@fleet_size == 1, do: "device", else: "devices")}
      </span>
    </div>
    <div class="mr-6 flex items-center gap-4 max-sm:hidden">
      <.updated_at updated_at={@updated_at} id="health-last-updated" />
      <.switch id="auto-refresh" label="Auto refresh" checked={!is_nil(@polling_pid)} phx-click="toggle-auto-refresh" />
    </div>
  </:top_bar>

  <div :if={@fleet_size > 0} class="flex h-0 flex-1 flex-col gap-3.5 overflow-y-auto px-4 pt-5 pb-10 sm:gap-10 sm:p-8 sm:pb-16">
    <div class="-mx-4 -mt-5 flex flex-col gap-1.5 border-b border-line-subtle px-4 pt-4 pb-3.5 sm:hidden">
      <div class="flex min-w-0 items-center gap-1.5 text-xs">
        <span class="truncate text-content-muted">{@current_scope.org.name}</span>
        <span class="text-content-faint">/</span>
        <span class="truncate font-medium text-content-strong">{@current_scope.product.name}</span>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <div class="flex items-baseline gap-2">
          <h1 class="text-xl/7 font-semibold tracking-[-0.01em] text-content-strong">Insights</h1>
          <span class="font-mono text-xs text-content-muted">
            {delimited(@fleet_size)} {if(@fleet_size == 1, do: "device", else: "devices")}
          </span>
        </div>
        <.updated_at updated_at={@updated_at} id="updated-at-phone" />
      </div>
    </div>

    <FleetComposition.bars composition={@composition} rows={@version_rows} unit={@composition_unit} devices_path={@devices_path} />

    <%!-- Side by side once the table (787px) and a card of at least 340px
         fit; under that the card goes first, and the table becomes a list. --%>
    <div class="@container">
      <div class="flex flex-col gap-6 @min-[1167px]:flex-row @min-[1167px]:items-start @min-[1167px]:gap-10">
        <FleetComposition.version_table composition={@composition} rows={@version_rows} stands_out={@stands_out} devices_path={@devices_path} />
        <div :if={@stands_out} class="order-first @min-[1167px]:order-0 @min-[1167px]:mt-8 @min-[1167px]:min-w-0 @min-[1167px]:flex-1">
          <FleetComposition.stands_out stands_out={@stands_out} composition={@composition} devices_path={@devices_path} />
        </div>
      </div>
    </div>

    <FleetTrends.row :if={@trends} trends={@trends} period={@trends_period} composition={@composition} rows={@version_rows} adoption_view={@adoption_view} releases={@release_annotations} />

    <%!-- Side by side once three columns of about 240px fit; under that,
          one after another. --%>
    <div class="@container">
      <div id="insights-lists" class="flex flex-col gap-7 @min-[787px]:flex-row @min-[787px]:gap-10">
        <.list_column id="failing-updates" title="Failing updates" meta={devices_count(@failing_count)}>
          <.list_row :for={device <- @failing_devices} navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/#{device.identifier}"}>
            <span class="min-w-0 flex-1 truncate font-mono text-content-strong max-sm:text-ui/4.5">{device.identifier}</span>
            <span class="w-16 shrink-0 text-right font-mono text-alert-content">{device.consecutive_failed_updates} failed</span>
            <span class="w-14 shrink-0 text-right text-content-faint max-sm:w-16">{failing_for(device)}</span>
          </.list_row>
          <.list_empty :if={@failing_devices == []}>No devices are failing to update</.list_empty>
          <:footer :if={@failing_count > length(@failing_devices)}>
            <span class="flex-1 text-content-muted">{@failing_count - length(@failing_devices)} more</span>
            <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?updates=failed-updates"} class="text-content-muted hover:text-content-strong">
              View all →
            </.link>
          </:footer>
        </.list_column>

        <.list_column :if={@flapping_enabled} id="flapping" title="Flapping" meta="last hour">
          <.list_row :for={{entry, index} <- Enum.with_index(@flapping)} navigate={entry.path} class={index >= 3 && "max-sm:hidden"}>
            <span class="min-w-0 flex-1 truncate font-mono text-content-strong max-sm:text-ui/4.5">{entry.device.identifier}</span>
            <span class="w-20 shrink-0 text-content-muted max-sm:w-auto">{entry.kind}</span>
            <span class="w-12 shrink-0 text-right font-mono text-content-strong">{entry.count}/h</span>
          </.list_row>
          <.list_empty :if={@flapping == []}>Nothing has flapped in the last hour</.list_empty>
          <:footer :if={length(@flapping) > 3} class="sm:hidden">
            <span class="flex-1 text-content-muted">{length(@flapping) - 3} more</span>
          </:footer>
        </.list_column>

        <.list_column id="notifications" title="Notifications" meta={@notification_count}>
          <.list_row :for={entry <- @notifications}>
            <span data-level={entry.level} class="size-1.5 shrink-0 rounded-full bg-(--color-chart-other) data-[level=error]:bg-(--color-chart-alert) data-[level=warning]:bg-(--color-chart-4)"></span>
            <span class="min-w-0 flex-1 truncate text-content-strong">
              {entry.title}<span :if={entry.occurrence_count > 1} class="font-mono text-content-faint"> ×{delimited(entry.occurrence_count)}</span>
            </span>
            <span class="shrink-0 text-content-faint">{occurred(entry.last_occurred_at, @time_zone)}</span>
          </.list_row>
          <.list_empty :if={@notifications == []}>No notifications</.list_empty>
          <:footer :if={@notification_count > length(@notifications)}>
            <span class="flex-1 text-content-muted">{@notification_count - length(@notifications)} more</span>
            <.link navigate={~p"/org/#{@current_scope.org}/#{@product}/notifications"} class="text-content-muted hover:text-content-strong">
              View all →
            </.link>
          </:footer>
        </.list_column>
      </div>
    </div>
  </div>

  <div :if={@fleet_size == 0} class="flex h-0 flex-1 items-center justify-center overflow-y-auto pb-16">
    <div class="w-full max-w-2xl px-6">
      <h2 class="mb-4 text-page-title text-content-strong">{@product.name} doesn't have any devices yet.</h2>
      <p class="mb-6 text-sm text-content-muted">Get started by adding <code class="text-content-body">nerves_hub_link</code> to your Nerves project.</p>
      <% active_secret = Enum.find(@product.shared_secret_auths, &is_nil(&1.deactivated_at)) %>
      <%!-- The secret lets a device connect and register itself, so only members who could manage it are shown it. --%>
      <%= if active_secret && authorized?(:"product:update", @current_scope) do %>
        <div class="rounded-card border border-line-default bg-surface-raised p-4">
          <h3 class="mb-3 text-group-title text-content-strong">1. Add the dependency to your <code>mix.exs</code></h3>
          <pre class="mb-4 overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-success-content"><code>&#123;:nerves_hub_link, "~&gt; 2.0"&#125;</code></pre>

          <h3 class="mb-3 text-group-title text-content-strong">2. Add this to your <code>config/config.exs</code></h3>
          <pre class="overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-success-content"><code>config :nerves_hub_link,
host: "{onboarding_nhl_host()}",
remote_iex: true,
shared_secret: [
product_key: "{active_secret.key}",
product_secret: "{active_secret.secret}"
]</code></pre>

          <p class="mt-4 text-xs text-content-faint">
            See the <a class="text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a> for more details.
          </p>
        </div>
      <% else %>
        <p class="text-sm text-content-muted">
          Check the <a class="text-content-body underline hover:text-base-200" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a>
          for how to connect your first device.
        </p>
      <% end %>

      <div class="mt-6 rounded-card border border-line-subtle bg-surface-muted p-4">
        <h3 class="mb-2 text-group-title text-content-strong">Production authentication</h3>
        <p class="text-xs text-content-muted">
          For production applications, we recommend mTLS authentication using a local certificate or dedicated secure hardware.
        </p>
        <div class="mt-2 flex gap-4">
          <a class="text-xs text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.LocalCert.html" target="_blank">
            LocalCert configurator
          </a>
          <a class="text-xs text-content-muted underline hover:text-content-body" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.NervesKey.html" target="_blank">
            NervesKey configurator
          </a>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
