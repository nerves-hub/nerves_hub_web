<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:header>
    <div class="flex w-full justify-between">
      <div class="flex items-center gap-4">
        <h1 class="text-xl leading-[30px] font-semibold text-base-50">Insights</h1>
        <div
          id="device-count"
          class="mr-auto rounded-sm bg-base-800 px-1.5 py-0.5 text-xs text-base-300"
        >
          {Number.Delimit.number_to_delimited(@fleet_size, precision: 0)} {if(@fleet_size == 1, do: "device", else: "devices")}
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1 text-xs tracking-wide text-base-500">
          <span class="lucide-clock--light size-4 shrink"></span>
          <span class="font-normal">Updated</span>
          <time class="font-normal" id="health-last-updated" phx-hook="UpdatingTimeAgo" datetime={String.replace(DateTime.to_string(DateTime.truncate(@updated_at, :second)), " ", "T")}>
            {Timex.from_now(@updated_at)}
          </time>
        </div>
        <div class="text-xs tracking-wide text-base-300">Auto refresh</div>
        <div>
          <button
            type="button"
            phx-click="toggle-auto-refresh"
            class={[
              "border-1.5 relative inline-flex h-3.5 w-6 shrink-0 cursor-pointer items-center rounded-full border-transparent transition-colors duration-200 ease-in-out focus:ring-1 focus:ring-focus-ring focus:ring-offset-2 focus:outline-none",
              (@polling_pid && "bg-primary") || "bg-gray-200"
            ]}
            role="switch"
            aria-checked="false"
          >
            <span class="sr-only">Auto refresh health information</span>
            <span
              aria-hidden="true"
              class={[
                "pointer-events-none inline-block size-3",
                (@polling_pid && "translate-x-3") || "translate-x-0",
                "transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
              ]}
            ></span>
          </button>
        </div>
      </div>
    </div>
  </:header>

  <div :if={@fleet_size > 0} class="flex h-0 flex-1 flex-col gap-4 overflow-y-auto p-6">
    <div class="grid h-[132px] grid-cols-4 gap-4">
      <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?connection=connected"}>
        <div class="relative flex h-[132px] flex-col overflow-hidden rounded border border-base-700 bg-surface-raised px-5 py-4.5 shadow-device-details-content">
          <div class="absolute inset-y-0 left-0 w-[3.5px] bg-success"></div>
          <div class="mb-3.5 flex items-center gap-2">
            <span class="size-1.5 shrink rounded-full bg-success"></span>
            <span class="font-sans text-sm text-content-muted">Online now</span>
          </div>
          <div id="online-count" phx-hook="CrossFadeOnUpdate" class="font-mono text-3xl leading-none tracking-tight text-content-strong">
            {if @online_count.ok?, do: Number.Delimit.number_to_delimited(@online_count.result, precision: 0), else: "—"}
          </div>
          <div id="online-percentage" phx-hook="CrossFadeOnUpdate" class="mt-2 font-mono text-sm text-success-content">
            {if @online_count.ok?, do: "#{percentage(@online_count.result, @fleet_size)}% of fleet", else: "—"}
          </div>
        </div>
      </.link>

      <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?connection=disconnected"}>
        <div class="relative flex h-[132px] flex-col overflow-hidden rounded border border-base-700 bg-surface-raised px-5 py-4.5 shadow-device-details-content">
          <div class="absolute inset-y-0 left-0 w-[3.5px] bg-base-600"></div>
          <div class="mb-3.5 flex items-center gap-2">
            <span class="size-1.5 shrink rounded-full bg-base-600"></span>
            <span class="font-sans text-sm text-content-muted">Offline</span>
          </div>
          <div id="offline-count" phx-hook="CrossFadeOnUpdate" class="font-mono text-3xl leading-none tracking-tight text-content-strong">
            {if @offline_count.ok?, do: Number.Delimit.number_to_delimited(@offline_count.result, precision: 0), else: "—"}
          </div>
          <div id="offline-percentage" phx-hook="CrossFadeOnUpdate" class="mt-2 font-mono text-sm text-base-400">
            {if @offline_count.ok?, do: "#{percentage(@offline_count.result, @fleet_size)}% of fleet", else: "—"}
          </div>
        </div>
      </.link>

      <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?connection=not_seen_in_seven_days"}>
        <div class="relative flex h-[132px] flex-col overflow-hidden rounded border border-base-700 bg-surface-raised px-5 py-4.5 shadow-device-details-content">
          <div class="absolute inset-y-0 left-0 w-[3.5px] bg-warning"></div>
          <div class="mb-3.5 flex items-center gap-2">
            <span class="lucide-clock-alert--light size-4 shrink text-warning"></span>
            <span class="font-sans text-sm text-content-muted">Not seen in 7 days</span>
          </div>
          <div id="not-seen-7-days-count" phx-hook="CrossFadeOnUpdate" class="font-mono text-3xl leading-none tracking-tight text-content-strong">
            {if @not_seen_in_7_days.ok?, do: Number.Delimit.number_to_delimited(@not_seen_in_7_days.result, precision: 0), else: "—"}
          </div>
          <div id="not-seen-7-days-percentage" phx-hook="CrossFadeOnUpdate" class="mt-2 font-mono text-sm text-warning-content">
            {if @not_seen_in_7_days.ok?, do: "#{percentage(@not_seen_in_7_days.result, @fleet_size)}% of fleet", else: "—"}
          </div>
        </div>
      </.link>
      <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?connection=not_seen_in_fourteen_days"}>
        <div class="relative flex h-[132px] flex-col overflow-hidden rounded border border-base-700 bg-surface-raised px-5 py-4.5 shadow-device-details-content">
          <div class="absolute inset-y-0 left-0 w-[3.5px] bg-danger"></div>
          <div class="mb-3.5 flex items-center gap-2">
            <span class="lucide-triangle-alert--light size-4 shrink text-danger"></span>
            <span class="font-sans text-sm text-content-muted">Not seen in 14 days</span>
          </div>
          <div id="not-seen-14-days-count" phx-hook="CrossFadeOnUpdate" class="font-mono text-3xl leading-none tracking-tight text-content-strong">
            {if @not_seen_in_14_days.ok?, do: Number.Delimit.number_to_delimited(@not_seen_in_14_days.result, precision: 0), else: "—"}
          </div>
          <div id="not-seen-14-days-percentage" phx-hook="CrossFadeOnUpdate" class="mt-2 font-mono text-sm text-danger">
            {if @not_seen_in_14_days.ok?, do: "#{percentage(@not_seen_in_14_days.result, @fleet_size)}% of fleet", else: "—"}
          </div>
        </div>
      </.link>
    </div>

    <div :if={@device_connections_graph_enabled} class="flex flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
      <div class="flex justify-between">
        <div class="flex items-center leading-6 font-medium text-base-50">
          Connected Device History
        </div>

        <div id="connected-devices-period" role="tablist" class="border-t-default inline-flex gap-0.5 rounded-md border border-b-default bg-surface-muted p-0.5">
          <button
            role="tab"
            data-selected={@connected_devices_period == :twenty_four_hours}
            phx-click="select-graph-time-period"
            phx-value-period="twenty_four_hours"
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >Last 24 hours</button>
          <button
            role="tab"
            data-selected={@connected_devices_period == :fourteen_days}
            phx-click="select-graph-time-period"
            phx-value-period="fourteen_days"
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >14 days</button>
          <button
            role="tab"
            phx-click="select-graph-time-period"
            phx-value-period="four_weeks"
            data-selected={@connected_devices_period == :four_weeks}
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >4 weeks</button>
        </div>
      </div>

      <div class="h-[160px] grow">
        <canvas
          id={"daily-device-counts-chart-#{@connected_devices_period}"}
          phx-hook="BarChart"
          phx-update="ignore"
          data-metrics={Jason.encode!(@device_connections_graph_data)}
          data-title=""
          data-mindate={Jason.encode!(@device_connections_graph_from)}
          data-maxdate={Jason.encode!(@device_connections_graph_to)}
          data-unit={@device_connections_graph_unit}
          data-period={@connected_devices_period}
        ></canvas>
      </div>
    </div>

    <div :if={@update_outcomes_graph_enabled} class="flex flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
      <div class="flex justify-between">
        <div class="flex items-center">
          <div class="flex items-center leading-6 font-medium text-base-50">
            Firmware Update History
          </div>
          <div class="relative z-20 ml-4" id="update-outcomes-tooltip" phx-hook="ToolTip" data-placement="top">
            <span class="lucide-info--light size-4" />
            <div class="tooltip-content absolute top-0 left-0 z-20 hidden w-72 rounded border border-base-700 bg-surface-muted px-2 py-1.5 text-xs">
              <p class="pb-2">Every firmware update attempt that finished, counted on the day it finished.</p>
              <p class="pb-2">A failure is a device that did not end up running the firmware it was sent: it reported an error, refused it, stopped partway, or came back on its old firmware.</p>
              <p>A device that asked for the update to come back later is deferring rather than failing, and is not counted here.</p>
              <div class="tooltip-arrow absolute size-2 origin-center rotate-45 border-base-700 bg-surface-muted"></div>
            </div>
          </div>
        </div>

        <div id="update-outcomes-period" role="tablist" class="border-t-default inline-flex gap-0.5 rounded-md border border-b-default bg-surface-muted p-0.5">
          <button
            role="tab"
            data-selected={@update_outcomes_period == :twenty_four_hours}
            phx-click="select-update-graph-time-period"
            phx-value-period="twenty_four_hours"
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >Last 24 hours</button>
          <button
            role="tab"
            data-selected={@update_outcomes_period == :fourteen_days}
            phx-click="select-update-graph-time-period"
            phx-value-period="fourteen_days"
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >14 days</button>
          <button
            role="tab"
            data-selected={@update_outcomes_period == :four_weeks}
            phx-click="select-update-graph-time-period"
            phx-value-period="four_weeks"
            class="cursor-pointer appearance-none rounded-sm border-0 bg-transparent px-3 py-1.5 text-xs leading-none font-medium whitespace-nowrap text-content-muted shadow-none transition-colors duration-120 hover:bg-indigo-500/80 hover:text-white data-selected:bg-indigo-500 data-selected:font-semibold data-selected:text-white data-selected:shadow-[0_1px_2px_rgba(0,0,0,0.18)]"
          >4 weeks</button>
        </div>
      </div>

      <div class="h-[160px] grow">
        <canvas
          id={"update-outcomes-chart-#{@update_outcomes_period}"}
          phx-hook="UpdateOutcomesChart"
          phx-update="ignore"
          data-buckets={Jason.encode!(@update_outcomes_graph_data)}
          data-mindate={Jason.encode!(@update_outcomes_graph_from)}
          data-maxdate={Jason.encode!(@update_outcomes_graph_to)}
          data-unit={@update_outcomes_graph_unit}
          data-period={@update_outcomes_period}
        ></canvas>
      </div>

      <%!-- The legend carries identity and the totals, so neither rests on colour alone. --%>
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="size-2.5 shrink-0 rounded-full bg-success"></span>
          <span class="text-sm text-content-muted">Successful</span>
          <span id="update-outcomes-succeeded" class="font-mono text-sm text-content-strong">
            {Number.Delimit.number_to_delimited(@update_outcomes_succeeded, precision: 0)}
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="size-2.5 shrink-0 rounded-full bg-danger"></span>
          <span class="text-sm text-content-muted">Failed</span>
          <span id="update-outcomes-failed" class="font-mono text-sm text-content-strong">
            {Number.Delimit.number_to_delimited(@update_outcomes_failed, precision: 0)}
          </span>
        </div>
        <div
          :if={@update_outcomes_succeeded + @update_outcomes_failed > 0}
          id="update-outcomes-failure-rate"
          class="ml-auto font-mono text-sm text-content-muted"
        >
          {percentage(@update_outcomes_failed, @update_outcomes_succeeded + @update_outcomes_failed)}% of attempts failed
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex items-center leading-6 font-medium text-base-50">
            Fleet Health
          </div>
          <div class="flex h-3 gap-0.5 overflow-hidden rounded-full">
            <div :if={@healthy_count > 0} class="bg-success" style={"width: #{@healthy_count / @total_health_count * 100}%;"}></div>
            <div :if={@warning_count > 0} class="bg-warning" style={"width: #{@warning_count / @total_health_count * 100}%;"}></div>
            <div :if={@unhealthy_count > 0} class="bg-danger" style={"width: #{@unhealthy_count / @total_health_count * 100}%;"}></div>
            <div :if={@unknown_count > 0} class="bg-base-600" style={"width: #{@unknown_count / @total_health_count * 100}%;"}></div>
          </div>
          <div class="flex flex-col divide-y divide-b-subtle">
            <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?health_status=healthy"}>
              <div class="group flex items-center gap-3 py-3">
                <span title="healthy"><.icon name="healthy" /></span>
                <span class="flex-1 text-sm text-content-body group-hover:underline">Healthy</span>
                <span class="text-right font-mono text-sm text-content-strong">{@healthy_count}</span>
                <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(@healthy_count, @total_health_count)}%</span>
              </div>
            </.link>
            <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?health_status=warning"}>
              <div class="group flex items-center gap-3 py-3">
                <span title="warning"><.icon name="warning" /></span>
                <span class="flex-1 text-sm text-content-body group-hover:underline">Warning</span>
                <span class="text-right font-mono text-sm text-content-strong">{@warning_count}</span>
                <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(@warning_count, @total_health_count)}%</span>
              </div>
            </.link>
            <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?health_status=unhealthy"}>
              <div class="group flex items-center gap-3 py-3">
                <span title="unhealthy"><.icon name="unhealthy" /></span>
                <span class="flex-1 text-sm text-content-body group-hover:underline">Unhealthy</span>
                <span class="text-right font-mono text-sm text-content-strong">{@unhealthy_count}</span>
                <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(@unhealthy_count, @total_health_count)}%</span>
              </div>
            </.link>
            <.link navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?health_status=unknown"}>
              <div class="group flex items-center gap-3 py-3">
                <span title="unknown"><.icon name="unknown" /></span>
                <span class="flex-1 text-sm text-content-body group-hover:underline">Unknown</span>
                <span class="text-right font-mono text-sm text-content-strong">{@unknown_count}</span>
                <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(@unknown_count, @total_health_count)}%</span>
              </div>
            </.link>
          </div>
        </div>

        <div :if={@flapping_connections_enabled} class="flex flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex justify-between">
            <div class="flex items-center leading-6 font-medium text-base-50">
              Flapping Connections
            </div>
            <div class="relative z-20 ml-4" id="flapping-connections-tooltip" phx-hook="ToolTip" data-placement="top">
              <span class="lucide-info--light size-4" />
              <div class="tooltip-content absolute top-0 left-0 z-20 hidden w-max rounded border border-base-700 bg-surface-muted px-2 py-1.5 text-xs">
                <p class="pb-2">Devices that have reconnected 10 times or more in the last hour.</p>
                <p>
                  These devices might have issues with connection stability, <br />or underlying errors which are causing the devices to crash.
                </p>
                <div class="tooltip-arrow absolute size-2 origin-center rotate-45 border-base-700 bg-surface-muted"></div>
              </div>
            </div>
          </div>
          <div class="flex flex-col divide-y divide-b-subtle">
            <.link
              :for={{device, connection_count} <- @flapping_connections}
              :if={Enum.any?(@flapping_connections)}
              navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/#{device.identifier}"}
            >
              <div class="group flex items-center gap-3 py-3">
                <span class="flex-1 font-mono text-sm text-content-body group-hover:underline">{device.identifier}</span>
                <span class="text-right font-mono text-sm text-content-strong">{connection_count} p/hour</span>
              </div>
            </.link>
            <div :if={Enum.empty?(@flapping_connections)} class="inline-flex h-20 items-center justify-center">
              <span class="font-mono text-content-faint">No flapping connections detected</span>
            </div>
          </div>
        </div>
        <div :if={@flapping_health_enabled} class="flex flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex justify-between">
            <div class="flex items-center leading-6 font-medium text-base-50">
              Flapping Health
            </div>
            <div class="relative z-20 ml-4" id="flapping-health-tooltip" phx-hook="ToolTip" data-placement="top">
              <span class="lucide-info--light size-4" />
              <div class="tooltip-content absolute top-0 left-0 z-20 hidden w-max rounded border border-base-700 bg-surface-muted px-2 py-1.5 text-xs">
                <p class="pb-2">Devices whose health has crossed into warning or unhealthy more than 5 times in the last hour.</p>
                <p>
                  A device sitting steadily unhealthy is not here — these are the ones <br />changing their mind, which usually means a
                  threshold sits right where <br />the metric normally runs.
                </p>
                <div class="tooltip-arrow absolute size-2 origin-center rotate-45 border-base-700 bg-surface-muted"></div>
              </div>
            </div>
          </div>
          <div class="flex flex-col divide-y divide-b-subtle">
            <.link
              :for={{device, change_count} <- @flapping_health}
              :if={Enum.any?(@flapping_health)}
              navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/#{device.identifier}/health"}
            >
              <div class="group flex items-center gap-3 py-3">
                <span class="flex-1 font-mono text-sm text-content-body group-hover:underline">{device.identifier}</span>
                <span class="text-right font-mono text-sm text-content-strong">{change_count} p/hour</span>
              </div>
            </.link>
            <div :if={Enum.empty?(@flapping_health)} class="inline-flex h-20 items-center justify-center">
              <span class="font-mono text-content-faint">No flapping health detected</span>
            </div>
          </div>
        </div>

        <%!-- <div class="bg-surface-raised border-base-700 shadow-device-details-content flex h-[132px] flex-col rounded border">
          <div class="text-base-50 flex h-14 items-center pr-3 pl-4 leading-6 font-medium">
            Device Alarms
          </div>
        </div> --%>
      </div>

      <div class="flex flex-col gap-4">
        <div class="flex h-fit grow-0 flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <div class="leading-6 font-medium text-base-50">
                Failed Firmware Updates <span class="ml-2.5 inline-flex items-center gap-1.5 rounded-full border border-b-default py-0.5 pr-2.5 pl-2 text-xs/4 tracking-tight">{@failing_count}</span>
              </div>
              <div class="relative z-20 ml-4" id="failing-updates-tooltip" phx-hook="ToolTip" data-placement="top">
                <span class="lucide-info--light size-4" />
                <div class="tooltip-content absolute top-0 left-0 z-20 hidden w-72 rounded border border-base-700 bg-surface-muted px-2 py-1.5 text-xs">
                  <p class="pb-2">Devices that are failing to take their firmware, and are blocked from trying again for now.</p>
                  <p class="pb-2">The count is attempts in a row that ended without the device running the firmware it was sent, since the last time it did.</p>
                  <p>Beside it is how long that run has been going: an afternoon is bad luck, a fortnight is a device that will not fix itself.</p>
                  <div class="tooltip-arrow absolute size-2 origin-center rotate-45 border-base-700 bg-surface-muted"></div>
                </div>
              </div>
            </div>

            <.link
              :if={Enum.any?(@failing_devices)}
              navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?updates=failed-updates"}
              class="flex items-center gap-1.5 text-xs text-content-muted"
            >
              All <span class="lucide-chevron-right--light size-4"></span>
            </.link>
          </div>

          <div class="flex flex-col divide-y divide-b-subtle">
            <.link
              :for={device <- @failing_devices}
              navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices/#{device.identifier}"}
            >
              <div class="group flex items-center gap-3 py-3">
                <span class="min-w-0 flex-1 truncate font-mono text-sm text-content-body group-hover:underline">{device.identifier}</span>
                <span class="w-24 shrink-0 text-right font-mono text-sm text-content-strong">{device.consecutive_failed_updates} failed</span>
                <span class="w-32 shrink-0 truncate text-right font-mono text-xs text-content-muted">{failing_duration(device)}</span>
              </div>
            </.link>
            <div :if={Enum.empty?(@failing_devices)} class="inline-flex h-20 items-center justify-center">
              <span class="font-mono text-content-faint">No devices are failing to update</span>
            </div>
          </div>
        </div>

        <div class="flex h-fit grow-0 flex-col gap-4.5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex items-center justify-between">
            <div class="leading-6 font-medium text-base-50">
              Notifications <span class="ml-2.5 inline-flex items-center gap-1.5 rounded-full border border-b-default py-0.5 pr-2.5 pl-2 text-xs/4 tracking-tight">{@notification_count}</span>
            </div>

            <.link
              :if={Enum.any?(@notifications)}
              navigate={~p"/org/#{@current_scope.org}/#{@product}/notifications"}
              class="flex items-center gap-1.5 text-xs text-content-muted"
            >
              All <span class="lucide-chevron-right--light size-4"></span>
            </.link>
          </div>

          <div :if={Enum.empty?(@notifications)} class="flex h-[200px] flex-col items-center justify-center gap-2 font-mono text-content-faint">
            <div>You have no notifications</div>
            <div>Nothing to see here</div>
          </div>
          <div :if={Enum.any?(@notifications)} class="flex flex-col divide-y divide-b-subtle">
            <div :for={entry <- @notifications} class="flex items-center gap-2.5 py-2.5">
              <span data-level={entry.level} class="size-2 shrink-0 rounded-full data-[level=error]:bg-alert data-[level=info]:bg-notice data-[level=warning]:bg-warning/85"></span>
              <div class="min-w-0 flex-[1_1_0%]">
                <div class="truncate font-mono text-sm font-normal">
                  {entry.title}
                </div>
                <div class="font-mono text-xs text-content-faint">
                  {Number.Delimit.number_to_delimited(entry.occurrence_count, precision: 0)} {if entry.occurrence_count == 1, do: "occurrence", else: "occurrences"}
                </div>
              </div>
              <span class="shrink-0 text-xs text-content-muted">{Timex.from_now(entry.last_occurred_at)}</span>
            </div>
          </div>
        </div>

        <div class="flex h-fit grow-0 flex-col gap-5 rounded border border-base-700 bg-surface-raised p-5 shadow-device-details-content">
          <div class="flex items-center justify-between">
            <div class="leading-6 font-medium text-base-50">
              Firmware Versions <span class="ml-2.5 inline-flex items-center gap-1.5 rounded-full border border-b-default py-0.5 pr-2.5 pl-2 text-xs/4 tracking-tight">{@firmware_version_count}</span>
            </div>
            <div class="relative z-20 ml-4" id="firmware-versions-tooltip" phx-hook="ToolTip" data-placement="top">
              <span class="lucide-info--light size-4" />
              <div class="tooltip-content absolute top-0 left-0 z-20 hidden w-64 rounded border border-base-700 bg-surface-muted px-2 py-1.5 text-xs">
                <p>The firmware version each device last reported, not the version its deployment group is on. Select a version to see those devices.</p>
                <div class="tooltip-arrow absolute size-2 origin-center rotate-45 border-base-700 bg-surface-muted"></div>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-6">
            <div class="size-[168px] shrink-0">
              <canvas
                id="firmware-versions-chart"
                phx-hook="DonutChart"
                phx-update="ignore"
                data-slices={Jason.encode!(@firmware_version_slices)}
              ></canvas>
            </div>

            <div class="flex min-w-0 flex-1 flex-col divide-y divide-b-subtle">
              <.link
                :for={{slice, index} <- Enum.with_index(@firmware_version_slices)}
                :if={slice.filter}
                navigate={~p"/org/#{@current_scope.org}/#{@current_scope.product}/devices?firmware_version=#{slice.filter}"}
              >
                <div class="group flex items-center gap-3 py-2.5">
                  <span class="size-2.5 shrink-0 rounded-full" style={"background-color: #{firmware_version_color(index)}"}></span>
                  <span class="min-w-0 flex-1 truncate font-mono text-sm text-content-body group-hover:underline">{slice.label}</span>
                  <span class="text-right font-mono text-sm text-content-strong">{slice.count}</span>
                  <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(slice.count, @firmware_version_total)}%</span>
                </div>
              </.link>

              <div :if={@firmware_version_other} class="flex items-center gap-3 py-2.5">
                <span class="size-2.5 shrink-0 rounded-full" style="background-color: var(--color-chart-other)"></span>
                <span class="min-w-0 flex-1 truncate font-mono text-sm text-content-muted">{@firmware_version_other.versions} other versions</span>
                <span class="text-right font-mono text-sm text-content-strong">{@firmware_version_other.count}</span>
                <span class="w-12 text-right font-mono text-sm text-content-muted">{percentage(@firmware_version_other.count, @firmware_version_total)}%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if={@fleet_size == 0} class="flex h-0 flex-1 items-center justify-center overflow-y-auto pb-16">
    <div class="w-full max-w-2xl px-6">
      <h2 class="mb-4 text-xl font-semibold text-base-50">{@product.name} doesn't have any devices yet.</h2>
      <p class="mb-6 text-sm text-base-400">Get started by adding <code class="text-base-300">nerves_hub_link</code> to your Nerves project.</p>
      <% active_secret = Enum.find(@product.shared_secret_auths, &is_nil(&1.deactivated_at)) %>
      <%!-- The secret lets a device connect and register itself, so only members who could manage it are shown it. --%>
      <%= if active_secret && authorized?(:"product:update", @current_scope) do %>
        <div class="rounded-lg border border-base-700 bg-surface-raised p-4">
          <h3 class="mb-3 text-sm font-semibold text-base-300">1. Add the dependency to your <code>mix.exs</code></h3>
          <pre class="mb-4 overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-green-400"><code>&#123;:nerves_hub_link, "~&gt; 2.0"&#125;</code></pre>

          <h3 class="mb-3 text-sm font-semibold text-base-300">2. Add this to your <code>config/config.exs</code></h3>
          <pre class="overflow-x-auto rounded bg-base-950 p-3 font-mono text-sm text-green-400"><code>config :nerves_hub_link,
host: "{onboarding_nhl_host()}",
remote_iex: true,
shared_secret: [
product_key: "{active_secret.key}",
product_secret: "{active_secret.secret}"
]</code></pre>

          <p class="mt-4 text-xs text-base-500">
            See the <a class="text-base-400 underline hover:text-base-300" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a> for more details.
          </p>
        </div>
      <% else %>
        <p class="text-sm text-base-400">
          Check the <a class="text-base-300 underline hover:text-base-200" href="https://hexdocs.pm/nerves_hub_link" target="_blank">nerves_hub_link documentation</a>
          for how to connect your first device.
        </p>
      <% end %>

      <div class="mt-6 rounded-lg border border-base-800 bg-surface-muted p-4">
        <h3 class="mb-2 text-sm font-semibold text-base-300">Production authentication</h3>
        <p class="text-xs text-base-400">
          For production applications, we recommend mTLS authentication using a local certificate or dedicated secure hardware.
        </p>
        <div class="mt-2 flex gap-4">
          <a class="text-xs text-base-400 underline hover:text-base-300" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.LocalCert.html" target="_blank">
            LocalCert configurator
          </a>
          <a class="text-xs text-base-400 underline hover:text-base-300" href="https://hexdocs.pm/nerves_hub_link/NervesHubLink.Configurator.NervesKey.html" target="_blank">
            NervesKey configurator
          </a>
        </div>
      </div>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
