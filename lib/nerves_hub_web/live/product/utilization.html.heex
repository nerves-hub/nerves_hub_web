<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.title product={@product} />
  </:top_bar>

  <div class="flex h-0 flex-1 flex-col overflow-y-auto">
    <.tabs current_scope={@current_scope} tab={:utilization} profile_count={@profile_count} api_key_count={@api_key_count} utilization={@report.score} />

    <div class="@container flex flex-col gap-4 p-6 max-sm:gap-3 max-sm:p-3">
      <section id="utilization-score" class={card_class()}>
        <div class="flex items-center gap-6 p-4 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <p class="flex shrink-0 items-baseline gap-1.5">
            <span class="text-figure-xl text-content-strong">{@report.score.done}</span>
            <span class="text-sm/5 text-content-muted">of {@report.score.total}</span>
          </p>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div class="flex flex-col gap-0.5">
              <h2 class="text-sm/5 font-semibold text-content-strong">{headline(@report.score)}</h2>
              <p class="text-ui/4.5 text-content-muted">
                What {@product.name} uses of {NervesHub.Branding.friendly_platform_name()}, judged from what the server can see of its devices, firmware and settings. The same report is printed by <code class="font-mono text-xs text-content-body">nh checklist {@product.name}</code>.
              </p>
            </div>
            <div
              class="h-1.5 overflow-hidden rounded-full bg-base-800"
              role="progressbar"
              aria-label="Recommended features in use"
              aria-valuemin="0"
              aria-valuemax={@report.score.total}
              aria-valuenow={@report.score.done}
            >
              <div class="h-full rounded-full bg-success" style={"width: #{percent(@report.score)}%"}></div>
            </div>
          </div>
        </div>
      </section>

      <section id="utilization-authentication" class={card_class()}>
        <div class="flex flex-col gap-0.5 px-4 py-3.5">
          <h2 class="text-sm/5 font-semibold text-content-strong">Device authentication</h2>
          <p class="text-ui/4.5 text-content-muted">How this product's devices prove who they are when they connect.</p>
        </div>
        <div id="utilization-auth-methods" class="grid grid-cols-3 border-t border-line-default max-sm:grid-cols-1">
          <div
            :for={method <- @report.device_auth}
            id={"auth-method-#{method.key}"}
            data-level={method.level}
            class="flex flex-col gap-1 border-line-default px-4 py-3 not-last:border-r max-sm:not-last:border-r-0 max-sm:not-last:border-b"
          >
            <span class="flex items-center gap-1.5 text-label text-content-muted uppercase">
              <.status_dot class={[
                "size-1.5",
                cond do
                  method.devices == 0 -> "bg-content-faint"
                  method.level == :warning -> "bg-warning"
                  true -> "bg-success"
                end
              ]} />
              {method.label}
            </span>
            <span class={[
              "text-figure-sm",
              cond do
                method.devices == 0 -> "text-content-faint"
                method.level == :warning -> "text-warning-content"
                true -> "text-success-content"
              end
            ]}>
              {number_to_delimited(method.devices, precision: 0)}
              <span class="text-ui font-normal text-content-muted">{if method.devices == 1, do: "device", else: "devices"}</span>
            </span>
          </div>
        </div>
        <.items items={@authentication} current_scope={@current_scope} />
        <p class="border-t border-line-default px-4 py-2.5 text-xs/4.5 text-content-muted">
          A certificate doesn't say where its key is kept. One with the shape the NervesKey tooling signs is counted as NervesKey, and any other as LocalCert, which includes keys held in a TPM.
        </p>
      </section>

      <section id="utilization-recommended" class={card_class()}>
        <div class="flex items-start justify-between gap-6 px-4 py-3.5">
          <div class="flex min-w-0 flex-col gap-0.5">
            <h2 class="text-sm/5 font-semibold text-content-strong">Recommended</h2>
            <p class="text-ui/4.5 text-content-muted">Features every product is better off using.</p>
          </div>
          <span class="shrink-0 font-mono text-xs text-content-muted">{done_count(@recommended)}/{available_count(@recommended)}</span>
        </div>
        <.items items={@recommended} current_scope={@current_scope} />
      </section>

      <section id="utilization-optional" class={card_class()}>
        <div class="flex items-start justify-between gap-6 px-4 py-3.5">
          <div class="flex min-w-0 flex-col gap-0.5">
            <h2 class="text-sm/5 font-semibold text-content-strong">Optional bonuses</h2>
            <p class="text-ui/4.5 text-content-muted">Worth having where they fit. They don't count towards the score.</p>
          </div>
          <span class="shrink-0 font-mono text-xs text-content-muted">{done_count(@optional)} in use</span>
        </div>
        <.items items={@optional} current_scope={@current_scope} />
      </section>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
