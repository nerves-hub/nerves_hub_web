<NervesHubWeb.Layouts.sidebar flash={@flash} current_scope={@current_scope} sidebar_tab={@sidebar_tab}>
  <:top_bar>
    <.title product={@product} />
  </:top_bar>

  <div class="flex h-0 flex-1 flex-col overflow-y-auto">
    <.tabs current_scope={@current_scope} tab={:api_keys} profile_count={@profile_count} />

    <div class="@container flex flex-col gap-4 p-6 max-sm:gap-3 max-sm:p-3">
      <p
        :if={!authorized?(:"product:update", @current_scope)}
        id="read-only-notice"
        class="flex items-center gap-2 rounded-card border border-line-default bg-surface-muted px-4 py-3 text-ui/4.5 text-content-body"
      >
        <span class="lucide-eye size-4 text-content-muted" aria-hidden="true"></span>
        <span>You can see this product's API keys, but your role in {@current_scope.org.name} can't create or deactivate them.</span>
      </p>

      <section
        :if={@new_key}
        id="new-api-key"
        class="flex w-full flex-col overflow-clip rounded-card border border-primary bg-surface-raised shadow-card"
      >
        <div class="flex items-start justify-between gap-6 px-4 py-3.5 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <div class="flex min-w-0 flex-col gap-0.5">
            <h2 class="text-sm/5 font-semibold text-content-strong">Copy the key for {@new_key.name}</h2>
            <p class="text-ui/4.5 text-content-muted">It is shown once. Nothing here can show it again.</p>
          </div>
          <div class="flex shrink-0 max-sm:*:w-full">
            <.button phx-click="dismiss-new-key">Done</.button>
          </div>
        </div>

        <div class="flex items-center gap-2 border-t border-line-default px-4 py-3.5">
          <code id="new-api-key-token" class="min-w-0 font-mono text-ui break-all text-content-strong">{@new_key.token}</code>
          <button
            id="copy-new-api-key"
            type="button"
            phx-hook="CopyToClipboard"
            data-copy-value={@new_key.token}
            aria-label={"Copy the key for #{@new_key.name}"}
            title="Copy key"
            class="flex size-6 shrink-0 cursor-pointer items-center justify-center rounded text-content-faint hover:bg-surface-muted hover:text-content-strong max-sm:size-9"
          >
            <span data-icon="copy" class="lucide-copy size-3.5" aria-hidden="true"></span>
            <span data-icon="check" class="lucide-check hidden size-3.5 text-success-content" aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section id="api-keys" class="flex w-full flex-col overflow-clip rounded-card border border-line-default bg-surface-raised shadow-card">
        <div class="flex items-start justify-between gap-6 px-4 py-3.5 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
          <div class="flex min-w-0 flex-col gap-0.5">
            <h2 class="text-sm/5 font-semibold text-content-strong">API keys</h2>
            <p class="text-ui/4.5 text-content-muted">
              For automation that uses the API for this product without a person's account behind it. A key works on this product only, and keeps working when whoever made it leaves.
            </p>
          </div>
        </div>

        <%= if @api_keys == [] do %>
          <p class="border-t border-line-default px-4 py-3.5 text-ui/4.5 text-content-muted">
            There are no API keys yet.
          </p>
        <% else %>
          <div class="border-t border-line-default">
            <div class="grid grid-cols-[minmax(0,1fr)_8rem_8rem_6rem] items-center gap-4 border-b border-line-default px-4 py-2.5 text-label text-content-muted uppercase max-sm:hidden">
              <span>Name</span>
              <span>Role</span>
              <span>Last used</span>
              <span></span>
            </div>
            <div
              :for={api_key <- @api_keys}
              id={"api-key-row-#{api_key.id}"}
              class="grid grid-cols-[minmax(0,1fr)_8rem_8rem_6rem] items-center gap-4 border-b border-line-default px-4 py-3 last:border-b-0 max-sm:grid-cols-[minmax(0,1fr)_auto]"
            >
              <div class="flex min-w-0 flex-col items-start gap-1">
                <span class={[
                  "min-w-0 text-ui break-all",
                  if(api_key.deactivated_at, do: "text-content-faint line-through", else: "text-content-strong")
                ]}>
                  {api_key.name}
                </span>
                <span class="text-xs/4 text-content-muted">
                  Created <.local_datetime at={api_key.inserted_at} time_zone={@time_zone} format={:medium_date} zone_label={false} />
                  <span :if={api_key.created_by}>by {api_key.created_by.name}</span>
                </span>
                <span :if={api_key.deactivated_at} class="rounded bg-surface-muted px-1.5 py-0.5 text-xs/4 text-content-muted">
                  Deactivated <.local_datetime at={api_key.deactivated_at} time_zone={@time_zone} format={:short_date} zone_label={false} />
                </span>
                <span class="text-xs/4 text-content-muted sm:hidden">{role_name(api_key)}</span>
              </div>

              <span class={["text-ui max-sm:hidden", if(api_key.deactivated_at, do: "text-content-faint", else: "text-content-body")]}>
                {role_name(api_key)}
              </span>

              <span class={["text-ui max-sm:hidden", if(api_key.deactivated_at, do: "text-content-faint", else: "text-content-body")]}>
                <%= if api_key.last_used_at do %>
                  <.local_datetime at={api_key.last_used_at} time_zone={@time_zone} format={:medium_date} zone_label={false} />
                <% else %>
                  Never
                <% end %>
              </span>

              <div class="flex justify-end">
                <button
                  :if={is_nil(api_key.deactivated_at) && authorized?(:"product:update", @current_scope)}
                  type="button"
                  phx-click="deactivate"
                  phx-value-id={api_key.id}
                  data-confirm={"Deactivate #{api_key.name}? Anything using this key stops working straight away."}
                  aria-label={"Deactivate #{api_key.name}"}
                  class="cursor-pointer text-ui text-content-body hover:text-alert-content max-sm:h-9"
                >
                  Deactivate
                </button>
              </div>
            </div>
          </div>
        <% end %>

        <.form
          :if={authorized?(:"product:update", @current_scope)}
          for={@form}
          id="api-key-form"
          phx-submit="create"
          class="flex items-end gap-3 border-t border-line-default px-4 py-3.5 max-sm:flex-col max-sm:items-stretch"
        >
          <div class="min-w-0 flex-1">
            <.input field={@form[:name]} label="Name" placeholder="CI deploys" />
          </div>
          <div class="w-48 max-sm:w-full">
            <.input field={@form[:role]} type="select" label="Role" options={role_options(@custom_roles)} />
          </div>
          <.button type="submit" id="create-api-key" class="max-sm:w-full">
            <span class="lucide-plus size-3.5" aria-hidden="true"></span> Create key
          </.button>
        </.form>
      </section>
    </div>
  </div>
</NervesHubWeb.Layouts.sidebar>
