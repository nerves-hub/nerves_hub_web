<mjml>
  <mj-body background-color="#fafafa">
    <%= render_dynamic_component NervesHub.Emails.LogoHeader, %{} %>

    <mj-section padding-top="0px">
      <mj-column>
        <mj-text font-size="20px" font-family="sans-serif" padding-top="20px">Hi <%= @user_name %></mj-text>

        <mj-text font-size="20px" font-family="sans-serif" padding-top="20px">
          Two-factor authentication is now on for your <%= @platform_name %> account. Signing in will ask for a code from your authenticator app after your password.
        </mj-text>

        <mj-text font-size="20px" font-family="sans-serif" padding-top="20px">
          Keep your recovery codes somewhere safe. Each one signs you in once if you lose your phone.
        </mj-text>

        <mj-text font-size="20px" font-family="sans-serif" padding-top="20px">
          If this wasn't you, someone else has your password, and you'll need a recovery code to sign in.
        </mj-text>

        <mj-button align="left" padding-top="20px" inner-padding="8px 10px 5px 10px" href="<%= @manage_url %>" font-size="18px" background-color="#6366f1" border-radius="4px" color="#fafafa" font-family="sans-serif">
          Manage two-factor authentication
        </mj-button>
      </mj-column>
    </mj-section>

    <%= render_dynamic_component NervesHub.Emails.ClosingBlock, %{} %>
  </mj-body>
</mjml>
