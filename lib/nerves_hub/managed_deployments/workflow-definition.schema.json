{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://nerveshub.org/deployment-group-workflow.schema.json",
  "title": "Deployment Workflow Definition",
  "description": "A complete Deployment workflow definition.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "The version of the schema",
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "steps": {
      "description": "Workflow steps, run in the order they are listed",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "description": "A Workflow step",
        "additionalProperties": false,
        "properties": {
          "type": {
            "description": "Defaults to update_devices when omitted",
            "type": "string",
            "enum": ["update_devices", "approval_required", "catch_all"]
          },
          "name": { "type": "string", "maxLength": 50 },
          "description": { "type": "string", "maxLength": 100 },
          "matching_conditions": {
            "description": "Which devices this step covers. Omitting a condition means it does not narrow the devices.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tags": {
                "description": "A device must carry every tag listed",
                "type": "array",
                "items": { "type": "string" }
              },
              "network_interfaces": {
                "description": "The interface a device most recently connected over",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["wifi", "ethernet", "cellular", "unknown"]
                }
              },
              "match_limit": {
                "description": "How many devices this step covers at most",
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          },
          "concurrent_updates": {
            "description": "How many of this step's devices update at once",
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "failure_tolerance": {
            "description": "How many of this step's devices may fail before the step itself is failed. Give either a count or a percentage, not both. Defaults to one device; a catch_all step never fails.",
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              { "required": ["devices"] },
              { "required": ["percent"] }
            ],
            "properties": {
              "devices": { "type": "integer", "exclusiveMinimum": 0 },
              "percent": { "type": "integer", "exclusiveMinimum": 0, "maximum": 100 }
            }
          }
        },
        "required": ["name"]
      }
    }
  },
  "required": ["version", "steps"]
}
